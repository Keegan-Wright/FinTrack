# FinTrack's settings. Copy this file to .env next to docker-compose.yaml and fill it in.
# Every setting is explained in Docs/self-hosting/configuration.md. Optional ones can be left empty.

# --- General ---

# The release to run, a tag from https://hub.docker.com/r/keeganwright12/fintrackweb/tags, e.g. v0.1.1
FINTRACK_VERSION=

# The database password. Any long random password
FINTRACK_POSTGRES_PASSWORD=

# How dates and money are shown, e.g. en-GB. Optional
APP_CULTURE=

# The time zone, e.g. Europe/London. Optional
TZ=

# Your FinTrack address, e.g. https://fintrack.example.com, for links in emails and webhooks. Optional.
# Passkeys belong to its domain, so changing it later stops them working
FINTRACK_PUBLIC_URL=

# --- Encryption, see Docs/self-hosting/encryption-keys.md ---
# Back these up somewhere away from the server. Without them your data can't be read

# Your keys as id:key pairs separated by ;, e.g. 1:<key>. Make a key with: openssl rand -base64 32
FINTRACK_ENCRYPTION_KEYS=

# The id of the key new values are encrypted with, e.g. 1
FINTRACK_ENCRYPTION_CURRENT_KEY_ID=

# --- Bank connection, see Docs/self-hosting/open-banking.md ---

# TrueLayer's sign in address. Sandbox https://auth.truelayer-sandbox.com/, live https://auth.truelayer.com/
OPENBANKING_AUTH_URL=

# TrueLayer's data API address. Sandbox https://api.truelayer-sandbox.com/data/, live https://api.truelayer.com/data/
OPENBANKING_DATA_URL=

# Where TrueLayer sends you after connecting a bank, e.g. https://console.truelayer.com/redirect-page. It must be one of
# your TrueLayer app's allowed redirect URIs
OPENBANKING_AUTH_REDIRECT_URL=

# Your TrueLayer app's client id and secret
OPENBANKING_CLIENT_ID=
OPENBANKING_CLIENT_SECRET=

# Your public IP address
OPENBANKING_PUBLIC_IP_ADDRESS=

# --- Signing in, see Docs/self-hosting/single-sign-on.md ---

# Single sign-on, optional. On when all three are set
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# false turns off username and password sign in, leaving only single sign-on, which then has to be set up.
# On when empty
PASSWORD_SIGN_IN=

# --- Email, optional, see Docs/self-hosting/email.md ---

# The mail server. Email is off when empty
SMTP_HOST=

# The mail server's port. 587 when empty
SMTP_PORT=

# How the connection is secured: Auto, StartTls, SslOnConnect or None. Auto when empty
SMTP_SECURITY=

# The mail server login, if it needs one
SMTP_USERNAME=
SMTP_PASSWORD=

# The address emails come from, e.g. fintrack@example.com. Needed with SMTP_HOST
SMTP_FROM=

# --- Network and limits, see Docs/self-hosting/reverse-proxy.md ---

# Your reverse proxy's Docker network. proxy-net when empty
FINTRACK_PROXY_NETWORK=

# Your proxy's addresses or networks, comma separated, e.g. 172.18.0.0/16. Leave empty when not behind a proxy
TRUSTED_PROXIES=

# true lets webhooks reach your local network, e.g. Home Assistant. false when empty
WEBHOOK_ALLOW_PRIVATE=

# Sign in, register and password reset attempts per minute from one address. 10 when empty
RATE_LIMIT_SIGN_INS_PER_MINUTE=

# Sharing invites per hour from one user. 20 when empty
RATE_LIMIT_INVITES_PER_HOUR=

# Refused API tokens per hour from one address before its tokens aren't looked at. 30 when empty
RATE_LIMIT_TOKEN_FAILURES_PER_HOUR=

# --- Monitoring, optional, see Docs/self-hosting/monitoring.md ---

# Where to send logs, traces and metrics, e.g. http://otel-lgtm:4317. Nothing is sent when empty
OTEL_EXPORTER_OTLP_ENDPOINT=

# Where to send profiles, e.g. http://otel-lgtm:4040. Only used once profiling is uncommented in the compose file
PYROSCOPE_SERVER_ADDRESS=

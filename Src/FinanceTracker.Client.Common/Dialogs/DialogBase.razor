@* The shared dialog frame. It has a title, content, and submit and cancel, and returns a TResponse. *@
@typeparam TResponse

<MudDialog>
    <TitleContent>@Title</TitleContent>
    <DialogContent>
        @Content
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@CancelButtonText</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">@SubmitButtonText</MudButton>
    </DialogActions>
</MudDialog>

@code {

    /// <summary>
    /// The dialog it's shown in.
    /// </summary>
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// The dialog's title.
    /// </summary>
    [Parameter] [EditorRequired] public required string Title { get; set; }

    /// <summary>
    /// The dialog's content.
    /// </summary>
    [Parameter] [EditorRequired] public required RenderFragment Content { get; set; }

    /// <summary>
    /// Gives what the dialog closes with when OK is pressed, null to keep it open.
    /// </summary>
    [Parameter] [EditorRequired] public required Func<Task<TResponse?>> ResponseConstructor { get; set; }

    /// <summary>
    /// What the submit button says.
    /// </summary>
    private const string SubmitButtonText = "OK";
    /// <summary>
    /// What the cancel button says.
    /// </summary>
    private const string CancelButtonText = "Cancel";

    /// <summary>
    /// Closes with the response, unless there's none.
    /// </summary>
    private async Task Submit()
    {
        var response = await ResponseConstructor.Invoke();
        if (response != null)
        {
            MudDialog.Close(DialogResult.Ok(response));
        }
    }

    /// <summary>
    /// Closes without a response.
    /// </summary>
    private void Cancel()
    {
        MudDialog.Cancel();
    }


}

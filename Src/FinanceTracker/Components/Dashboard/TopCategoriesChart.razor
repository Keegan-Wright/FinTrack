@using FinanceTracker.Contracts.Transactions

<MudCard>
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
            <MudText Typo="Typo.subtitle1">Top spending categories</MudText>
            <MudText Typo="Typo.caption">Outflow only</MudText>
        </MudStack>

        @if (_series.Count == 0 || _labels.Length == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No category spend to show.</MudText>
        }
        else
        {
                <MudChart ChartType="ChartType.Bar"
                          ChartSeries="_series"
                          ChartLabels="_labels"
                          ChartOptions="_chartOptions"
                          Width="100%"/>
        }
    </MudCardContent>
</MudCard>

@code {

    private const int CategoriesToShow = 8;

    [Parameter, EditorRequired] public IReadOnlyList<Transaction> Transactions { get; set; } = [];

    private readonly ChartOptions _chartOptions = new();
    private readonly List<ChartSeries<double>> _series = [];
    private string[] _labels = [];
    private IReadOnlyList<Transaction>? _builtFrom;

    protected override void OnParametersSet()
    {
        // The parent re-renders while loading, only rebuild when it hands over a new set of transactions
        if (ReferenceEquals(_builtFrom, Transactions))
            return;

        _builtFrom = Transactions;
        _series.Clear();
        _labels = [];
        Build();
    }

    private void Build()
    {
        List<(string Tag, decimal Total)> addedItems = new();

        var distinctTags = Transactions.SelectMany(static x => x.Tags).Distinct();
        foreach (var distinctTag in distinctTags)
        {
            var transactionsToAdd = Transactions.Where(x => x.Tags.Contains(distinctTag));
            addedItems.Add((distinctTag, transactionsToAdd.Where(static x => x.Amount < 0).Sum(static x => Math.Abs(x.Amount))));
        }

        if (addedItems.Count == 0)
            return;

        var reducedItems = addedItems.OrderByDescending(static x => x.Total).Take(CategoriesToShow).ToList();

        _labels = reducedItems.Select(static x => x.Tag).ToArray();
        _series.Add(new ChartSeries<double>
        {
            Name = "Spend",
            Data = reducedItems.Select(static x => Convert.ToDouble(x.Total)).ToArray()
        });
    }

}

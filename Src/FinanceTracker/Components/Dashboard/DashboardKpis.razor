@using FinanceTracker.Contracts.Dashboard

<MudGrid Spacing="3">
    <MudItem xs="12" md="6" lg="3">
        <KpiCard TTrendType="decimal?" Icon="@Icons.Material.Filled.SouthWest" Label="Money In"
                 Value="@Spent?.TotalIn" Trend="@TrendIn"
                 Color="Color.Success"/>
    </MudItem>
    <MudItem xs="12" md="6" lg="3">
        <KpiCard TTrendType="decimal?" Icon="@Icons.Material.Filled.NorthEast" Label="Money Out"
                 Value="@Spent?.TotalOut" Trend="@TrendOut" Color="Color.Error"/>
    </MudItem>
    <MudItem xs="12" md="6" lg="3">
        <KpiCard TTrendType="string" Icon="@Icons.Material.Filled.ShowChart" Label="Net" Value="@Net"
                 Trend="@($"{TransactionCount:n0} transactions in range")" Color="Color.Tertiary"/>
    </MudItem>
    <MudItem xs="12" md="6" lg="3">
        <KpiCard TTrendType="string" Icon="@Icons.Material.Filled.SouthWest" Label="Total Balance"
                 Value="@TotalBalance" Trend="@GetBalanceMeta()" Color="Color.Secondary"/>
    </MudItem>
</MudGrid>

@code {

    /// <summary>
    /// Money in and out for the selected range.
    /// </summary>
    [Parameter] public SpentInTimePeriod? Spent { get; set; }

    /// <summary>
    /// Change in money in against the previous period, null when there's nothing to compare.
    /// </summary>
    [Parameter] public decimal? TrendIn { get; set; }

    /// <summary>
    /// Change in money out against the previous period, null when there's nothing to compare.
    /// </summary>
    [Parameter] public decimal? TrendOut { get; set; }

    [Parameter] public decimal Net { get; set; }

    [Parameter] public int TransactionCount { get; set; }

    [Parameter] public decimal TotalBalance { get; set; }

    [Parameter] public decimal? HouseholdIncome { get; set; }

    private string? GetBalanceMeta()
    {
        if (HouseholdIncome is null or 0)
            return null;

        var netAfterOut = HouseholdIncome.Value - Math.Abs(Spent?.TotalOut ?? 0);
        return $"Household income: {CurrencyFormatter.Format(HouseholdIncome.Value)} · After out: {CurrencyFormatter.Format(netAfterOut)}";
    }

}

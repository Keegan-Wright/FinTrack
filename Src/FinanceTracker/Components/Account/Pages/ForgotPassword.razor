@page "/Account/ForgotPassword"
@using System.ComponentModel.DataAnnotations
@using FinanceTracker.Domain.Identity
@using FinanceTracker.Infrastructure.Notifications.Email
@using Microsoft.AspNetCore.Identity

@inject UserManager<FinanceTrackerUser> UserManager
@inject IEmailSender<FinanceTrackerUser> EmailSender
@inject IMailSender MailSender
@inject IPasswordReset PasswordReset
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ForgotPassword> Logger

<PageTitle>FinTrack - Forgot your password?</PageTitle>

@if (!MailSender.IsAvailable)
{
    @* Reached by its address alone, as sign in doesn't link here without a mail server *@
    <AuthHeading Title="Forgot your password?" Subtitle="This FinTrack can't send emails"/>
    <MudText Typo="Typo.body2">
        Email isn't set up here, so a reset link can't be sent. Ask the admin to reset your password.
    </MudText>
}
else
{
    <AuthHeading Title="Forgot your password?" Subtitle="Enter your email and we'll send you a link to reset it"/>

    <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator/>
        <AuthFields>
            <MudStaticTextField @bind-Value="Input.Email" For="@(() => Input.Email)"
                                Label="Email" Placeholder="name@example.com" InputType="InputType.Email"
                                Variant="Variant.Outlined"
                                UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "email" }, { "aria-required", "true" } })"/>

            <MudStaticButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                             FormAction="FormAction.Submit">Send reset link</MudStaticButton>
        </AuthFields>
    </EditForm>
}

<AuthFooter>
    Remembered it? <MudLink Href="Account/Login">Back to sign in</MudLink>
</AuthFooter>

@code {
    [SupplyParameterFromForm] private InputModel Input { get; set; } = default!;

    // Form posts bind the property before initialisation, so only create a model when nothing was posted
    protected override void OnInitialized() => Input ??= new();

    /// <summary>
    /// Sends a reset link to a confirmed email whose account has a password. The page after says the same whether or
    /// not one was sent, so it can't be used to find out who has an account.
    /// </summary>
    private async Task OnValidSubmitAsync()
    {
        FinanceTrackerUser? user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is not null && await CanResetAsync(user))
        {
            await SendResetLinkAsync(user);
        }

        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    /// <summary>
    /// Only an account with a password here. One made by signing in through the identity provider has none, its
    /// password is the provider's, and a reset would give it a second way in that gets around the provider.
    /// </summary>
    private async Task<bool> CanResetAsync(FinanceTrackerUser user) =>
        await UserManager.IsEmailConfirmedAsync(user) && await UserManager.HasPasswordAsync(user);

    private async Task SendResetLinkAsync(FinanceTrackerUser user)
    {
        Uri link = await PasswordReset.CreateLinkAsync(user);

        try
        {
            await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, link.AbsoluteUri);
        }
        catch (Exception exception)
        {
            // Said the same as when it's sent, so a failure doesn't give away that the account exists
            Logger.LogPasswordResetEmailFailed(exception, user.Id);
        }
    }

    private sealed class InputModel
    {
        [Required] [EmailAddress] public string Email { get; set; } = "";
    }

}

@page "/Account/Register"
@using System.Security.Claims
@using Blazilla
@using FinanceTracker.Contracts.Auth
@using FinanceTracker.Domain.Identity
@using FluentValidation
@using Microsoft.AspNetCore.Identity

@inject UserManager<FinanceTrackerUser> UserManager
@inject IUserStore<FinanceTrackerUser> UserStore
@inject SignInManager<FinanceTrackerUser> SignInManager
@inject ILogger<Register> Logger
@inject IdentityRedirectManager RedirectManager
@inject NavigationManager NavigationManager
@inject IValidator<RegisterRequest> Validator
@inject AdminProvisioner AdminProvisioner

<PageTitle>FinTrack - Create an account</PageTitle>

<AuthHeading Title="Create an account" Subtitle="A few details and you're in"/>

@if (identityErrors != null)
{
    <MudAlert Severity="MudBlazor.Severity.Error" Variant="Variant.Text" Dense="true" Class="mb-4">
        @foreach (var error in identityErrors)
        {
            <div>@error.Description</div>
        }
    </MudAlert>
}

<EditForm Model="@RegisterRequest" asp-route-returnUrl="@ReturnUrl" method="post" OnValidSubmit="@RegisterUser"
          FormName="register">
    <FluentValidator/>
    <AuthFields>
        <div class="ft-register-names">
            <MudStaticTextField For="@(() => RegisterRequest.FirstName)" @bind-Value="RegisterRequest.FirstName"
                                Label="First name" Variant="Variant.Outlined"
                                UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "given-name" }, { "aria-required", "true" } })"/>
            <MudStaticTextField For="@(() => RegisterRequest.LastName)" @bind-Value="RegisterRequest.LastName"
                                Label="Last name" Variant="Variant.Outlined"
                                UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "family-name" }, { "aria-required", "true" } })"/>
        </div>
        <MudStaticTextField For="@(() => RegisterRequest.Username)" @bind-Value="RegisterRequest.Username"
                            Label="Username" Variant="Variant.Outlined"
                            UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "username" }, { "aria-required", "true" } })"/>
        <MudStaticTextField For="@(() => RegisterRequest.Email)" @bind-Value="RegisterRequest.Email"
                            Label="Email" Placeholder="name@example.com" InputType="InputType.Email"
                            Variant="Variant.Outlined"
                            UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "email" }, { "aria-required", "true" } })"/>
        <MudStaticTextField For="@(() => RegisterRequest.Password)" @bind-Value="RegisterRequest.Password"
                            Label="Password" InputType="InputType.Password" Variant="Variant.Outlined"
                            Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Visibility"
                            AdornmentToggledIcon="@Icons.Material.Outlined.VisibilityOff"
                            AdornmentClickFunction="ftTogglePassword" AdornmentAriaLabel="Show password"
                            UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "new-password" }, { "aria-required", "true" } })"/>
        <MudStaticTextField For="@(() => RegisterRequest.ConfirmPassword)"
                            @bind-Value="RegisterRequest.ConfirmPassword"
                            Label="Confirm password" InputType="InputType.Password" Variant="Variant.Outlined"
                            UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "new-password" }, { "aria-required", "true" } })"/>
        <MudStaticButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                         FormAction="FormAction.Submit">Create account</MudStaticButton>
    </AuthFields>
</EditForm>

<AuthFooter>
    Already have an account?
    <MudLink Href="@(NavigationManager.GetUriWithQueryParameters("Account/Login", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">
        Sign in
    </MudLink>
</AuthFooter>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm] private RegisterRequest RegisterRequest { get; set; } = default!;

    // Form posts bind the property before initialisation, so only create a model when nothing was posted
    protected override void OnInitialized() => RegisterRequest ??= new();

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private async Task RegisterUser(EditContext editContext)
    {
        var validationResult = await Validator.ValidateAsync(RegisterRequest);
        if (!validationResult.IsValid)
            return;

        var user = new FinanceTrackerUser(RegisterRequest.FirstName!, RegisterRequest.LastName!,
            RegisterRequest.Email!, RegisterRequest.Username!);

        await UserStore.SetUserNameAsync(user, RegisterRequest.Username, CancellationToken.None);

        var result = await UserManager.CreateAsync(user, RegisterRequest.Password!);


        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            return;
        }

        Logger.LogUserRegistered();
        await UserManager.AddClaimAsync(user, new Claim(CustomClaims.FirstName, RegisterRequest.FirstName));
        await AdminProvisioner.GrantIfFirstUserAsync(user);
        await SignInManager.SignInAsync(user, false);
        RedirectManager.RedirectTo(ReturnUrl);
    }

}

@page "/Account/Login"
@using Blazilla
@using FinanceTracker.Contracts.Auth
@using FinanceTracker.Domain.Identity
@using FinanceTracker.Extensions
@using FinanceTracker.Infrastructure.Notifications.Email
@using FluentValidation
@using Microsoft.AspNetCore.Identity

@inject SignInManager<FinanceTrackerUser> SignInManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject SignInMethods SignInMethods
@inject IMailSender MailSender

<PageTitle>FinTrack - Sign in</PageTitle>

<AuthHeading Title="Sign in" Subtitle="Welcome back, pick up where you left off"/>

@if (_errorMessage is not null)
{
    <MudAlert Severity="MudBlazor.Severity.Error" Variant="Variant.Text" Dense="true"
              Class="mb-4">@_errorMessage</MudAlert>
}

@* A full page load rather than Blazor's enhanced navigation, which fetches the page and can't follow the redirect
   on to the provider, a site the content security policy doesn't let it connect to *@
@if (SignInMethods.SingleSignOn)
{
    <MudButton
        Href="@(NavigationManager.GetUriWithQueryParameters("auth/oidc", new Dictionary<string, object?> { ["returnUrl"] = ReturnUrl }))"
        Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
        StartIcon="@Icons.Material.Outlined.Key" data-enhance-nav="false">
        Sign in with single sign on
    </MudButton>
}

@if (SignInMethods is { SingleSignOn: true, Password: true })
{
    <AuthDivider Text="or with your username"/>
}

@if (SignInMethods.Password)
{
    <EditForm Model="LoginRequest" method="post" OnValidSubmit="LoginUser" FormName="login">
        <FluentValidator/>
        <AuthFields>
            <MudStaticTextField For="@(() => LoginRequest.Username)" @bind-Value="LoginRequest.Username"
                                Label="Username" Variant="Variant.Outlined"
                                UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "username" }, { "aria-required", "true" } })"/>

            <MudStaticTextField For="@(() => LoginRequest.Password)" @bind-Value="LoginRequest.Password"
                                Label="Password" InputType="InputType.Password" Variant="Variant.Outlined"
                                Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Visibility"
                                AdornmentToggledIcon="@Icons.Material.Outlined.VisibilityOff"
                                AdornmentClickFunction="ftTogglePassword" AdornmentAriaLabel="Show password"
                                UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "current-password" }, { "aria-required", "true" } })"/>

            <div class="ft-login-options">
                <MudStaticCheckBox For="@(() => LoginRequest.RememberMe)" @bind-Value="LoginRequest.RememberMe"
                                   Color="Color.Primary">Remember me
                </MudStaticCheckBox>
                @if (MailSender.IsAvailable)
                {
                    <MudLink Href="Account/ForgotPassword" Typo="Typo.body2">Forgot password?</MudLink>
                }
            </div>

            <MudStaticButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                             FormAction="FormAction.Submit">Sign in
            </MudStaticButton>
        </AuthFields>
    </EditForm>

    <AuthFooter>
        New to FinTrack?
        <MudLink
            Href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">
            Create an account
        </MudLink>
    </AuthFooter>
}

@code {
    private string? _errorMessage;

    /// <summary>
    /// The request, which the sign in happens on.
    /// </summary>
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    /// <summary>
    /// The posted form.
    /// </summary>
    [SupplyParameterFromForm] private LoginRequest LoginRequest { get; set; } = default!;

    /// <summary>
    /// Where to go once signed in.
    /// </summary>
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    /// <summary>
    /// <c>failed</c> when an OIDC sign in came back without signing anyone in, the server logs why.
    /// </summary>
    [SupplyParameterFromQuery(Name = "sso")]
    private string? Sso { get; set; }

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        // Form posts bind the property before initialisation, so only create a model when nothing was posted
        LoginRequest ??= new();

        if (Sso == "failed")
        {
            _errorMessage = "Single sign on failed.";
        }
    }

    /// <summary>
    /// Signs in with the posted username and password. Failures count towards locking the account.
    /// </summary>
    public async Task LoginUser()
    {
        // The form isn't shown with password sign in off, but could still be posted
        if (!SignInMethods.Password)
            return;

        // Failures count towards account lockout (lockoutOnFailure: true)
        var result = await SignInManager.PasswordSignInAsync(LoginRequest.Username, LoginRequest.Password, LoginRequest.RememberMe, true);
        if (result.Succeeded)
        {
            Logger.LogUserLoggedIn();
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.RequiresTwoFactor)
        {
            RedirectManager.RedirectTo("Account/LoginWith2fa",
                new Dictionary<string, object?> { ["returnUrl"] = ReturnUrl, ["rememberMe"] = LoginRequest.RememberMe });
        }
        else if (result.IsLockedOut)
        {
            Logger.LogUserLockedOut();
            FinanceTrackerUser? user = await SignInManager.UserManager.FindByNameAsync(LoginRequest.Username);
            RedirectManager.RedirectTo(Lockout.PathFor(user));
        }
        else
        {
            _errorMessage = "Invalid login attempt.";
        }
    }

}

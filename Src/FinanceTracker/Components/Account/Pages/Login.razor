@page "/Account/Login"
@using Blazilla
@using FinanceTracker.Contracts.Auth
@using FinanceTracker.Domain.Identity
@using FinanceTracker.Extensions
@using FluentValidation
@using Microsoft.AspNetCore.Identity

@inject SignInManager<FinanceTrackerUser> SignInManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IConfiguration Configuration

<PageTitle>Sign in</PageTitle>

<AuthHeading Title="Sign in" Subtitle="Welcome back, pick up where you left off"/>

@if (_errorMessage is not null)
{
    <MudAlert Severity="MudBlazor.Severity.Error" Variant="Variant.Text" Dense="true" Class="mb-4">@_errorMessage</MudAlert>
}

@if (Configuration.IsOidcEnabled())
{
    <MudButton Href="@(NavigationManager.GetUriWithQueryParameters("auth/oidc", new Dictionary<string, object?> { ["returnUrl"] = ReturnUrl }))"
               Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
               StartIcon="@Icons.Material.Outlined.Key">
        Sign in with single sign on
    </MudButton>
    <AuthDivider Text="or with your username"/>
}

<EditForm Model="LoginRequest" method="post" OnValidSubmit="LoginUser" FormName="login">
    <FluentValidator/>
    <AuthFields>
        <MudStaticTextField For="@(() => LoginRequest.Username)" @bind-Value="LoginRequest.Username"
                            Label="Username" Variant="Variant.Outlined"
                            UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "username" }, { "aria-required", "true" } })"/>

        <MudStaticTextField For="@(() => LoginRequest.Password)" @bind-Value="LoginRequest.Password"
                            Label="Password" InputType="InputType.Password" Variant="Variant.Outlined"
                            Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Visibility"
                            AdornmentToggledIcon="@Icons.Material.Outlined.VisibilityOff"
                            AdornmentClickFunction="ftTogglePassword" AdornmentAriaLabel="Show password"
                            UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "current-password" }, { "aria-required", "true" } })"/>

        <div class="ft-login-options">
            <MudStaticCheckBox For="@(() => LoginRequest.RememberMe)" @bind-Value="LoginRequest.RememberMe"
                               Color="Color.Primary">Remember me</MudStaticCheckBox>
            <MudLink Href="Account/ForgotPassword" Typo="Typo.body2">Forgot password?</MudLink>
        </div>

        <MudStaticButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                         FormAction="FormAction.Submit">Sign in</MudStaticButton>
    </AuthFields>
</EditForm>

<AuthFooter>
    New to FinTrack?
    <MudLink Href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">
        Create an account
    </MudLink>
</AuthFooter>

@code {
    private string? _errorMessage;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private LoginRequest LoginRequest { get; set; } = default!;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    /// <summary>
    /// <c>failed</c> when an OIDC sign in came back without signing anyone in, the server logs why.
    /// </summary>
    [SupplyParameterFromQuery(Name = "sso")] private string? Sso { get; set; }

    protected override void OnInitialized()
    {
        // Form posts bind the property before initialisation, so only create a model when nothing was posted
        LoginRequest ??= new();

        if (Sso == "failed")
        {
            _errorMessage = "Single sign on failed.";
        }
    }

    public async Task LoginUser()
    {
        // Failures count towards account lockout (lockoutOnFailure: true)
        var result = await SignInManager.PasswordSignInAsync(LoginRequest.Username, LoginRequest.Password, LoginRequest.RememberMe, true);
        if (result.Succeeded)
        {
            Logger.LogUserLoggedIn();
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            Logger.LogUserLockedOut();
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            _errorMessage = "Invalid login attempt.";
        }
    }

}

@page "/Account/ResetPassword"
@* Opened from the reset link ForgotPassword emails. The link names the account, so the password changes for that
   account or the page says the link doesn't work, never a quiet nothing. *@
@using System.ComponentModel.DataAnnotations
@using System.Text
@using FinanceTracker.Domain.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@inject IdentityRedirectManager RedirectManager
@inject UserManager<FinanceTrackerUser> UserManager

<PageTitle>FinTrack - Reset password</PageTitle>

<AuthHeading Title="Choose a new password" Subtitle="@($"For {_user?.UserName}")"/>

@if (_errors is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="mb-4">
        @foreach (string error in _errors)
        {
            <div>@error</div>
        }
    </MudAlert>
}

<EditForm Model="Input" FormName="reset-password" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator/>

    @* Which account it's for, so a password manager saves the new password against it *@
    <input type="text" name="username" value="@_user?.UserName" autocomplete="username" readonly hidden/>
    <AuthFields>
        <MudStaticTextField For="@(() => Input.Password)" @bind-Value="Input.Password"
                            Label="New password" InputType="InputType.Password" Variant="Variant.Outlined"
                            Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Visibility"
                            AdornmentToggledIcon="@Icons.Material.Outlined.VisibilityOff"
                            AdornmentClickFunction="ftTogglePassword" AdornmentAriaLabel="Show password"
                            UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "new-password" }, { "aria-required", "true" } })"/>
        <MudStaticTextField For="@(() => Input.ConfirmPassword)" @bind-Value="Input.ConfirmPassword"
                            Label="Confirm new password" InputType="InputType.Password" Variant="Variant.Outlined"
                            UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "new-password" }, { "aria-required", "true" } })"/>
        <MudStaticButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                         FormAction="FormAction.Submit">Reset password</MudStaticButton>
    </AuthFields>
</EditForm>

@code {

    /// <summary>
    /// The page the reset link opens, relative to the app.
    /// </summary>
    public const string PagePath = "Account/ResetPassword";

    [SupplyParameterFromForm] private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery] private string? UserId { get; set; }

    [SupplyParameterFromQuery] private string? Code { get; set; }

    private FinanceTrackerUser? _user;
    private string? _code;
    private List<string>? _errors;

    protected override async Task OnInitializedAsync()
    {
        // Form posts bind the property before initialisation, so only create a model when nothing was posted
        Input ??= new();

        _code = Decode(Code);
        if (UserId is not null)
        {
            _user = await UserManager.FindByIdAsync(UserId);
        }

        if (_code is null || _user is null)
        {
            RedirectManager.RedirectTo("Account/InvalidPasswordReset");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        IdentityResult result = await UserManager.ResetPasswordAsync(_user!, _code!, Input.Password);
        if (result.Succeeded)
        {
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
        }

        // Used already, expired, or the account changed since it was sent
        if (result.Errors.Any(static x => x.Code == nameof(IdentityErrorDescriber.InvalidToken)))
        {
            RedirectManager.RedirectTo("Account/InvalidPasswordReset");
        }

        _errors = result.Errors.Select(static x => x.Description).ToList();
    }

    // The reset token from the link, null when there isn't one or it was cut short or changed on the way
    private static string? Decode(string? code)
    {
        if (code is null)
        {
            return null;
        }

        try
        {
            return Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(code));
        }
        catch (FormatException)
        {
            return null;
        }
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }

}

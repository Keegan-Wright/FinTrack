@inherits LayoutComponentBase
@using FinanceTracker.Client.Layout
@* The signed out pages' shell (sign in, register, password reset ....) the app name over a centred
   panel. The pages are static server rendered, unable to access users preferred theme. Follows app default DARK. *@

<MudThemeProvider Theme="AppTheme.Theme" IsDarkMode="true" DefaultScrollbar="true"/>
<MudPopoverProvider/>

<main class="ft-auth">
    <a class="ft-auth__brand" href="">
        <MudIcon Icon="@Icons.Material.Rounded.AccountBalanceWallet" Color="Color.Primary"/>
        <span>FinTrack</span>
    </a>
    <div class="ft-auth__panel">
        @Body
    </div>
    <footer class="ft-auth__version" title="@AppVersion.Full">FinTrack @AppVersion.Display</footer>
</main>

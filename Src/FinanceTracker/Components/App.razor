<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Roboto:wght@300;400;500;700&display=swap"
        rel="stylesheet"/>
    <link href=@Assets["_content/MudBlazor/MudBlazor.min.css"] rel="stylesheet"/>
    <link href="css/App.css" rel="stylesheet"/>
    <link href=@Assets["FinanceTracker.styles.css"] rel="stylesheet"/>
    <ImportMap/>
    <link rel="icon" type="image/svg+xml" href="favicon.svg"/>
    <link rel="icon" href="favicon.ico" sizes="48x48"/>
    <link rel="apple-touch-icon" href="apple-touch-icon.png"/>
    <HeadOutlet @rendermode="PageRenderMode"/>
</head>

<body>
<Routes @rendermode="PageRenderMode"/>

@* The last resort when something breaks outside a page, which shows its own error in its place. Blazor shows it,
   and wires up its reload and dismiss buttons. Static, so it's here even when the app can't render anything *@
<div id="blazor-error-ui" class="ft-error-bar" role="alert" data-nosnippet>
    <div class="ft-error-bar__content">
        <span class="ft-error-bar__message">Something went wrong. Reload the page to carry on.</span>
        <button type="button" class="reload ft-error-bar__reload">Reload</button>
        <button type="button" class="dismiss ft-error-bar__dismiss" aria-label="Dismiss">&#x2715;</button>
    </div>
</div>

<script src="_framework/blazor.web.js" autostart="false"></script>
<script>
    const runtime = @((MarkupString)BrowserRuntime.SettingsJson());
    Blazor.start({
        webAssembly: {
            applicationCulture: runtime.culture || undefined,
            configureRuntime: builder => builder.withEnvironmentVariable("TZ", runtime.timeZone)
        }
    });
</script>
<script src=@Assets["_content/MudBlazor/MudBlazor.min.js"]></script>
<script src=@Assets["js/app.js"]></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveWebAssembly : null;

}

@page "/Error"
@using System.Diagnostics
@using FinanceTracker.Client.Components.Common
@using FinanceTracker.Client.Pages
@inherits PageComponent

<PageTitle>Something went wrong</PageTitle>

<PageHeader Title="Something went wrong" Subtitle="FinTrack hit an error handling that request"/>

<Section Title="Details for whoever runs FinTrack">
    <div class="ft-stack">
        @if (ShowRequestId)
        {
            <MudText Typo="Typo.body2">Request ID: <code>@RequestId</code></MudText>
        }
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Running in the <strong>Development</strong> environment shows the full error. Set
            <code>ASPNETCORE_ENVIRONMENT</code> to <code>Development</code> and restart to see it, on a local machine
            only, as it can show sensitive details.
        </MudText>
    </div>
</Section>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }

}

<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app's look, shared by the client's theme and charts and the server's PDFs, so it's set in one place -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisMode>Recommended</AnalysisMode>
    <FinTrackRunsInBrowser>true</FinTrackRunsInBrowser>
  </PropertyGroup>

</Project>

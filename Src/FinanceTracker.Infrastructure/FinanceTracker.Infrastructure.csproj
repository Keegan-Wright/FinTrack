<!-- The Razor SDK for the email templates, see Notifications/Email/Templates -->
<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <AnalysisMode>Recommended</AnalysisMode>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\FinanceTracker.Contracts\FinanceTracker.Contracts.csproj" />
      <ProjectReference Include="..\FinanceTracker.Design\FinanceTracker.Design.csproj"/>
      <ProjectReference Include="..\FinanceTracker.Domain\FinanceTracker.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CsvHelper"/>
      <PackageReference Include="FluentValidation"/>
      <PackageReference Include="MailKit"/>
      <PackageReference Include="Microsoft.AspNetCore.Components.Web"/>
      <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore"/>
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore"/>
      <PackageReference Include="Microsoft.EntityFrameworkCore"/>
      <PackageReference Include="Microsoft.Extensions.Http"/>
      <PackageReference Include="Quartz"/>
      <PackageReference Include="QuestPDF"/>
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    </ItemGroup>

    <!-- For the PDFs, see QuestPdfSetup -->
    <ItemGroup>
      <EmbeddedResource Include="Exports\Pdf\Fonts\*.ttf" LogicalName="Fonts.%(Filename)%(Extension)"/>
    </ItemGroup>

    <!-- For the webhook sender over a test handler -->
    <ItemGroup>
      <InternalsVisibleTo Include="FinanceTracker.Tests.Unit.Infrastructure"/>
    </ItemGroup>

    <!-- The logo in emails, a PNG as email apps don't show SVG. Made from the favicon:
         rsvg-convert -w 96 -h 96 ../FinanceTracker/wwwroot/favicon.svg -o Notifications/Email/Templates/logo.png -->
    <ItemGroup>
      <EmbeddedResource Include="Notifications\Email\Templates\logo.png" LogicalName="Email.logo.png"/>
    </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Generators\FinanceTracker.Generated.Attributes\FinanceTracker.Generated.Attributes\FinanceTracker.Generated.Attributes.csproj" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\Generators\FinanceTracker.Generated.Enums\FinanceTracker.Generated.Enums\FinanceTracker.Generated.Enums.csproj" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>

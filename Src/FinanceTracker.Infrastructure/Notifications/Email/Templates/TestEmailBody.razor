@* The email the Notifications page sends to show email works and how notifications will look. *@
<EmailLayout Title="@NotificationEmails.TestSubject" Preheader="Email from FinTrack works.">
    <ChildContent>
        <p style="@EmailStyles.Eyebrow color: @LightPalette.Primary;">Test</p>
        <h1 style="@EmailStyles.Heading">Email works</h1>
        <p style="@EmailStyles.Body">
            This is how FinTrack's notifications will reach you, for the kinds you've chosen.
        </p>
        @if (Settings is not null)
        {
            <EmailButton Text="Open your notifications" Href="@Settings"/>
        }
    </ChildContent>
    <Footer>
        <EmailFooter Reason="You asked for this test from FinTrack." Settings="@Settings" PublicUrl="@PublicUrl"/>
    </Footer>
</EmailLayout>

@code {

    /// <inheritdoc cref="EmailFooter.Settings"/>
    [Parameter]
    public Uri? Settings { get; set; }

    /// <inheritdoc cref="EmailFooter.PublicUrl"/>
    [Parameter]
    public Uri? PublicUrl { get; set; }

}

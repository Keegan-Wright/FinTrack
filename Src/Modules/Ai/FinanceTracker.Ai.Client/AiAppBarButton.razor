@* The AI module's button in the app bar, to open AI from any page, once the user can use it. *@
@inherits AiStatusComponent
@attribute [ModuleSlot(ModuleSlots.AppBar)]

@if (CanUseAi)
{
    <MudTooltip Text="AI">
        <MudIconButton Icon="@Icons.Material.Outlined.AutoAwesome" Color="Color.Inherit" Href="/Ai"
                       aria-label="Open AI"/>
    </MudTooltip>
}

@* The AI module's button in the app bar, to open AI from any page. The layout renders it by name once the module's
   assembly has loaded, since the always-loaded app can't refer to it. *@
<MudTooltip Text="AI">
    <MudIconButton Icon="@Icons.Material.Outlined.AutoAwesome" Color="Color.Inherit" Href="/Ai" aria-label="Open AI"/>
</MudTooltip>

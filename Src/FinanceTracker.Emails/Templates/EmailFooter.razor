@* Why the email came, where to change that for a notification, and which FinTrack sent it when its address is
   known. *@
@* Razor drops the whitespace between an expression and the text after it, so the space after the reason is written
   out *@
<p style="@EmailStyles.Quiet">
    @($"{Reason} ")@if (IsNotification && Settings is null)
    {
        <text>You can change which emails you get in FinTrack, under Notifications.</text>
    }
    else if (IsNotification)
    {
        <text>You can </text><a href="@Settings" style="@EmailStyles.Link">change which emails you get</a><text>.</text>
    }
</p>
@if (PublicUrl is not null)
{
    <p style="@EmailStyles.Quiet margin-top: 8px;">Sent by FinTrack at @PublicUrl.Authority</p>
}

@code {

    /// <summary>
    /// Why the email came, a sentence, e.g. <c>You asked for this test from FinTrack.</c>
    /// </summary>
    [Parameter, EditorRequired]
    public required string Reason { get; set; }

    /// <summary>
    /// Whether it's a notification, which the user can turn off, so it says where to change that. An account's own
    /// emails, such as a password reset, aren't.
    /// </summary>
    [Parameter]
    public bool IsNotification { get; set; } = true;

    /// <summary>
    /// The Notifications page, null when the app's address isn't known.
    /// </summary>
    [Parameter]
    public Uri? Settings { get; set; }

    /// <summary>
    /// The app's address, null when it isn't known.
    /// </summary>
    [Parameter]
    public Uri? PublicUrl { get; set; }

}

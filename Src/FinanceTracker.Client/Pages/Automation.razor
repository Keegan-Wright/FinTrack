@page "/Automation"
@* The background jobs (IAutomationService): how each is doing, its runs, running a scheduled job now and editing its
   schedule and retries. The jobs run for every user, so only admins can see them. Keeps up as jobs start and finish,
   through the sync hub and by checking every few seconds while one runs. *@
@using FinanceTracker.Client.Components.Automation
@using FinanceTracker.Client.Components.Dialogs
@using FinanceTracker.Contracts.Auth
@using FinanceTracker.Contracts.Automation
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent

@attribute [Authorize(Roles = FinTrackRoles.Admin)]
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IAutomationService AutomationService
@inject ISyncNotifications SyncNotifications
@inject TimeProvider TimeProvider

<PageTitle>FinTrack - Automation</PageTitle>
<PageHeader Title="Automation" Subtitle="Background jobs that run for every user, admins only"/>

<div class="ft-stack">
    @if (Jobs is { Count: 0 })
    {
        <Section>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">No jobs scheduled.</MudText>
        </Section>
    }
    else
    {
        @foreach (AutomationJobSummary job in Jobs ?? [])
        {
            <AutomationJob @key="job.Function" Job="@job" Refresh="@_refreshes"
                           ShowRuns="@_showingRuns.Contains(job.Function)"
                           ShowRunsChanged="@(show => SetShowRuns(job.Function, show))"
                           OnEdit="@(() => EditCronItem(job.Schedule!))"
                           OnRunNow="@(() => RunNowAsync(job))"/>
        }
    }
</div>

@code {

    /// <summary>
    /// How often the page checks on the jobs while one is running.
    /// </summary>
    public static readonly TimeSpan RunningCheckInterval = TimeSpan.FromSeconds(5);

    // The jobs whose runs are open, and a count that tells them to load their runs again
    private readonly HashSet<string> _showingRuns = [];
    private int _refreshes;
    private bool _refreshing;

    /// <summary>
    /// How each background job is doing, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public List<AutomationJobSummary>? Jobs { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Jobs = await LoadOnceAsync(Jobs, "Loading jobs", LoadJobsAsync);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
        {
            return;
        }

        // Only once interactive, a prerender has no connection to the hub. Leaving the page stops both.
        _ = CheckWhileRunningAsync();
        await SubscribeToJobsAsync();
    }

    // Without the hub the page still catches up on running jobs, just not on ones that start elsewhere
    private async Task SubscribeToJobsAsync()
    {
        try
        {
            IDisposable subscription = await SyncNotifications.SubscribeToJobsAsync(
                _ => InvokeAsync(RefreshAsync), _cts.Token);
            _cts.Token.Register(subscription.Dispose);
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            // Left the page
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't connect for live updates, refresh to try again", Severity.Warning);
        }
    }

    private Task<List<AutomationJobSummary>> LoadJobsAsync(CancellationToken cancellationToken) =>
        AutomationService.GetJobSummariesAsync(cancellationToken).ToListAsync(cancellationToken).AsTask();

    private bool AnyRunning => Jobs?.Any(static x => x.LastRun?.Status is AutomationRunStatus.Running
        or AutomationRunStatus.Retrying) == true;

    // A job says it's finished just before TickerQ saves how it went, so a running job is checked on until it's done
    private async Task CheckWhileRunningAsync()
    {
        using PeriodicTimer timer = new(RunningCheckInterval, TimeProvider);
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                if (AnyRunning)
                {
                    await InvokeAsync(RefreshAsync);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Left the page
        }
    }

    /// <summary>
    /// Loads the jobs again without the loading overlay, and the open runs with them.
    /// </summary>
    private async Task RefreshAsync()
    {
        if (_refreshing)
        {
            return;
        }

        _refreshing = true;
        try
        {
            Jobs = await LoadJobsAsync(_cts.Token);
            _refreshes++;
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            return;
        }
        catch (Exception)
        {
            // Kept as it was, the next change or check tries again
        }
        finally
        {
            _refreshing = false;
        }

        StateHasChanged();
    }

    private void SetShowRuns(string function, bool show)
    {
        if (show)
        {
            _showingRuns.Add(function);
        }
        else
        {
            _showingRuns.Remove(function);
        }
    }

    private async Task RunNowAsync(AutomationJobSummary job)
    {
        string name = AutomationText.JobName(job.Function);
        bool? confirmed = await DialogService.ShowMessageBoxAsync($"Run {name} now?",
            "It runs for every user, on top of its schedule.", yesText: "Run now", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await AutomationService.RunNowAsync(job.Schedule!.Id, _cts.Token);
            Snackbar.Add($"{name} queued", Severity.Success);
            _showingRuns.Add(job.Function);
        }
        catch (JobAlreadyRunningException)
        {
            Snackbar.Add($"{name} is already running", Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add($"Couldn't run {name}, try again", Severity.Error);
        }

        await RefreshAsync();
    }

    private async Task EditCronItem(AutomationCron job)
    {
        var dialogParameters = new DialogParameters<ModifyCronDialog>
        {
            { x => x.CronId, job.Id },
            { x => x.Description, job.Description },
            { x => x.Expression, job.Expression },
            { x => x.Retries, job.Retries },
            { x => x.RetryIntervals, job.RetryIntervals },
            { x => x.IsEnabled, job.IsEnabled }
        };

        var dialogRef = await DialogService.ShowAsync<ModifyCronDialog>(null, dialogParameters);
        var dialogActionResult = await dialogRef.Result;

        if (dialogActionResult is null || dialogActionResult.Canceled)
            return;

        try
        {
            SetLoadingState(true, "Updating job");
            var cronJobUpdateRequest = (UpdateCronJob)dialogActionResult.Data!;
            await AutomationService.UpdateJobSettingsAsync(cronJobUpdateRequest, _cts.Token);
            Snackbar.Add("Job updated", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't update the job, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
            Jobs = await LoadJobsAsync(_cts.Token);
        }
    }

}

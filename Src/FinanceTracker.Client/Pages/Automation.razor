@page "/Automation"
@* Lists the scheduled background jobs (IAutomationService) and edits their schedule and retries. The jobs run for
   every user, so only admins can see them. *@
@using FinanceTracker.Client.Components.Dialogs
@using FinanceTracker.Contracts.Auth
@using FinanceTracker.Contracts.Automation
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent

@attribute [Authorize(Roles = FinTrackRoles.Admin)]
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IAutomationService AutomationService

<PageTitle>Automation</PageTitle>
<PageHeader Title="Automation" Subtitle="Background jobs that run for every user, admins only"/>

<MudDataGrid T="AutomationCron" Items="@(Jobs ?? [])"
             SortMode="SortMode.Multiple"
             Hideable="true"
             Hover="true"
             Dense="true"
             Elevation="0"
             Outlined="true"
             RowsPerPage="50"
             FixedHeader="true"
             Class="ft-grid">
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">No jobs scheduled.</MudText>
    </NoRecordsContent>
    <Columns>
        <PropertyColumn Property="x => x.Function" Title="Job" Sortable="true">
            <CellTemplate>
                <MudText Typo="Typo.body2">@context.Item.Function</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Item.Description</MudText>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Expression" Title="Schedule" Sortable="true">
            <CellTemplate>
                <code class="ft-code">@context.Item.Expression</code>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Retries" Title="Retries" Sortable="true"/>
        <TemplateColumn Title="Retry after (s)" Sortable="false">
            <CellTemplate>
                <div class="ft-chips">
                    @foreach (var interval in context.Item.RetryIntervals ?? [])
                    {
                        <MudChip T="int" Size="Size.Small" Variant="Variant.Text">@interval</MudChip>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.IsEnabled" Title="Status" Sortable="true">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Color="@(context.Item.IsEnabled ? Color.Success : Color.Default)">
                    @(context.Item.IsEnabled ? "Enabled" : "Paused")
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="" Sortable="false" Hideable="false" CellClass="ft-grid__actions">
            <CellTemplate>
                <MudTooltip Text="Edit job">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="Edit job"
                                   OnClick="@(() => EditCronItem(context.Item))"/>
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="AutomationCron"/>
    </PagerContent>
</MudDataGrid>

@code {

    /// <summary>
    /// The background jobs, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public List<AutomationCron>? Jobs { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Jobs = await LoadOnceAsync(Jobs, "Loading jobs", LoadJobsAsync);
    }

    private Task<List<AutomationCron>> LoadJobsAsync(CancellationToken cancellationToken) =>
        AutomationService.GetJobsAsync(cancellationToken).ToListAsync(cancellationToken).AsTask();

    private async Task EditCronItem(AutomationCron job)
    {
        var dialogParameters = new DialogParameters<ModifyCronDialog>
        {
            { x => x.CronId, job.Id },
            { x => x.Description, job.Description },
            { x => x.Expression, job.Expression },
            { x => x.Retries, job.Retries },
            { x => x.RetryIntervals, job.RetryIntervals },
            { x => x.IsEnabled, job.IsEnabled }
        };

        var dialogRef = await DialogService.ShowAsync<ModifyCronDialog>(null, dialogParameters);
        var dialogActionResult = await dialogRef.Result;

        if (dialogActionResult is null || dialogActionResult.Canceled)
            return;

        try
        {
            SetLoadingState(true, "Updating job");
            var cronJobUpdateRequest = (UpdateCronJob)dialogActionResult.Data!;
            await AutomationService.UpdateJobSettingsAsync(cronJobUpdateRequest, _cts.Token);
            Snackbar.Add("Job updated", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't update the job, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
            Jobs = await LoadJobsAsync(_cts.Token);
        }
    }

}

@page "/Users"
@* Everyone who can sign in (IUsersService), for admins: how each signs in and whether their email is confirmed, a
   one-time reset link for one who's forgotten their password and can't be emailed one, turning off two-factor sign in
   for one who's lost their phone, locking one out, and who else is an admin. *@
@using FinanceTracker.Client.Components.Users
@using FinanceTracker.Contracts.Auth
@using FinanceTracker.Contracts.Users
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent

@attribute [Authorize(Roles = FinTrackRoles.Admin)]
@inject IUsersService UsersService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>FinTrack - Users</PageTitle>
<PageHeader Title="Users" Subtitle="Everyone who can sign in to this FinTrack"/>

<Section>
    <div class="ft-stack">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Someone who's forgotten their password and can't get a reset email can be given a link from here. They
            choose the new password, you never see it.
        </MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Someone who's lost their phone and their recovery codes can have two-factor sign in turned off from here,
            and someone who's lost the devices their passkeys are on can have them removed. Make sure it's really them
            asking first.
        </MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Locking someone signs them out and stops them signing in until you unlock them.
        </MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Admins see this page and Automation. Admins can't be locked, remove their admin access first. Someone who
            signs in through the identity provider is an admin when they're in its admins group.
        </MudText>

        @if (Items is null or { Count: 0 })
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Nobody could be loaded.</MudText>
        }
        else
        {
            <div class="ft-list">
                @foreach (UserSummary user in Items)
                {
                    <div class="ft-list__row ft-users__row">
                        <MudIcon Icon="@Icons.Material.Outlined.Person" aria-hidden="true"/>
                        <div class="ft-list__main">
                            <div class="ft-users__name">
                                <MudText Typo="Typo.body2" Class="ft-users__username">@user.Username</MudText>
                                @if (user.IsAdmin)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="Color.Primary">@AdminText(user)
                                    </MudChip>
                                }
                                @if (user.IsYou)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">You</MudChip>
                                }
                                @if (user.TwoFactorEnabled)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Icon="@Icons.Material.Outlined.PhonelinkLock">Two-factor
                                    </MudChip>
                                }
                                @if (user.PasskeyCount > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Icon="@Icons.Material.Outlined.Fingerprint">@PasskeysText(user)
                                    </MudChip>
                                }
                                @if (user.IsLocked)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="Color.Warning" Icon="@Icons.Material.Outlined.Lock">Locked
                                    </MudChip>
                                }
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary ft-users__email">
                                @EmailText(user)
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@SignInText(user)</MudText>
                        </div>
                        <div class="ft-users__actions">
                            @if (user.HasPassword)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Outlined.Key"
                                           aria-label="@($"Make a reset link for {user.Username}")"
                                           OnClick="@(() => MakeResetLinkAsync(user))">Reset link
                                </MudButton>
                            }
                            @* Their own is turned off from their profile, with their password *@
                            @if (user.TwoFactorEnabled && !user.IsYou)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small"
                                           StartIcon="@Icons.Material.Outlined.PhonelinkErase"
                                           aria-label="@($"Turn off two-factor sign in for {user.Username}")"
                                           OnClick="@(() => TurnOffTwoFactorAsync(user))">Turn off two-factor
                                </MudButton>
                            }
                            @if (user.PasskeyCount > 0 && !user.IsYou)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small"
                                           StartIcon="@Icons.Material.Outlined.Delete"
                                           aria-label="@($"Remove passkeys for {user.Username}")"
                                           OnClick="@(() => RemovePasskeysAsync(user))">Remove passkeys
                                </MudButton>
                            }
                            @if (user.IsLocked)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Outlined.LockOpen"
                                           aria-label="@($"Unlock {user.Username}")"
                                           OnClick="@(() => UnlockAsync(user))">Unlock
                                </MudButton>
                            }
                            else if (!user.IsAdmin)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small"
                                           StartIcon="@Icons.Material.Outlined.Lock"
                                           aria-label="@($"Lock {user.Username}")"
                                           OnClick="@(() => LockAsync(user))">Lock
                                </MudButton>
                            }
                            @* The identity provider's admins group decides for those who sign in through it *@
                            @if (!user.UsesIdentityProvider && user.IsAdmin)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small"
                                           StartIcon="@Icons.Material.Outlined.RemoveModerator"
                                           aria-label="@($"Remove admin access for {user.Name}")"
                                           OnClick="@(() => RemoveAdminAsync(user))">Remove admin access
                                </MudButton>
                            }
                            else if (!user.UsesIdentityProvider && !user.IsLocked)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Outlined.AddModerator"
                                           aria-label="@($"Add admin access for {user.Name}")"
                                           OnClick="@(() => GrantAdminAsync(user))">Add admin access
                                </MudButton>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</Section>

@code {

    /// <summary>
    /// The users, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public List<UserSummary>? Items { get; set; }

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Items = await LoadOnceAsync(Items, "Loading the users", cancellationToken =>
            UsersService.GetUsersAsync(cancellationToken).ToListAsync(cancellationToken).AsTask());
    }

    /// <summary>
    /// The user's email and whether it's confirmed.
    /// </summary>
    /// <param name="user">The user.</param>
    private static string EmailText(UserSummary user)
    {
        if (user.Email is null)
        {
            return "No email";
        }

        if (user.EmailConfirmed)
        {
            return $"{user.Email} · Confirmed";
        }

        return $"{user.Email} · Not confirmed";
    }

    /// <summary>
    /// The admin chip's text, saying when the identity provider's group gives the role.
    /// </summary>
    /// <param name="user">An admin.</param>
    private static string AdminText(UserSummary user) => user.UsesIdentityProvider ? "Admin from SSO group" : "Admin";

    /// <summary>
    /// How the user signs in.
    /// </summary>
    /// <param name="user">The user.</param>
    private static string SignInText(UserSummary user)
    {
        if (user.HasPassword && user.UsesIdentityProvider)
        {
            return "Signs in with a password or the identity provider";
        }

        if (user.HasPassword)
        {
            return "Signs in with a password";
        }

        return "Signs in through the identity provider, which looks after their password";
    }

    /// <summary>
    /// Makes a password reset link and shows it.
    /// </summary>
    /// <param name="user">The user.</param>
    internal async Task MakeResetLinkAsync(UserSummary user)
    {
        SetLoadingState(true, "Making a reset link");
        try
        {
            ResetLink? link = await UsersService.CreateResetLinkAsync(user.Id, _cts.Token);
            if (link is null)
            {
                Snackbar.Add($"{user.Username} signs in through the identity provider, there's no password to reset",
                    Severity.Warning);
                return;
            }

            DialogParameters<ResetLinkDialog> parameters = new()
            {
                { x => x.Username, user.Username },
                { x => x.Link, link }
            };
            await DialogService.ShowAsync<ResetLinkDialog>($"Reset link for {user.Username}", parameters);
        }
        catch (Exception) when (!_cts.IsCancellationRequested)
        {
            Snackbar.Add("Couldn't make a reset link, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    /// <summary>
    /// Turns off a user's two-factor sign in once the admin confirms.
    /// </summary>
    /// <param name="user">The user.</param>
    internal async Task TurnOffTwoFactorAsync(UserSummary user)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync($"Turn off two-factor sign in for {user.Username}?",
            "For someone who's lost their phone and their recovery codes, so make sure it's really them asking. " +
            "They're signed out, can sign in with just their password, and are emailed to say so. Their old " +
            "authenticator and recovery codes stop working.",
            yesText: "Turn off", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await ChangeAsync(async () =>
            {
                if (!await UsersService.TurnOffTwoFactorAsync(user.Id, _cts.Token))
                {
                    Snackbar.Add("Turn off your own two-factor sign in from Your profile", Severity.Warning);
                }
            }, $"Couldn't turn off two-factor sign in for {user.Username}, try again");
    }

    /// <summary>
    /// Removes all a user's passkeys once the admin confirms.
    /// </summary>
    /// <param name="user">The user.</param>
    internal async Task RemovePasskeysAsync(UserSummary user)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync($"Remove the passkeys of {user.Username}?",
            "For someone who's lost the devices they're on, so make sure it's really them asking. None of them can " +
            "sign in any more, and they're emailed to say so.",
            yesText: "Remove", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await ChangeAsync(async () =>
            {
                if (!await UsersService.RemovePasskeysAsync(user.Id, _cts.Token))
                {
                    Snackbar.Add("Remove your own passkeys from Your profile", Severity.Warning);
                }
            }, $"Couldn't remove the passkeys of {user.Username}, try again");
    }

    /// <summary>
    /// How many passkeys a user has, for their chip.
    /// </summary>
    /// <param name="user">The user.</param>
    private static string PasskeysText(UserSummary user) =>
        user.PasskeyCount == 1 ? "1 passkey" : $"{user.PasskeyCount} passkeys";

    /// <summary>
    /// Locks a user once the admin confirms.
    /// </summary>
    /// <param name="user">The user.</param>
    internal async Task LockAsync(UserSummary user)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync($"Lock {user.Username}?",
            "They're signed out within a minute and can't sign in until you unlock them. Their banks aren't synced " +
            "and they get no notifications meanwhile.",
            yesText: "Lock", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await ChangeAsync(async () =>
            {
                if (!await UsersService.LockAsync(user.Id, _cts.Token))
                {
                    Snackbar.Add($"{user.Name} is an admin, remove their admin access first", Severity.Warning);
                }
            }, $"Couldn't lock {user.Username}, try again");
    }

    /// <summary>
    /// Makes a user an admin once the admin confirms.
    /// </summary>
    /// <param name="user">The user.</param>
    internal async Task GrantAdminAsync(UserSummary user)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync($"Add admin access for {user.Name}?",
            "Within a minute they can see everyone who signs in, lock them, make reset links and run Automation.",
            yesText: "Add admin access", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await ChangeAsync(async () => NotifyIfRefused(user, await UsersService.GrantAdminAsync(user.Id, _cts.Token)),
            $"Couldn't add admin access for {user.Name}, try again");
    }

    /// <summary>
    /// Takes a user's admin role once the admin confirms. Taking their own leaves this page for the dashboard.
    /// </summary>
    /// <param name="user">The user.</param>
    internal async Task RemoveAdminAsync(UserSummary user)
    {
        string title = $"Remove admin access for {user.Name}?";
        string message = "Within a minute they lose this page and Automation.";
        string yes = "Remove admin access";
        if (user.IsYou)
        {
            title = "Remove your admin access?";
            message = "You'll lose access to this page and Automation straight away.";
            yes = "Remove my access";
        }

        bool? confirmed = await DialogService.ShowMessageBoxAsync(title, message, yesText: yes, cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        if (user.IsYou)
        {
            await RemoveOwnAdminAsync(user);
            return;
        }

        await ChangeAsync(async () => NotifyIfRefused(user, await UsersService.RemoveAdminAsync(user.Id, _cts.Token)),
            $"Couldn't remove admin access for {user.Name}, try again");
    }

    /// <summary>
    /// Takes the admin's own role, then leaves for the dashboard, a fresh load so the menu drops the admin pages.
    /// </summary>
    /// <param name="you">The admin looking.</param>
    private async Task RemoveOwnAdminAsync(UserSummary you)
    {
        SetLoadingState(true, "Saving");
        try
        {
            AdminChange change = await UsersService.RemoveAdminAsync(you.Id, _cts.Token);
            if (change == AdminChange.Changed)
            {
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }

            NotifyIfRefused(you, change);
        }
        catch (Exception) when (!_cts.IsCancellationRequested)
        {
            Snackbar.Add("Couldn't remove your admin access, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    /// <summary>
    /// Says why giving or taking the admin role was refused, nothing when it wasn't.
    /// </summary>
    /// <param name="user">The user.</param>
    /// <param name="change">How it went.</param>
    private void NotifyIfRefused(UserSummary user, AdminChange change)
    {
        if (change == AdminChange.FromIdentityProvider)
        {
            Snackbar.Add($"{user.Name} signs in through the identity provider, its admins group decides",
                Severity.Warning);
        }

        if (change == AdminChange.LastAdmin)
        {
            Snackbar.Add("You're the only admin, make someone else an admin first", Severity.Warning);
        }
    }

    /// <summary>
    /// Unlocks a user.
    /// </summary>
    /// <param name="user">The user.</param>
    internal Task UnlockAsync(UserSummary user) =>
        ChangeAsync(() => UsersService.UnlockAsync(user.Id, _cts.Token), $"Couldn't unlock {user.Username}, try again");

    // Makes a change to a user, then reloads them all so the rows show it
    /// <summary>
    /// Makes a change and reloads the users, saying when it fails.
    /// </summary>
    /// <param name="change">The change.</param>
    /// <param name="failed">What's said when it fails.</param>
    private async Task ChangeAsync(Func<Task> change, string failed)
    {
        SetLoadingState(true, "Saving");
        try
        {
            await change();
            Items = await UsersService.GetUsersAsync(_cts.Token).ToListAsync(_cts.Token);
        }
        catch (Exception) when (!_cts.IsCancellationRequested)
        {
            Snackbar.Add(failed, Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

}

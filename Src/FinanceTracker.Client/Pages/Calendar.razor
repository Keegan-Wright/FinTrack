@page "/Calendar"
@* A month view of the user's transactions and savings goal dates (ICalendarService). *@
@using System.Globalization
@using FinanceTracker.Contracts.Calendar
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent

@attribute [Authorize]
@inject ICalendarService CalendarService
@inject TimeProvider TimeProvider

<PageTitle>Calendar</PageTitle>

<MudGrid Spacing="4">
    <MudItem xs="4">
        <MudDatePicker Date="@Month" DateChanged="@SelectedDateUpdatedAsync"></MudDatePicker>
    </MudItem>

    <MudFlexBreak/>

    @foreach (var calenderItem in Days ?? [])
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="h-100">
                <MudCardHeader>
                    <MudText Typo="Typo.h6">@calenderItem.Date.ToString("dd/MM/yyyy")</MudText>
                </MudCardHeader>
                <MudCardContent>
                    <MudExpansionPanels MultiExpansion="true">
                        <MudExpansionPanel Text="Transactions">
                            <MudPaper MaxHeight="300px" Style="overflow-y: auto;" Elevation="0">
                                @if (!calenderItem.Transactions.Any())
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">No transactions on this day.</MudText>
                                }
                                else
                                {
                                    <MudTable Items="calenderItem.Transactions" Hover="true" Breakpoint="Breakpoint.None" Dense="true" Elevation="0">
                                        <HeaderContent>
                                            <MudTh>Desc</MudTh>
                                            <MudTh>Amount</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="Desc">@context.Description</MudTd>
                                            <MudTd DataLabel="Amount">
                                                <MudText Color="@(context.Amount < 0 ? Color.Error : Color.Success)" Typo="Typo.body2">
                                                    @context.Amount.ToString("C", CultureInfo.CurrentCulture)
                                                </MudText>
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                            </MudPaper>
                        </MudExpansionPanel>

                        <MudExpansionPanel Text="Goals">
                            <MudPaper MaxHeight="200px" Style="overflow-y: auto;" Elevation="0">
                                @if (!calenderItem.Goals.Any())
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">No goals ending on this day.</MudText>
                                }
                                else
                                {
                                    <MudList T="string" Dense="true">
                                        @foreach (var goal in calenderItem.Goals)
                                        {
                                            <MudListItem Text="@goal.Name" Icon="@Icons.Material.Filled.Flag" />
                                        }
                                    </MudList>
                                }
                            </MudPaper>
                        </MudExpansionPanel>

                        <MudExpansionPanel Text="Events">
                            <MudPaper MaxHeight="200px" Style="overflow-y: auto;" Elevation="0">
                                @if (!calenderItem.Events.Any())
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">No events on this day.</MudText>
                                }
                                else
                                {
                                    @foreach (var userEvent in calenderItem.Events)
                                    {
                                        // Placeholder
                                    }
                                }
                            </MudPaper>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }

</MudGrid>

@code {

    /// <summary>
    /// The month shown, this month (server time) to start with. Persisted with <see cref="Days"/> so the browser
    /// shows the month the server loaded.
    /// </summary>
    [PersistentState]
    public DateTime? Month { get; set; }

    /// <summary>
    /// Each day of <see cref="Month"/>, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public List<CalendarItems>? Days { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Month ??= TimeProvider.GetLocalNow().DateTime;
        Days = await LoadOnceAsync(Days, "Loading your calendar", LoadMonthAsync);
    }

    private async Task SelectedDateUpdatedAsync(DateTime? obj)
    {
        if (obj is null)
            return;

        Month = obj.Value;
        SetLoadingState(true, "Loading your calendar");
        Days = await LoadMonthAsync(_cts.Token);
        SetLoadingState(false);
    }

    private Task<List<CalendarItems>> LoadMonthAsync(CancellationToken cancellationToken)
    {
        DateTime month = Month!.Value;
        return CalendarService.GetMonthItemsAsync(month.Month, month.Year, cancellationToken)
            .ToListAsync(cancellationToken).AsTask();
    }

}

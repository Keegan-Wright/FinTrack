@page "/Calendar"
@* A month view of the user's transactions, bills, savings goal and debt dates, and their own events
   (ICalendarService). A grid of days with each day's net and markers for what's on, and the chosen day's events,
   bills, debts, goals and transactions beside it, where events are added, changed and deleted. *@
@using System.Globalization
@using FinanceTracker.Client.Components.Bills
@using FinanceTracker.Client.Components.Calendar
@using FinanceTracker.Contracts
@using FinanceTracker.Contracts.Bills
@using FinanceTracker.Contracts.Calendar
@using FinanceTracker.Contracts.SavingsGoals
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent

@attribute [Authorize]
@inject ICalendarService CalendarService
@inject ISavingsGoalsService SavingsGoalsService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject TimeProvider TimeProvider

<PageTitle>FinTrack - Calendar</PageTitle>
<PageHeader Title="Calendar" Subtitle="@MonthStart.ToString("MMMM yyyy", CultureInfo.CurrentCulture)">
    <Actions>
        <MudTooltip Text="Previous month">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="Previous month"
                           OnClick="@(() => ChangeMonthAsync(-1))"/>
        </MudTooltip>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@GoToTodayAsync"
                   Disabled="@IsCurrentMonth">Today</MudButton>
        <MudTooltip Text="Next month">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="Next month"
                           OnClick="@(() => ChangeMonthAsync(1))"/>
        </MudTooltip>
    </Actions>
</PageHeader>

<MudGrid Spacing="4">
    <MudItem xs="12" lg="8">
        <Section>
            <div class="ft-calendar" role="grid" aria-label="@MonthStart.ToString("MMMM yyyy", CultureInfo.CurrentCulture)">
                @foreach (var dayName in WeekdayNames)
                {
                    <div class="ft-calendar__weekday" role="columnheader">@dayName</div>
                }
                @for (var i = 0; i < LeadingBlanks; i++)
                {
                    <div class="ft-calendar__blank"></div>
                }
                @foreach (var day in Days ?? [])
                {
                    var date = day.Date.Date;
                    var net = day.Transactions.Sum(static x => x.Amount);
                    var hasTransactions = day.Transactions.Any();
                    var selected = date == _selectedDate;
                    <button type="button" role="gridcell" aria-selected="@(selected ? "true" : "false")"
                            class="@DayClass(date, selected)" @onclick="@(() => _selectedDate = date)">
                        <span class="ft-calendar__number">@date.Day</span>
                        @if (hasTransactions)
                        {
                            var moneyIn = day.Transactions.Where(static x => x.Amount > 0).Sum(static x => x.Amount);
                            var moneyOut = day.Transactions.Where(static x => x.Amount < 0).Sum(static x => x.Amount);
                            <span class="ft-calendar__net">
                                <MoneyText Value="@net" Signed="true" Typo="Typo.caption" Inline="true"/>
                            </span>
                            <span class="ft-calendar__flow ft-money">
                                @if (moneyIn > 0)
                                {
                                    <span>@CurrencyFormatter.Format(moneyIn) in</span>
                                }
                                @if (moneyOut < 0)
                                {
                                    <span>@CurrencyFormatter.Format(Math.Abs(moneyOut)) out</span>
                                }
                            </span>
                        }
                        <span class="ft-calendar__markers">
                            @if (hasTransactions)
                            {
                                <span class="@($"ft-calendar__dot {(net < 0 ? "ft-calendar__dot--out" : "ft-calendar__dot--in")}")"></span>
                            }
                            @if (day.Bills.Any())
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.EventRepeat" Size="Size.Small"
                                         Color="@BillColor(day.Bills)" Class="ft-calendar__icon"
                                         aria-label="@BillsLabel(day.Bills)"/>
                            }
                            @if (day.Goals.Any())
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Flag" Size="Size.Small" Color="Color.Warning"
                                         Class="ft-calendar__icon"/>
                            }
                            @if (day.Events.Any())
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.Celebration" Size="Size.Small"
                                         Color="Color.Primary" Class="ft-calendar__icon"
                                         aria-label="@CalendarText.EventsLabel(day.Events.Count())"/>
                            }
                            @if (day.Debts.Any())
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.CreditScore" Size="Size.Small"
                                         Color="Color.Success" Class="ft-calendar__icon"/>
                            }
                        </span>
                    </button>
                }
            </div>
        </Section>
    </MudItem>
    <MudItem xs="12" lg="4">
        @* A busy day scrolls inside the calendar's height beside it *@
        <Section Title="@_selectedDate.ToString("dddd d MMMM", CultureInfo.CurrentCulture)"
                 Caption="@SelectedCaption" Class="h-100" ScrollBody="true">
            <Actions>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Add" OnClick="@AddEventAsync">Add event</MudButton>
            </Actions>
            <ChildContent>
                @if (SelectedDay is null || IsQuiet(SelectedDay))
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">A quiet day, nothing in or out.</MudText>
                }
                else
                {
                    <div class="ft-list">
                        @foreach (CalendarEventItem calendarEvent in SelectedDay.Events)
                        {
                            <div class="ft-list__row">
                                <MudIcon Icon="@Icons.Material.Outlined.Celebration" Color="Color.Primary"/>
                                <div class="ft-list__main">
                                    <MudText Typo="Typo.body2" Class="text-truncate">@calendarEvent.Title</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @(CalendarText.Saving(calendarEvent) ?? CalendarText.Kind(calendarEvent))
                                    </MudText>
                                    @if (calendarEvent.Notes is { } notes)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@notes</MudText>
                                    }
                                </div>
                                <div class="ft-list__end">
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                                             aria-label="@($"Actions for {calendarEvent.Title}")">
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Edit"
                                                     OnClick="@(() => EditEventAsync(calendarEvent))">Edit</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Delete"
                                                     OnClick="@(() => DeleteEventAsync(calendarEvent))">Delete</MudMenuItem>
                                    </MudMenu>
                                </div>
                            </div>
                        }
                        @foreach (CalendarDebtItem debt in SelectedDay.Debts)
                        {
                            <div class="ft-list__row">
                                <MudIcon Icon="@Icons.Material.Outlined.CreditScore"
                                         Color="@(debt.OnTrack == false ? Color.Warning : Color.Success)"/>
                                <div class="ft-list__main">
                                    <MudLink Href="@($"Debts/{debt.DebtId}")" Typo="Typo.body2" Class="text-truncate">
                                        @debt.Name
                                    </MudLink>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@CalendarText.DebtDate(debt)</MudText>
                                </div>
                            </div>
                        }
                        @foreach (CalendarBillItem bill in SelectedDay.Bills)
                        {
                            <div class="ft-list__row">
                                <MudIcon Icon="@BillText.StateIcon(bill.State)" Color="@BillText.StateColor(bill.State)"/>
                                <div class="ft-list__main">
                                    <MudText Typo="Typo.body2" Class="text-truncate">@bill.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@BillStateText(bill.State)</MudText>
                                </div>
                                <div class="ft-list__end">
                                    <MoneyText Value="@bill.Amount"/>
                                </div>
                            </div>
                        }
                        @foreach (var goal in SelectedDay.Goals)
                        {
                            <div class="ft-list__row">
                                <MudIcon Icon="@Icons.Material.Filled.Flag" Color="Color.Warning"/>
                                <div class="ft-list__main">
                                    <MudText Typo="Typo.body2" Class="text-truncate">@goal.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Savings goal due</MudText>
                                </div>
                            </div>
                        }
                        @foreach (var transaction in SelectedDay.Transactions.OrderBy(static x => x.TransactionTime))
                        {
                            <div class="ft-list__row">
                                <div class="ft-list__main">
                                    <MudText Typo="Typo.body2" Class="text-truncate">@transaction.Description</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @transaction.TransactionTime.ToLocalTime().ToString("HH:mm", CultureInfo.CurrentCulture)
                                        · @DisplayText.ToTitle(transaction.TransactionType)
                                    </MudText>
                                </div>
                                <div class="ft-list__end">
                                    <MoneyText Value="@transaction.Amount" Signed="true"/>
                                </div>
                            </div>
                        }
                    </div>
                }
            </ChildContent>
        </Section>
    </MudItem>
</MudGrid>

@code {

    /// <summary>
    /// The month shown, this month (server time) to start with. Persisted with <see cref="Days"/> so the browser
    /// shows the month the server loaded.
    /// </summary>
    [PersistentState]
    public DateTime? Month { get; set; }

    /// <summary>
    /// Each day of <see cref="Month"/>, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public List<CalendarItems>? Days { get; set; }

    private DateTime _selectedDate;

    private DateTime Today => TimeProvider.GetLocalNow().Date;

    private DateTime MonthStart => new(Month!.Value.Year, Month.Value.Month, 1);

    private bool IsCurrentMonth => MonthStart == new DateTime(Today.Year, Today.Month, 1);

    private CalendarItems? SelectedDay => Days?.FirstOrDefault(x => x.Date.Date == _selectedDate);

    // The week starts on the culture's first day.
    private static IReadOnlyList<string> WeekdayNames => CalendarGrid.WeekdayNames(CultureInfo.CurrentCulture.DateTimeFormat);

    private int LeadingBlanks =>
        CalendarGrid.LeadingBlanks(MonthStart, CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek);

    private static bool IsQuiet(CalendarItems day) =>
        !day.Transactions.Any() && !day.Goals.Any() && !day.Bills.Any() && !day.Events.Any() && !day.Debts.Any();

    /// <summary>
    /// The colour of the day's most pressing bill late, then a price change, then due, then paid.
    /// </summary>
    private static Color BillColor(IEnumerable<CalendarBillItem> bills)
    {
        List<BillState> states = bills.Select(static x => x.State).ToList();
        foreach (BillState state in new[] { BillState.Late, BillState.Changed, BillState.Upcoming })
        {
            if (states.Contains(state))
            {
                return BillText.StateColor(state);
            }
        }

        return BillText.StateColor(BillState.Paid);
    }

    /// <summary>
    /// e.g. <c>2 bills due</c>, for screen readers.
    /// </summary>
    private static string BillsLabel(IEnumerable<CalendarBillItem> bills)
    {
        int count = bills.Count();
        return count == 1 ? "1 bill due" : $"{count} bills due";
    }

    private static string BillStateText(BillState state) => state switch
    {
        BillState.Paid => "Bill paid",
        BillState.Late => "Bill late, not paid yet",
        BillState.Changed => "Bill paid, price changed",
        _ => "Bill due"
    };

    private string SelectedCaption
    {
        get
        {
            var count = SelectedDay?.Transactions.Count() ?? 0;
            if (count == 0)
                return string.Empty;

            var moneyIn = SelectedDay!.Transactions.Where(static x => x.Amount > 0).Sum(static x => x.Amount);
            var moneyOut = SelectedDay.Transactions.Where(static x => x.Amount < 0).Sum(static x => x.Amount);
            return $"{count} {(count == 1 ? "transaction" : "transactions")} · " +
                   $"{CurrencyFormatter.Format(moneyIn)} in · {CurrencyFormatter.Format(Math.Abs(moneyOut))} out · " +
                   $"{CurrencyFormatter.Format(moneyIn + moneyOut)} net";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Month ??= TimeProvider.GetLocalNow().DateTime;
        Days = await LoadOnceAsync(Days, "Loading your calendar", LoadMonthAsync);
        _selectedDate = DefaultSelectedDate();
    }

    /// <summary>
    /// The same month and day, with what the sync brought in.
    /// </summary>
    protected override async Task OnSyncedAsync()
    {
        DateTime month = MonthStart;
        List<CalendarItems> days = await LoadMonthAsync(_cts.Token);

        // The user moved to another month meanwhile, which loads that month itself
        if (MonthStart == month)
        {
            Days = days;
        }
    }

    private async Task ChangeMonthAsync(int months)
    {
        Month = MonthStart.AddMonths(months);
        await ReloadAsync();
    }

    private async Task GoToTodayAsync()
    {
        Month = Today;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        SetLoadingState(true, "Flipping the calendar…");
        try
        {
            Days = await LoadMonthAsync(_cts.Token);
            _selectedDate = DefaultSelectedDate();
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    // Today in the current month, otherwise the month's first day
    private DateTime DefaultSelectedDate() => IsCurrentMonth ? Today : MonthStart;

    private string DayClass(DateTime date, bool selected)
    {
        var classes = "ft-calendar__day";
        if (date == Today)
            classes += " ft-calendar__day--today";
        if (selected)
            classes += " ft-calendar__day--selected";
        return classes;
    }

    private async Task AddEventAsync()
    {
        SaveCalendarEvent? calendarEvent = await ShowEventDialogAsync(null);
        if (calendarEvent is null)
        {
            return;
        }

        await SaveEventAsync($"{calendarEvent.Title} added",
            () => CalendarService.AddEventAsync(calendarEvent, _cts.Token));
    }

    private async Task EditEventAsync(CalendarEventItem item)
    {
        CalendarEvent? existing = await FindEventAsync(item.EventId);
        if (existing is null)
        {
            Snackbar.Add($"{item.Title} isn't there any more", Severity.Error);
            await ReloadAsync();
            return;
        }

        SaveCalendarEvent? calendarEvent = await ShowEventDialogAsync(existing);
        if (calendarEvent is null)
        {
            return;
        }

        await SaveEventAsync($"{calendarEvent.Title} saved",
            () => CalendarService.UpdateEventAsync(existing.Id, calendarEvent, _cts.Token));
    }

    private async Task DeleteEventAsync(CalendarEventItem item)
    {
        string message = item.IsYearly
            ? "It goes from every year. Its savings goal stays."
            : "Its savings goal stays.";
        bool? confirmed = await DialogService.ShowMessageBoxAsync($"Delete {item.Title}?", message,
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await SaveEventAsync($"{item.Title} deleted", () => CalendarService.DeleteEventAsync(item.EventId, _cts.Token));
    }

    /// <summary>
    /// The event as it's saved, null when it's gone. The day only has what it shows.
    /// </summary>
    private async Task<CalendarEvent?> FindEventAsync(Guid id)
    {
        List<CalendarEvent> calendarEvents = await CalendarService.GetEventsAsync(_cts.Token).ToListAsync(_cts.Token);
        return calendarEvents.FirstOrDefault(x => x.Id == id);
    }

    /// <returns>What the user entered, null when they cancelled.</returns>
    private async Task<SaveCalendarEvent?> ShowEventDialogAsync(CalendarEvent? calendarEvent)
    {
        List<SavingsGoal> goals = await SavingsGoalsService.GetSavingsGoalsAsync(_cts.Token).ToListAsync(_cts.Token);
        DialogParameters<CalendarEventDialog> parameters = new()
        {
            { x => x.Event, calendarEvent },
            { x => x.Day, DateOnly.FromDateTime(_selectedDate) },
            { x => x.Goals, goals }
        };

        IDialogReference dialog = await DialogService.ShowAsync<CalendarEventDialog>(null, parameters);
        DialogResult? result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return null;
        }

        return (SaveCalendarEvent)result.Data!;
    }

    /// <summary>
    /// Makes a change, then reloads the month, keeping the chosen day.
    /// </summary>
    private async Task SaveEventAsync(string done, Func<Task> change)
    {
        DateTime selected = _selectedDate;
        try
        {
            SetLoadingState(true, "Saving…");
            await change();
            Days = await LoadMonthAsync(_cts.Token);
            Snackbar.Add(done, Severity.Success);
        }
        catch (NameTakenException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (InvalidOperationException)
        {
            Snackbar.Add("That goal or event isn't there any more, try again", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't save that, try again", Severity.Error);
        }
        finally
        {
            _selectedDate = selected;
            SetLoadingState(false);
        }
    }

    private Task<List<CalendarItems>> LoadMonthAsync(CancellationToken cancellationToken)
    {
        DateTime month = Month!.Value;
        return CalendarService.GetMonthItemsAsync(month.Month, month.Year, cancellationToken)
            .ToListAsync(cancellationToken).AsTask();
    }

}

@page "/HouseholdMembers"
@* Adds and removes the people in the user's household and their incomes (IHouseholdMemberService). *@
@using FinanceTracker.Client.Components.Dialogs
@using FinanceTracker.Contracts.HouseholdMember
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent

@attribute [Authorize]
@inject IHouseholdMemberService HouseholdMemberService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Household</PageTitle>
<PageHeader Title="Household" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PersonAdd"
                   OnClick="@AddHouseholdMember">Add person</MudButton>
    </Actions>
</PageHeader>

<Section Title="People" Caption="Their incomes count towards the dashboard's household income">
    @if (Members is null or { Count: 0 })
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Just you so far. Add the people you share money with to see your household income on the dashboard.
        </MudText>
    }
    else
    {
        <div class="ft-list">
            @foreach (var member in Members.OrderBy(static x => x.FirstName))
            {
                <div class="ft-list__row">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                        @Initials(member)
                    </MudAvatar>
                    <div class="ft-list__main">
                        <MudText Typo="Typo.body2" Class="text-truncate">@member.FirstName @member.LastName</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Income</MudText>
                    </div>
                    <div class="ft-list__end">
                        @if (member.Income is { } income)
                        {
                            <MoneyText Value="@income" Typo="Typo.body1"/>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Not set</MudText>
                        }
                    </div>
                </div>
            }
        </div>
    }
</Section>

@code {

    /// <summary>
    /// The household, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public List<HouseholdMember>? Members { get; set; }

    private string Subtitle => Members is null or { Count: 0 }
        ? "The people you share money with"
        : $"{Members.Count} {(Members.Count == 1 ? "person" : "people")} · " +
          $"{CurrencyFormatter.Format(Members.Sum(static x => x.Income ?? 0))} combined income";

    private static string Initials(HouseholdMember member) =>
        $"{member.FirstName.FirstOrDefault()}{member.LastName.FirstOrDefault()}".ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Members = await LoadOnceAsync(Members, "Loading your household", cancellationToken =>
            HouseholdMemberService.GetHouseholdMembersAsync(cancellationToken).ToListAsync(cancellationToken).AsTask());
    }

    private async Task AddHouseholdMember()
    {
        var dialogRef = await DialogService.ShowAsync<AddHouseholdMemberDialog>();
        var dialogActionResult = await dialogRef.Result;

        if (dialogActionResult is null || dialogActionResult.Canceled)
            return;

        try
        {
            SetLoadingState(true, "Making room at the table…");
            var householdMember = await HouseholdMemberService.AddHouseholdMemberAsync(
                (AddHouseholdMember)dialogActionResult.Data!, _cts.Token);
            (Members ??= []).Add(householdMember);
            Snackbar.Add($"{householdMember.FirstName} added", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't add them, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

}

@page "/HouseholdMembers"
@* Adds the people in the user's household and their incomes, and how to recognise money moved to or from them. A
   member can be marked as someone the user is linked with, taking their name. *@
@using FinanceTracker.Client.Components.Dashboard
@using FinanceTracker.Client.Components.Dialogs
@using FinanceTracker.Contracts
@using FinanceTracker.Contracts.HouseholdMember
@using FinanceTracker.Contracts.Sharing
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent

@attribute [Authorize]
@inject IHouseholdMemberService HouseholdMemberService
@inject ISharingService SharingService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>FinTrack - Household</PageTitle>
<PageHeader Title="Household" Subtitle="@Subtitle">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PersonAdd"
                   OnClick="@AddHouseholdMember">Add person</MudButton>
    </Actions>
</PageHeader>

<Section Title="People" Caption="Their incomes count towards the dashboard's household income">
    @if (Members is null or { Count: 0 })
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Just you so far. Add the people you share money with to see your household income on the dashboard.
        </MudText>
    }
    else
    {
        <div class="ft-list">
            @foreach (var member in Members.OrderBy(static x => x.FirstName))
            {
                <div class="ft-list__row">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                        @Initials(member)
                    </MudAvatar>
                    <div class="ft-list__main">
                        <MudText Typo="Typo.body2" Class="text-truncate">@member.FirstName @member.LastName</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary text-truncate">
                            @RecognitionSummary(member)
                        </MudText>
                        @if (member.LinkedUsername is { } username)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary text-truncate">
                                @($"This is @{username}")
                            </MudText>
                        }
                    </div>
                    <div class="ft-list__end">
                        @if (member.YearlyIncome is { } yearly)
                        {
                            <MoneyText Value="@yearly" Typo="Typo.body1"/>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@MonthlyText(yearly)</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Not set</MudText>
                        }
                    </div>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                             AriaLabel="@($"Actions for {member.FirstName} {member.LastName}")">
                        <MudMenuItem Icon="@Icons.Material.Outlined.Edit"
                                     OnClick="@(() => EditAsync(member))">Edit</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.PersonSearch"
                                     OnClick="@(() => RecognisePayments(member))">Recognise their payments</MudMenuItem>
                        @if (member.LinkedUsername is { } linkedAs)
                        {
                            <MudMenuItem Icon="@Icons.Material.Outlined.LinkOff"
                                         OnClick="@(() => LinkAsync(member, null))">@($"Not @{linkedAs} any more")</MudMenuItem>
                        }
                        else
                        {
                            @foreach (UserLink person in LinkablePeople)
                            {
                                <MudMenuItem Icon="@Icons.Material.Outlined.Link"
                                             OnClick="@(() => LinkAsync(member, person))">@($"This is {person.Name}")</MudMenuItem>
                            }
                        }
                        <MudMenuItem Icon="@Icons.Material.Outlined.Delete"
                                     OnClick="@(() => DeleteAsync(member))">Delete</MudMenuItem>
                    </MudMenu>
                </div>
            }
        </div>
    }
</Section>

@code {

    /// <summary>
    /// The household, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public List<HouseholdMember>? Members { get; set; }

    /// <summary>
    /// The people the user is linked with, whom a member can be marked as.
    /// </summary>
    [PersistentState]
    public List<UserLink>? People { get; set; }

    /// <summary>
    /// Those not already a member, so each person is at most one.
    /// </summary>
    private IEnumerable<UserLink> LinkablePeople => (People ?? [])
        .Where(x => !(Members ?? []).Exists(m => m.LinkedUsername == x.Username));

    private string Subtitle
    {
        get
        {
            if (Members is null or { Count: 0 })
            {
                return "The people you share money with";
            }

            return $"{PeopleText(Members.Count)} · {CombinedIncomeText}";
        }
    }

    private static string PeopleText(int count) => count == 1 ? "1 person" : $"{count} people";

    /// <summary>
    /// What the household earns together, a year and a month.
    /// </summary>
    private string CombinedIncomeText
    {
        get
        {
            decimal yearly = Members?.Sum(static x => x.YearlyIncome ?? 0) ?? 0;
            return $"{CurrencyFormatter.Format(yearly)} a year combined, " +
                   $"{CurrencyFormatter.Format(HouseholdIncomeInRange.Monthly(yearly))} a month";
        }
    }

    /// <summary>
    /// A yearly income, as shown beside it, with what it is a month.
    /// </summary>
    internal static string MonthlyText(decimal yearly) =>
        $"a year · {CurrencyFormatter.Format(HouseholdIncomeInRange.Monthly(yearly))} a month";

    /// <summary>
    /// Whether money to or from <paramref name="member"/> is recognised, labelling the income shown beside it.
    /// </summary>
    internal static string RecognitionSummary(HouseholdMember member)
    {
        List<string> parts = [];
        if (member.PayeeNames.Count > 0)
        {
            parts.Add(member.PayeeNames.Count == 1 ? "1 name" : $"{member.PayeeNames.Count} names");
        }

        if (member.LinkedAccounts.Count > 0)
        {
            parts.Add(member.LinkedAccounts.Count == 1 ? "1 account" : $"{member.LinkedAccounts.Count} accounts");
        }

        return parts.Count == 0
            ? "Income · payments not recognised"
            : $"Income · payments recognised by {string.Join(" and ", parts)}";
    }

    private static string Initials(HouseholdMember member) =>
        $"{member.FirstName.FirstOrDefault()}{member.LastName.FirstOrDefault()}".ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Members = await LoadOnceAsync(Members, "Loading your household", cancellationToken =>
            HouseholdMemberService.GetHouseholdMembersAsync(cancellationToken).ToListAsync(cancellationToken).AsTask());
        People = await LoadOnceAsync(People, "Loading your household", cancellationToken =>
            SharingService.GetLinksAsync(cancellationToken)
                .Where(static x => x.State == LinkState.Linked)
                .ToListAsync(cancellationToken).AsTask());
    }

    /// <summary>
    /// Marks <paramref name="member"/> as <paramref name="person"/>, taking their name, or as no one when null.
    /// </summary>
    internal async Task LinkAsync(HouseholdMember member, UserLink? person)
    {
        try
        {
            SetLoadingState(true, $"Updating {member.FirstName}…");
            HouseholdMember saved = await HouseholdMemberService.LinkHouseholdMemberAsync(member.Id,
                new LinkHouseholdMember { LinkId = person?.Id }, _cts.Token);
            Members![Members.IndexOf(member)] = saved;
            Snackbar.Add(person is null
                ? $"{saved.FirstName} is no longer marked as someone you share with"
                : $"{saved.FirstName} {saved.LastName} is {person.Name}", Severity.Success);
        }
        catch (NameTakenException)
        {
            Snackbar.Add("Another household member already has their name, rename or delete it first",
                Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't save that, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    private async Task AddHouseholdMember()
    {
        var dialogRef = await DialogService.ShowAsync<AddHouseholdMemberDialog>();
        var dialogActionResult = await dialogRef.Result;

        if (dialogActionResult is null || dialogActionResult.Canceled)
            return;

        try
        {
            SetLoadingState(true, "Making room at the table…");
            var householdMember = await HouseholdMemberService.AddHouseholdMemberAsync(
                (AddHouseholdMember)dialogActionResult.Data!, _cts.Token);
            (Members ??= []).Add(householdMember);
            Snackbar.Add($"{householdMember.FirstName} added", Severity.Success);
        }
        catch (NameTakenException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't add them, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    internal async Task EditAsync(HouseholdMember member)
    {
        DialogParameters<AddHouseholdMemberDialog> parameters = new() { { x => x.Member, member } };
        IDialogReference dialogRef = await DialogService.ShowAsync<AddHouseholdMemberDialog>(null, parameters);
        DialogResult? result = await dialogRef.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        AddHouseholdMember entered = (AddHouseholdMember)result.Data!;
        UpdateHouseholdMember update = new()
        {
            FirstName = entered.FirstName,
            LastName = entered.LastName,
            YearlyIncome = entered.YearlyIncome
        };

        try
        {
            SetLoadingState(true, $"Updating {member.FirstName}…");
            HouseholdMember saved = await HouseholdMemberService.UpdateHouseholdMemberAsync(member.Id, update,
                _cts.Token);
            Members![Members.IndexOf(member)] = saved;
            Snackbar.Add($"{saved.FirstName} updated", Severity.Success);
        }
        catch (NameTakenException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't save that, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    internal async Task DeleteAsync(HouseholdMember member)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync($"Delete {member.FirstName} {member.LastName}?",
            "Their income leaves your household income. Money to or from them is no longer recognised, so it counts " +
            "as income or spending again, or goes back to review.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            SetLoadingState(true, $"Removing {member.FirstName}…");
            await HouseholdMemberService.DeleteHouseholdMemberAsync(member.Id, _cts.Token);
            Members!.Remove(member);
            Snackbar.Add($"{member.FirstName} deleted", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't delete them, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    private async Task RecognisePayments(HouseholdMember member)
    {
        var dialogParameters = new DialogParameters<RecogniseHouseholdMemberDialog> { { x => x.Member, member } };
        var dialogRef = await DialogService.ShowAsync<RecogniseHouseholdMemberDialog>(null, dialogParameters);
        var dialogActionResult = await dialogRef.Result;

        if (dialogActionResult is null || dialogActionResult.Canceled)
            return;

        try
        {
            SetLoadingState(true, $"Looking for {member.FirstName}'s payments…");
            HouseholdMemberRecognitionSaved saved = await HouseholdMemberService.UpdateRecognitionAsync(member.Id,
                (UpdateHouseholdMemberRecognition)dialogActionResult.Data!, _cts.Token);

            Members![Members.IndexOf(member)] = saved.Member;
            Snackbar.Add(saved.RecognisedTransactions switch
            {
                0 => $"Saved, none of your payments are {member.FirstName}'s yet",
                1 => $"Saved, 1 payment is {member.FirstName}'s and no longer counts as income or spending",
                var count => $"Saved, {count} payments are {member.FirstName}'s and no longer count as income or spending"
            }, Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't save that, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

}

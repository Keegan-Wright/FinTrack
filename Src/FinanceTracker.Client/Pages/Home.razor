@page "/"
@* The dashboard in/out KPIs, cash flow, top spending, accounts, upcoming payments and budgets, for a chosen
   date range. *@
@using System.Collections.Immutable
@using System.Globalization
@using FinanceTracker.Client.Components.Dashboard
@using FinanceTracker.Contracts.Auth
@using FinanceTracker.Contracts.Account
@using FinanceTracker.Contracts.Budget
@using FinanceTracker.Contracts.Dashboard
@using FinanceTracker.Contracts.HouseholdMember
@using FinanceTracker.Contracts.Transactions
@using Microsoft.AspNetCore.Authorization
@using AccountAndTransactions = FinanceTracker.Contracts.Account.AccountAndTransactions
@inherits PageComponent

@attribute [Authorize]
@inject IDashboardService DashboardService
@inject IAccountService AccountService
@inject ITransactionsService TransactionsService
@inject IBudgetCategoriesService BudgetCategoriesService
@inject IHouseholdMemberService HouseholdMemberService
@inject TimeProvider TimeProvider

<PageTitle>Dashboard</PageTitle>
<PageHeader Title="@GetGreeting()" Subtitle="@GetRangeLabel()">
    <Actions>
        <MudToggleGroup T="DashboardRangePreset" Value="@View.Preset" ValueChanged="@SetRangePresetAsync"
                        Size="Size.Small" Color="Color.Primary">
            <MudToggleItem Value="DashboardRangePreset.ThisMonth" Text="This month"/>
            <MudToggleItem Value="DashboardRangePreset.Last30Days" Text="Last 30 days"/>
            <MudToggleItem Value="DashboardRangePreset.ThisYear" Text="This year"/>
        </MudToggleGroup>
    </Actions>
</PageHeader>
<MudGrid Spacing="4">
    <MudItem xs="12">
        <DashboardKpis Spent="@View.Spent" TrendIn="@View.TrendIn" TrendOut="@View.TrendOut" Net="@View.Net"
                       TransactionCount="@View.Transactions.Count" TotalBalance="@View.TotalBalance"
                       HouseholdIncome="@View.HouseholdIncome"/>
    </MudItem>
    <MudItem xs="12" lg="8">
        <CashflowChart Transactions="@View.Transactions" FromDate="@View.FromDate" ToDate="@View.ToDate" Note="@View.ChartNote"/>
    </MudItem>
    <MudItem xs="12" lg="4">
        <TopCategories Transactions="@View.Transactions"/>
    </MudItem>
    <MudItem xs="12" md="6">
        <AccountsSnapshot Accounts="@View.Accounts"/>
    </MudItem>
    <MudItem xs="12" md="6">
        <UpcomingPayments Payments="@View.UpcomingPayments"/>
    </MudItem>
    <MudItem xs="12">
        <GoalsAndBudgets BudgetCategories="@View.BudgetCategories"/>
    </MudItem>
</MudGrid>

@code {

    private const int MaxTransactionsForCharts = 5000;

    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    /// <summary>
    /// The dashboard for the chosen range, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public DashboardData? Data { get; set; }

    private DashboardData View => Data ?? DashboardData.Empty;

    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var authState = await AuthenticationStateTask;
        _userName = authState.User.Claims.FirstOrDefault(x => x.Type == CustomClaims.FirstName)?.Value ?? authState.User.Identity!.Name;
        Data = await LoadOnceAsync(Data, "Loading your dashboard",
            cancellationToken => LoadDashboardAsync(DashboardRangePreset.ThisMonth, cancellationToken));
    }

    private async Task SetRangePresetAsync(DashboardRangePreset preset)
    {
        if (View.Preset == preset)
            return;

        SetLoadingState(true, "Loading your dashboard");
        try
        {
            Data = await LoadDashboardAsync(preset, _cts.Token);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    private (DateTime From, DateTime To) GetPresetRange(DashboardRangePreset preset)
    {
        var now = TimeProvider.GetLocalNow().DateTime;

        DateTime from = preset switch
        {
            DashboardRangePreset.ThisMonth => new DateTime(now.Year, now.Month, 1),
            DashboardRangePreset.ThisYear => new DateTime(now.Year, 1, 1),
            DashboardRangePreset.Last30Days => now.AddDays(-30),
            _ => new DateTime(now.Year, now.Month, 1)
        };

        return (from, now);
    }

    private async Task<DashboardData> LoadDashboardAsync(DashboardRangePreset preset, CancellationToken cancellationToken)
    {
        (DateTime fromDate, DateTime toDate) = GetPresetRange(preset);

        var spent = await DashboardService.GetSpentInTimePeriod(fromDate, toDate, cancellationToken);

        var periodDays = (toDate.Date - fromDate.Date).Days + 1;
        var previous = await DashboardService.GetSpentInTimePeriod(fromDate.AddDays(-periodDays), fromDate, cancellationToken);

        var upcomingPayments = await DashboardService.GetUpcomingPaymentsAsync(8, cancellationToken).ToListAsync(cancellationToken);
        var accounts = await AccountService.GetAccountsAndMostRecentTransactionsAsync(1, cancellationToken).ToListAsync(cancellationToken);
        var budgetCategories = await BudgetCategoriesService.GetBudgetItemsAsync(cancellationToken).ToListAsync(cancellationToken);

        decimal householdIncome = 0;
        await foreach (var member in HouseholdMemberService.GetHouseholdMembersAsync(cancellationToken))
        {
            householdIncome += member.Income ?? 0m;
        }

        (List<Transaction> transactions, string? chartNote) = await LoadChartTransactionsAsync(fromDate, toDate, cancellationToken);

        return new DashboardData
        {
            Preset = preset,
            FromDate = fromDate,
            ToDate = toDate,
            Spent = spent,
            TrendIn = CalculateTrendPercentage(spent.TotalIn, previous.TotalIn),
            TrendOut = CalculateTrendPercentage(Math.Abs(spent.TotalOut), Math.Abs(previous.TotalOut)),
            TotalBalance = accounts.Sum(x => x.AccountBalance),
            HouseholdIncome = householdIncome,
            Transactions = transactions,
            ChartNote = chartNote,
            UpcomingPayments = upcomingPayments,
            Accounts = accounts,
            BudgetCategories = budgetCategories
        };
    }

    private async Task<(List<Transaction> Transactions, string? ChartNote)> LoadChartTransactionsAsync(
        DateTime fromDate, DateTime toDate, CancellationToken cancellationToken)
    {
        var request = new FilterTransactions
        {
            FromDate = fromDate.ToUniversalTime(),
            ToDate = toDate.ToUniversalTime(),
            AccountIds = ImmutableList<Guid>.Empty,
            ProviderIds = ImmutableList<Guid>.Empty,
            Categories = ImmutableList<string>.Empty,
            Types = ImmutableList<string>.Empty,
            Tags = ImmutableList<string>.Empty
        };

        var transactions = new List<Transaction>(512);
        await foreach (var tx in TransactionsService.GetAllTransactionsAsync(request, cancellationToken))
        {
            transactions.Add(tx);
            if (transactions.Count >= MaxTransactionsForCharts)
            {
                return (transactions, $"Charting limited to the first {MaxTransactionsForCharts:n0} transactions in the selected range.");
            }
        }

        return (transactions, null);
    }

    private static decimal? CalculateTrendPercentage(decimal current, decimal previous)
    {
        if (previous == 0)
            return null;

        return (current - previous) / Math.Abs(previous);
    }

    private string GetRangeLabel()
    {
        if (View.FromDate == default)
            return "Here's what's happening across your finances";

        var culture = CultureInfo.CurrentCulture;
        var from = View.FromDate.ToString(View.FromDate.Year == View.ToDate.Year ? "d MMM" : "d MMM yyyy", culture);
        return $"{from} – {View.ToDate.ToString("d MMM yyyy", culture)}";
    }

    private string GetGreeting()
    {
        var hour = TimeProvider.GetLocalNow().Hour;
        if (hour < 12) return $"Good morning {_userName}";
        if (hour < 18) return $"Good afternoon {_userName}";
        return $"Good evening {_userName}";
    }

}

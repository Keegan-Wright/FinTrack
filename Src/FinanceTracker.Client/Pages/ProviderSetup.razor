@page "/ProviderSetup"
@* Connects banks in three steps pick providers, consent on the provider's page, then paste back the access code
   (IOpenBankingService). *@
@using FinanceTracker.Contracts.OpenBanking
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent

@attribute [Authorize]

@inject ISnackbar Snackbar
@inject IOpenBankingService OpenBankingService

<PageTitle>Bank connections</PageTitle>
<PageHeader Title="Connect a bank" Subtitle="Three steps, and your accounts appear after the next sync"/>

<MudGrid Spacing="4">
    <MudItem xs="12" lg="7">
        <Section Title="1. Choose your banks"
                 Caption="@(_selected.Count == 0 ? "Pick one or more" : $"{_selected.Count} chosen")" Class="h-100">
            <Actions>
                <SearchField @bind-Value="_searchString" Placeholder="Search banks"/>
            </Actions>
            <ChildContent>
                @{
                    var shown = (OpenBankingProviders ?? []).Where(QuickFilter).OrderBy(static x => x.DisplayName).ToList();
                }
                @if (shown.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No banks match that search.</MudText>
                }
                <div class="ft-list ft-list--scroll">
                    @foreach (var provider in shown)
                    {
                        var selected = _selected.Contains(provider);
                        <div class="@($"ft-list__row ft-list__row--link {(selected ? "ft-list__row--selected" : string.Empty)}")"
                             role="checkbox" tabindex="0" aria-checked="@(selected ? "true" : "false")"
                             @onclick="@(() => ToggleAsync(provider))"
                             @onkeyup="@(e => OnProviderKeyUp(e, provider))">
                            <AccountLogo Src="@provider.LogoUrl"/>
                            <div class="ft-list__main">
                                <MudText Typo="Typo.body2" Class="text-truncate">@provider.DisplayName</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@provider.Country.ToUpperInvariant()</MudText>
                            </div>
                            <MudIcon Icon="@(selected ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)"
                                     Color="@(selected ? Color.Primary : Color.Default)"/>
                        </div>
                    }
                </div>
            </ChildContent>
        </Section>
    </MudItem>
    <MudItem xs="12" lg="5">
        <div class="ft-stack h-100">
            <Section Title="2. Give consent" Caption="Your bank opens in a new tab, approve access there">
                <MudButton Href="@(string.IsNullOrEmpty(_openBankingAuthUrl) ? null : _openBankingAuthUrl)"
                           Target="_blank" Variant="Variant.Outlined" Color="Color.Primary"
                           EndIcon="@Icons.Material.Outlined.OpenInNew"
                           Disabled="@string.IsNullOrEmpty(_openBankingAuthUrl)">
                    Open my bank
                </MudButton>
                @if (_selected.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">Choose a bank first.</MudText>
                }
            </Section>
            <Section Title="3. Paste your access code" Caption="Your bank shows it once you've approved access">
                <div class="ft-code-row">
                    <MudTextField T="string" @bind-Value="_vendorAccessToken" Placeholder="Access code"
                                  Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Disabled="@string.IsNullOrEmpty(_openBankingAuthUrl)"/>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@AddProviderAsync"
                               Disabled="@string.IsNullOrWhiteSpace(_vendorAccessToken)">Connect</MudButton>
                </div>
            </Section>
        </div>
    </MudItem>
</MudGrid>

@code {

    /// <summary>
    /// The banks that can be connected, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public List<OpenBankingProvider>? OpenBankingProviders { get; set; }

    private readonly HashSet<OpenBankingProvider> _selected = [];
    private string _searchString = string.Empty;
    private string _openBankingAuthUrl = string.Empty;
    private string _vendorAccessToken = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        OpenBankingProviders = await LoadOnceAsync(OpenBankingProviders, "Loading Providers", cancellationToken =>
            OpenBankingService.GetOpenBankingProvidersForClientAsync(cancellationToken)
                .ToListAsync(cancellationToken).AsTask());
    }

    private Func<OpenBankingProvider, bool> QuickFilter =>
        x => string.IsNullOrWhiteSpace(_searchString) || x.DisplayName.Contains(_searchString, StringComparison.OrdinalIgnoreCase);

    private async Task ToggleAsync(OpenBankingProvider provider)
    {
        if (!_selected.Remove(provider))
            _selected.Add(provider);

        // The consent link covers every chosen bank, so it changes with the choice
        if (_selected.Count == 0)
        {
            _openBankingAuthUrl = string.Empty;
            return;
        }

        var requestModel = new ProviderSetupUrl
        {
            ProviderIds = _selected.Select(x => x.ProviderId).ToList(),
            Scopes = _selected.SelectMany(x => x.Scopes).Distinct().ToList()
        };

        _openBankingAuthUrl = await OpenBankingService.BuildAuthUrlAsync(requestModel, _cts.Token);
    }

    private async Task OnProviderKeyUp(KeyboardEventArgs e, OpenBankingProvider provider)
    {
        if (e.Key is "Enter" or " ")
            await ToggleAsync(provider);
    }

    async Task AddProviderAsync()
    {
        SetLoadingState(true, "Shaking hands with your bank…");

        var requestModel = new AddVendor
        {
            AccessCode = _vendorAccessToken
        };

        var response = await OpenBankingService.AddVendorViaAccessCodeAsync(requestModel ,_cts.Token);

        SetLoadingState(false);
        if (response)
        {
            _vendorAccessToken = string.Empty;
            Snackbar.Add("Bank connected, your accounts will appear after the next sync", Severity.Success);
        }
        else
        {
            Snackbar.Add("That code didn't work, try giving consent again", Severity.Error);
        }
    }

}

@page "/ProviderSetup"
@* The user's connected banks, with when each one's consent ends and a way to renew it, and connecting more in three
   steps: pick providers, consent on the provider's page, then paste back the access code (IOpenBankingService).
   Renewing is the same round trip from a renewal link, sharing the paste step. *@
@using System.Globalization
@using FinanceTracker.Contracts.OpenBanking
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent

@attribute [Authorize]

@inject ISnackbar Snackbar
@inject IOpenBankingService OpenBankingService

<PageTitle>FinTrack - Bank connections</PageTitle>
<PageHeader Title="Bank connections" Subtitle="Keep your banks syncing, or connect another in three steps"/>

<MudGrid Spacing="4">
    @if (Connections is { Count: > 0 })
    {
        <MudItem xs="12">
            <Section Title="Your banks" Caption="Banks ask you to renew access every 90 days">
                <div class="ft-list">
                    @foreach (BankConnectionSummary connection in Connections)
                    {
                        bool renewing = _renewing?.ConnectionId == connection.ConnectionId;
                        <div class="ft-list__row">
                            <AccountLogo Logo="@connection.Logo"/>
                            <div class="ft-list__main">
                                <MudText Typo="Typo.body2" Class="text-truncate">@connection.Name</MudText>
                                <MudText Typo="Typo.caption" Class="@ConsentClass(connection)">@ConsentText(connection)</MudText>
                            </div>
                            @if (renewing)
                            {
                                <MudButton Href="@_renewalUrl" Target="_blank" Variant="Variant.Filled"
                                           Color="Color.Primary" Size="Size.Small"
                                           EndIcon="@Icons.Material.Outlined.OpenInNew">
                                    Open my bank
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="@(NeedsRenewal(connection) ? Variant.Filled : Variant.Text)"
                                           Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => StartRenewalAsync(connection))">
                                    Renew
                                </MudButton>
                            }
                        </div>
                    }
                </div>
                @if (_renewing is not null)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                        Sign in to @_renewing.Name in the new tab, then paste the access code in step 3.
                    </MudText>
                }
            </Section>
        </MudItem>
    }
    <MudItem xs="12" lg="7">
        <Section Title="1. Choose your banks"
                 Caption="@(_selected.Count == 0 ? "Pick one or more" : $"{_selected.Count} chosen")" Class="h-100">
            <Actions>
                <SearchField @bind-Value="_searchString" Placeholder="Search banks"/>
            </Actions>
            <ChildContent>
                @{
                    var shown = (OpenBankingProviders ?? []).Where(QuickFilter).OrderBy(static x => x.DisplayName).ToList();
                }
                @if (shown.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No banks match that search.</MudText>
                }
                <div class="ft-list ft-list--scroll">
                    @foreach (var provider in shown)
                    {
                        var selected = _selected.Contains(provider);
                        <div class="@($"ft-list__row ft-list__row--link {(selected ? "ft-list__row--selected" : string.Empty)}")"
                             role="checkbox" tabindex="0" aria-checked="@(selected ? "true" : "false")"
                             @onclick="@(() => ToggleAsync(provider))"
                             @onkeyup="@(e => OnProviderKeyUp(e, provider))">
                            <AccountLogo Src="@provider.LogoUrl"/>
                            <div class="ft-list__main">
                                <MudText Typo="Typo.body2" Class="text-truncate">@provider.DisplayName</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@provider.Country.ToUpperInvariant()</MudText>
                            </div>
                            <MudIcon Icon="@(selected ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)"
                                     Color="@(selected ? Color.Primary : Color.Default)"/>
                        </div>
                    }
                </div>
            </ChildContent>
        </Section>
    </MudItem>
    <MudItem xs="12" lg="5">
        <div class="ft-stack h-100">
            <Section Title="2. Give consent" Caption="Your bank opens in a new tab, approve access there">
                <MudButton Href="@(string.IsNullOrEmpty(_openBankingAuthUrl) ? null : _openBankingAuthUrl)"
                           Target="_blank" Variant="Variant.Outlined" Color="Color.Primary"
                           EndIcon="@Icons.Material.Outlined.OpenInNew"
                           Disabled="@string.IsNullOrEmpty(_openBankingAuthUrl)">
                    Open my bank
                </MudButton>
                @if (_selected.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">Choose a bank first.</MudText>
                }
            </Section>
            <Section Title="3. Paste your access code" Caption="Your bank shows it once you've approved access">
                <div class="ft-code-row">
                    <MudTextField T="string" @bind-Value="_vendorAccessToken" Placeholder="Access code"
                                  Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Disabled="@(string.IsNullOrEmpty(_openBankingAuthUrl) && _renewing is null)"/>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@AddProviderAsync"
                               Disabled="@string.IsNullOrWhiteSpace(_vendorAccessToken)">Connect</MudButton>
                </div>
            </Section>
        </div>
    </MudItem>
</MudGrid>

@code {

    /// <summary>
    /// The banks that can be connected, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public List<OpenBankingProvider>? OpenBankingProviders { get; set; }

    /// <summary>
    /// The user's connected banks, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public List<BankConnectionSummary>? Connections { get; set; }

    private readonly HashSet<OpenBankingProvider> _selected = [];
    private string _searchString = string.Empty;
    private string _openBankingAuthUrl = string.Empty;
    private string _vendorAccessToken = string.Empty;

    /// <summary>
    /// The connection being renewed once its renewal link has been fetched.
    /// </summary>
    private BankConnectionSummary? _renewing;
    private string _renewalUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        OpenBankingProviders = await LoadOnceAsync(OpenBankingProviders, "Loading Providers", cancellationToken =>
            OpenBankingService.GetOpenBankingProvidersForClientAsync(cancellationToken)
                .ToListAsync(cancellationToken).AsTask());
        Connections = await LoadOnceAsync(Connections, "Loading your banks", cancellationToken =>
            OpenBankingService.GetConnectionsAsync(cancellationToken).ToListAsync(cancellationToken).AsTask());
    }

    private async Task StartRenewalAsync(BankConnectionSummary connection)
    {
        SetLoadingState(true, $"Asking {connection.Name} for a renewal link…");
        try
        {
            _renewalUrl = await OpenBankingService.GetRenewalUrlAsync(connection.ConnectionId, _cts.Token);
            _renewing = connection;
        }
        catch (HttpRequestException)
        {
            Snackbar.Add($"{connection.Name} can't be renewed from here, connect it again below", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    private async Task ReloadConnectionsAsync()
    {
        Connections = await OpenBankingService.GetConnectionsAsync(_cts.Token).ToListAsync(_cts.Token);
        RefreshConnectionsToRenew(Connections);
    }

    private static bool NeedsRenewal(BankConnectionSummary connection) =>
        connection.ConsentState != ConsentState.Active;

    internal static string ConsentText(BankConnectionSummary connection)
    {
        string date = connection.ConsentExpiresAt.ToLocalTime().ToString("d MMM yyyy", CultureInfo.CurrentCulture);
        return connection.ConsentState switch
        {
            ConsentState.Lapsed => $"Access ended {date}, renew to sync again",
            ConsentState.RenewSoon => $"Access ends {date}, renew to keep syncing",
            _ => $"Access until {date}"
        };
    }

    private static string ConsentClass(BankConnectionSummary connection) => connection.ConsentState switch
    {
        ConsentState.Lapsed => "mud-error-text",
        ConsentState.RenewSoon => "mud-warning-text",
        _ => "mud-text-secondary"
    };

    private Func<OpenBankingProvider, bool> QuickFilter =>
        x => string.IsNullOrWhiteSpace(_searchString) || x.DisplayName.Contains(_searchString, StringComparison.OrdinalIgnoreCase);

    private async Task ToggleAsync(OpenBankingProvider provider)
    {
        if (!_selected.Remove(provider))
            _selected.Add(provider);

        // The consent link covers every chosen bank, so it changes with the choice
        if (_selected.Count == 0)
        {
            _openBankingAuthUrl = string.Empty;
            return;
        }

        var requestModel = new ProviderSetupUrl
        {
            ProviderIds = _selected.Select(x => x.ProviderId).ToList(),
            Scopes = _selected.SelectMany(x => x.Scopes).Distinct().ToList()
        };

        _openBankingAuthUrl = await OpenBankingService.BuildAuthUrlAsync(requestModel, _cts.Token);
    }

    private async Task OnProviderKeyUp(KeyboardEventArgs e, OpenBankingProvider provider)
    {
        if (e.Key is "Enter" or " ")
            await ToggleAsync(provider);
    }

    async Task AddProviderAsync()
    {
        SetLoadingState(true, "Shaking hands with your bank…");

        var requestModel = new AddVendor
        {
            AccessCode = _vendorAccessToken
        };

        var response = await OpenBankingService.AddVendorViaAccessCodeAsync(requestModel ,_cts.Token);

        SetLoadingState(false);
        if (response)
        {
            _vendorAccessToken = string.Empty;
            ShowSyncing();
            if (_renewing is null)
            {
                Snackbar.Add("Bank connected, your accounts will appear after the next sync", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Access renewed for {_renewing.Name}", Severity.Success);
                _renewing = null;
                _renewalUrl = string.Empty;
            }

            await ReloadConnectionsAsync();
        }
        else
        {
            Snackbar.Add("That code didn't work, try giving consent again", Severity.Error);
        }
    }

}

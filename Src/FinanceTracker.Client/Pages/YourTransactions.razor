@page "/Transactions"
@* Every transaction, filterable, with custom classifications applied from here and whether each is a transfer decided. A grid on larger screens, a compact list with a details dialog on phones. Loads in the browser only, the list is too big to
   send twice. *@
@using System.Globalization
@using FinanceTracker.Client.Components.Dialogs
@using FinanceTracker.Client.Components.Rules
@using FinanceTracker.Client.Components.Transactions
@using FinanceTracker.Contracts.Classifications
@using FinanceTracker.Contracts.Transactions
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent


@attribute [Authorize]
@inject ITransactionsService TransactionsService
@inject IClassificationService ClassificationsService
@inject ITransfersService TransfersService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>FinTrack - Transactions</PageTitle>
<PageHeader Title="Transactions" Subtitle="@Subtitle">
    <TransactionFilters TransactionTagFilterItems="@Filters.Tags"
                        AccountFilterItems="@Filters.Accounts"
                        CategoryFilterItems="@Filters.Categories"
                        ProviderFilterItems="@Filters.Providers"
                        TransactionTypeFilterItems="@Filters.Types"
                        SearchTransactions="@SearchTransactionsAsync"/>
</PageHeader>

<LoadingFrame Loading="@_loading" Message="Fetching every last penny…" MinHeight="320" Cover="false">
    @if (!_loading)
    {
        @* A grid stacks every column into a tall card on a phone, so phones get a compact list instead *@
        <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
            <Section>
                <TransactionList Transactions="@_transactions" OnSelect="@ShowDetailsAsync"/>
            </Section>
        </MudHidden>

        <MudHidden Breakpoint="Breakpoint.Xs">
            <MudDataGrid T="Transaction" Items="_transactions"
                         SortMode="SortMode.Multiple"
                         Filterable="false"
                         Hideable="true"
                         Hover="true"
                         Dense="true"
                         Elevation="0"
                         Outlined="true"
                         RowsPerPage="50"
                         FixedHeader="true"
                         Class="ft-grid">
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No transactions match these filters.</MudText>
                </NoRecordsContent>
                <Columns>
                    <PropertyColumn Property="x => x.TransactionTime" Title="Date" Sortable="true">
                        <CellTemplate>
                            <span class="ft-money">
                                @context.Item.TransactionTime.ToLocalTime().ToString("d MMM yyyy", CultureInfo.CurrentCulture)
                            </span>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.Description" Title="Description" Sortable="true">
                        <CellTemplate>
                            <span>@context.Item.Description</span>
                            @if (context.Item.Pending)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                         Class="ml-2">Pending</MudChip>
                            }
                        </CellTemplate>
                    </PropertyColumn>
                    <TemplateColumn T="Transaction" Title="Counts as" Sortable="true" SortBy="@CountsAs">
                        <CellTemplate>
                            @if (context.Item.Transfer is { } transfer)
                            {
                                <TransferChip Transfer="@transfer"
                                              OnAction="@(action => DecideTransferAsync(context.Item, action))"/>
                            }
                            else
                            {
                                <span class="mud-text-secondary">@TransferText.CountsAs(context.Item)</span>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.AccountName" Title="Account" Sortable="true">
                        <CellTemplate>
                            <span class="mud-text-secondary">@context.Item.AccountName</span>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.TransactionCategory" Title="Category" Sortable="true">
                        <CellTemplate>
                            <span class="mud-text-secondary">@DisplayText.ToTitle(context.Item.TransactionCategory)</span>
                        </CellTemplate>
                    </PropertyColumn>
                    <TemplateColumn Title="Tags" Sortable="false">
                        <CellTemplate>
                            <div class="ft-chips">
                                @foreach (var tag in context.Item.Tags)
                                {
                                    @if (RuleText.TaggedBy(context.Item, tag) is { } ruleName)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                 Icon="@Icons.Material.Outlined.Rule"
                                                 title="@($"From your rule {ruleName}")">@tag</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@tag</MudChip>
                                    }
                                }
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.Amount" Title="Amount" Sortable="true"
                                    HeaderClass="ft-grid__amount" CellClass="ft-grid__amount">
                        <CellTemplate>
                            <MoneyText Value="@context.Item.Amount" Signed="true"/>
                        </CellTemplate>
                    </PropertyColumn>
                    <TemplateColumn Title="" Sortable="false" Hideable="false" CellClass="ft-grid__actions">
                        <CellTemplate>
                            @* One menu, so what rules add later joins it rather than another button per row *@
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                                     aria-label="@($"Actions for {context.Item.Description}")">
                                <MudMenuItem Icon="@Icons.Material.Outlined.Sell"
                                             OnClick="@(() => AddClassificationsAsync(context.Item))">Add tags</MudMenuItem>
                                @foreach (var action in TransferText.Actions(context.Item.Transfer))
                                {
                                    <MudMenuItem Icon="@TransferText.ActionIcon(action)"
                                                 OnClick="@(() => DecideTransferAsync(context.Item, action))">
                                        @TransferText.ActionLabel(action)
                                    </MudMenuItem>
                                }
                                <MudMenuItem Icon="@Icons.Material.Outlined.Rule"
                                             OnClick="@(() => CreateRuleFrom(context.Item))">
                                    Create rule from this
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Outlined.Info"
                                             OnClick="@(() => ShowDetailsAsync(context.Item))">
                                    Details and bank classifications
                                </MudMenuItem>
                            </MudMenu>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="Transaction"/>
                </PagerContent>
            </MudDataGrid>
        </MudHidden>
    }
</LoadingFrame>

@code {

    /// <summary>
    /// The filter bar's options, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public TransactionFilterOptions? FilterOptions { get; set; }

    private readonly List<Transaction> _transactions = [];
    private bool _loading = true;
    private bool _loaded;

    private TransactionFilterOptions Filters => FilterOptions ?? TransactionFilterOptions.None;

    private string Subtitle => _loading
        ? "Everything in and out of your accounts"
        : $"{_transactions.Count:n0} {(_transactions.Count == 1 ? "transaction" : "transactions")}";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        FilterOptions = await LoadOnceAsync(FilterOptions, "Loading filters",
            cancellationToken => TransactionFilterOptions.LoadAsync(TransactionsService, cancellationToken));
    }

    protected override async Task OnParametersSetAsync()
    {
        // The prerender shows the spinner, the browser loads the list once it's interactive
        if (RendererInfo.IsInteractive && !_loaded)
        {
            _loaded = true;
            await SearchTransactionsAsync(ActiveTransactionFilters.None);
        }
    }

    private async Task SearchTransactionsAsync(ActiveTransactionFilters filters)
    {
        _loading = true;
        StateHasChanged();
        _transactions.Clear();

        await foreach (var transaction in TransactionsService.GetAllTransactionsAsync(filters.ToRequest(), _cts.Token))
        {
            _transactions.Add(transaction);
        }

        _loading = false;
    }

    private static object CountsAs(Transaction transaction) => TransferText.CountsAs(transaction);

    private async Task ShowDetailsAsync(Transaction transaction)
    {
        var dialogParameters = new DialogParameters<TransactionDetailsDialog>
        {
            { x => x.Transaction, transaction },
            { x => x.OnAddTags, EventCallback.Factory.Create(this, () => AddClassificationsAsync(transaction)) },
            { x => x.OnCreateRule, EventCallback.Factory.Create(this, () => CreateRuleFrom(transaction)) },
            {
                x => x.OnHideClassification,
                classification => ChangeBankClassificationAsync(transaction, classification, hide: true)
            },
            {
                x => x.OnShowClassification,
                classification => ChangeBankClassificationAsync(transaction, classification, hide: false)
            },
            {
                x => x.OnTransferAction,
                EventCallback.Factory.Create<TransferAction>(this, action => DecideTransferAsync(transaction, action))
            }
        };

        // The provider's defaults give it the close button
        await DialogService.ShowAsync<TransactionDetailsDialog>(null, dialogParameters);
    }

    private async Task DecideTransferAsync(Transaction transaction, TransferAction action)
    {
        try
        {
            SetLoadingState(true, "Updating transfers");
            var id = transaction.TransactionId;
            IReadOnlyList<Transaction> changed = action switch
            {
                TransferAction.MarkAsTransfer => await TransfersService.MarkAsTransferAsync(id, _cts.Token),
                TransferAction.NotATransfer => await TransfersService.MarkNotATransferAsync(id, _cts.Token),
                _ => await TransfersService.ResetTransferAsync(id, _cts.Token)
            };

            // The decision can change the other half too, swap in each that's listed
            foreach (var updated in changed)
            {
                var index = _transactions.FindIndex(x => x.TransactionId == updated.TransactionId);
                if (index >= 0)
                {
                    _transactions[index] = updated;
                }
            }

            await RefreshTransfersToReviewAsync(TransfersService);

            Snackbar.Add(action switch
            {
                TransferAction.MarkAsTransfer => "Marked as a transfer, it no longer counts as income or spending",
                TransferAction.NotATransfer => "It counts as income or spending now",
                _ => "FinTrack will decide this one"
            }, Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't update that, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    /// <summary>
    /// Hides or shows one of the bank's classifications on <paramref name="transaction"/>, swapping in how it is now.
    /// </summary>
    /// <returns>The transaction as it is now, null when it couldn't be changed.</returns>
    private async Task<Transaction?> ChangeBankClassificationAsync(Transaction transaction, string classification,
        bool hide)
    {
        ChangeBankClassification request = new() { Classification = classification };
        try
        {
            Transaction updated;
            if (hide)
            {
                updated = await TransactionsService.HideBankClassificationAsync(transaction.TransactionId, request,
                    _cts.Token);
            }
            else
            {
                updated = await TransactionsService.ShowBankClassificationAsync(transaction.TransactionId, request,
                    _cts.Token);
            }

            int index = _transactions.FindIndex(x => x.TransactionId == updated.TransactionId);
            if (index >= 0)
            {
                _transactions[index] = updated;
            }

            StateHasChanged();
            return updated;
        }
        catch (Exception)
        {
            Snackbar.Add($"Couldn't {(hide ? "hide" : "show")} {classification}, try again", Severity.Error);
            return null;
        }
    }

    private void CreateRuleFrom(Transaction transaction) =>
        NavigationManager.NavigateTo($"Rules/new?from={transaction.TransactionId}");

    private async Task AddClassificationsAsync(Transaction transaction)
    {
        var classifications = new List<Classification>();
        await foreach (var classification in ClassificationsService.GetAllCustomClassificationsAsync(_cts.Token))
        {
            classifications.Add(classification);
        }

        if (classifications.Count == 0)
        {
            Snackbar.Add("You haven't made any tags yet, add some on the Tags page first", Severity.Info);
            return;
        }

        var dialogParameters = new DialogParameters<AddClassificationsToTransactionDialog>
        {
            { x => x.TransactionId, transaction.TransactionId },
            { x => x.Classifications, classifications }
        };

        var dialogRef = await DialogService.ShowAsync<AddClassificationsToTransactionDialog>(null, dialogParameters);
        var dialogActionResult = await dialogRef.Result;

        if (dialogActionResult is null || dialogActionResult.Canceled)
            return;

        try
        {
            SetLoadingState(true, "Adding tags");
            var classificationsToAdd = (AddCustomClassificationsToTransaction)dialogActionResult.Data!;
            await ClassificationsService.AddCustomClassificationsToTransactionAsync(classificationsToAdd, _cts.Token);

            var added = classificationsToAdd.Classifications.Select(static c => c.ClassificationId).ToHashSet();
            transaction.Tags = transaction.Tags
                .Concat(classifications.Where(x => added.Contains(x.ClassificationId)).Select(static x => x.Tag!))
                .Distinct()
                .ToList();
            Snackbar.Add("Tags added", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't add those tags, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

}

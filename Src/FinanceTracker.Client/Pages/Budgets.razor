@page "/Budgets"
@* Monthly limits on what the user's tags cover, month by month (IBudgetsService). A month runs from pay to pay once
   the user's pay is picked up (IPayPeriodsService), otherwise it's the calendar month. The current month shows the
   pace and can be changed, earlier months are as they were. *@
@using FinanceTracker.Client.Components.Budgets
@using FinanceTracker.Client.Components.PayPeriods
@using FinanceTracker.Contracts.Budgets
@using FinanceTracker.Contracts.Classifications
@using FinanceTracker.Contracts.PayPeriods
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent

@attribute [Authorize]
@inject IBudgetsService BudgetsService
@inject IPayPeriodsService PayPeriodsService
@inject IClassificationService ClassificationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject TimeProvider TimeProvider

<PageTitle>FinTrack - Budgets</PageTitle>
<PageHeader Title="Budgets" Subtitle="What you plan to spend each month, and how it's going">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="@AddAsync">New budget</MudButton>
    </Actions>
</PageHeader>

<div class="ft-stack">
    @if (Pay is not null)
    {
        <YourPayLine Pay="@Pay" OnChooseIncome="@ChooseIncomeAsync" OnUsePayPeriods="@UsePayPeriodsAsync"/>
    }

    <Section>
        <TitleContent>
            <MonthPicker Month="@Month" Latest="@CurrentMonth" MonthChanged="@ShowMonthAsync"/>
        </TitleContent>
        <Actions>
            @if (PeriodCaption is { } caption)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@caption</MudText>
            }
        </Actions>
        <ChildContent>
            @if (Overview is null or { Budgets.Count: 0 })
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@EmptyText</MudText>
            }
            else
            {
                <div class="ft-budget-list">
                    @foreach (BudgetStatus status in Overview.Budgets)
                    {
                        <BudgetRow @key="status.BudgetId" Status="@status" ShowPace="@Overview.IsCurrent"
                                   Editable="@Overview.IsCurrent" OnEdit="@(() => EditAsync(status.BudgetId))"
                                   OnDelete="@(() => DeleteAsync(status))"/>
                    }
                </div>
            }
        </ChildContent>
    </Section>

    @if (Overview is not null)
    {
        <Section Title="Unbudgeted"
                 Caption="Money out that none of your budgets cover, less card refunds, so nothing goes unseen">
            <div class="ft-list__line">
                <MudText Typo="Typo.body2">
                    @(Overview.Unbudgeted > 0 ? "Spent with no budget" : "Everything you spent is in a budget")
                </MudText>
                <MoneyText Value="@Overview.Unbudgeted"/>
            </div>
            @if (Overview.Unbudgeted > 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Tag it with a <MudLink Href="Rules" Typo="Typo.caption">rule</MudLink> and add the tag to a budget
                    to track it.
                </MudText>
            }
        </Section>
    }
</div>

@code {

    /// <summary>
    /// The month shown, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public BudgetMonthOverview? Overview { get; set; }

    /// <summary>
    /// The user's budgets, to edit.
    /// </summary>
    [PersistentState]
    public List<Budget>? BudgetList { get; set; }

    /// <summary>
    /// The user's tags, for the budget dialog.
    /// </summary>
    [PersistentState]
    public List<Classification>? Tags { get; set; }

    /// <summary>
    /// The user's pay, which their months run between.
    /// </summary>
    [PersistentState]
    public YourPay? Pay { get; set; }

    /// <summary>
    /// The month today's period is named after, which is the next calendar month once a late month pay is in.
    /// </summary>
    private DateOnly CurrentMonth
    {
        get
        {
            if (Pay is not null)
            {
                return Pay.CurrentPeriod.Month;
            }

            DateTime now = TimeProvider.GetLocalNow().DateTime;
            return new DateOnly(now.Year, now.Month, 1);
        }
    }

    private string? PeriodCaption => Overview is null
        ? null
        : PayText.MonthCaption(Pay, Overview.Start, Overview.End, !Overview.IsCurrent);

    private DateOnly Month => Overview?.Month ?? CurrentMonth;

    private IReadOnlyDictionary<Guid, string> TagNames =>
        (Tags ?? []).ToDictionary(static x => x.ClassificationId, static x => x.Tag ?? string.Empty);

    private string EmptyText => BudgetList is null or { Count: 0 }
        ? "No budgets yet. Make one for anything you want to keep to a limit, like £400 a month on groceries."
        : "None of your budgets had started by this month.";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Pay = await LoadOnceAsync(Pay, "Loading your budgets", PayPeriodsService.GetYourPayAsync);
        DateOnly month = CurrentMonth;
        Overview = await LoadOnceAsync(Overview, "Loading your budgets", cancellationToken =>
            BudgetsService.GetMonthAsync(month.Year, month.Month, cancellationToken));
        BudgetList = await LoadOnceAsync(BudgetList, "Loading your budgets", cancellationToken =>
            BudgetsService.GetBudgetsAsync(cancellationToken).ToListAsync(cancellationToken).AsTask());
        Tags = await LoadOnceAsync(Tags, "Loading your budgets", cancellationToken =>
            ClassificationService.GetAllCustomClassificationsAsync(cancellationToken)
                .ToListAsync(cancellationToken).AsTask());
    }

    /// <summary>
    /// The same month, with the spending the sync brought in.
    /// </summary>
    protected override async Task OnSyncedAsync()
    {
        // A sync can pick up the pay
        Pay = await PayPeriodsService.GetYourPayAsync(_cts.Token);
        DateOnly month = Month;
        BudgetMonthOverview overview = await BudgetsService.GetMonthAsync(month.Year, month.Month, _cts.Token);

        // The user moved to another month meanwhile, which loads that month itself
        if (Month == month)
        {
            Overview = overview;
        }
    }

    internal async Task ShowMonthAsync(DateOnly month)
    {
        try
        {
            SetLoadingState(true, $"Loading {BudgetText.Month(month)}");
            Overview = await BudgetsService.GetMonthAsync(month.Year, month.Month, _cts.Token);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't load that month, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    private async Task ChooseIncomeAsync()
    {
        List<Income> incomes;
        try
        {
            incomes = await PayPeriodsService.GetIncomesAsync(_cts.Token).ToListAsync(_cts.Token);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't load your incomes, try again", Severity.Error);
            return;
        }

        DialogParameters<ChooseIncomeDialog> parameters = new()
        {
            { x => x.Incomes, incomes },
            { x => x.Current, Pay?.Pay }
        };

        IDialogReference dialog = await DialogService.ShowAsync<ChooseIncomeDialog>(null, parameters);
        DialogResult? result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        var income = (ChooseIncome)result.Data!;
        await ChangePayAsync("Your periods follow that pay now",
            () => PayPeriodsService.ChooseAsync(income, _cts.Token));
    }

    private Task UsePayPeriodsAsync(bool payPeriods)
    {
        if (payPeriods)
        {
            return ChangePayAsync("Your months run from pay to pay",
                () => PayPeriodsService.TurnOnAsync(_cts.Token));
        }

        return ChangePayAsync("Your months are calendar months",
            () => PayPeriodsService.TurnOffAsync(_cts.Token));
    }

    /// <summary>
    /// Makes the change, then shows the current month as it now runs, its dates and budgets moved with it.
    /// </summary>
    private async Task ChangePayAsync(string done, Func<Task<YourPay>> change)
    {
        try
        {
            SetLoadingState(true, "Saving…");
            Pay = await change();
            DateOnly month = CurrentMonth;
            Overview = await BudgetsService.GetMonthAsync(month.Year, month.Month, _cts.Token);
            Snackbar.Add(done, Severity.Success);
        }
        catch (InvalidOperationException)
        {
            Snackbar.Add("That income isn't coming in like pay any more, try another", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't save that, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    private async Task AddAsync()
    {
        SaveBudget? budget = await ShowDialogAsync(null);
        if (budget is null)
        {
            return;
        }

        await SaveAsync($"{budget.Name} added", () => BudgetsService.AddBudgetAsync(budget, _cts.Token));
    }

    private async Task EditAsync(Guid budgetId)
    {
        Budget? existing = BudgetList?.Find(x => x.Id == budgetId);
        if (existing is null)
        {
            return;
        }

        SaveBudget? budget = await ShowDialogAsync(existing);
        if (budget is null)
        {
            return;
        }

        await SaveAsync($"{budget.Name} saved",
            () => BudgetsService.UpdateBudgetAsync(budgetId, budget, _cts.Token));
    }

    private async Task DeleteAsync(BudgetStatus status)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync($"Delete {status.Name}?",
            "Its transactions keep their tags, only the limit goes.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await SaveAsync($"{status.Name} deleted",
            () => BudgetsService.DeleteBudgetAsync(status.BudgetId, _cts.Token));
    }

    /// <returns>What the user entered, null when they cancelled.</returns>
    private async Task<SaveBudget?> ShowDialogAsync(Budget? budget)
    {
        DialogParameters<BudgetDialog> parameters = new()
        {
            { x => x.Budget, budget },
            { x => x.TagNames, TagNames }
        };

        IDialogReference dialog = await DialogService.ShowAsync<BudgetDialog>(null, parameters);
        DialogResult? result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return null;
        }

        return (SaveBudget)result.Data!;
    }

    /// <summary>
    /// Makes a change, then reloads the month and the budgets so the totals and limits are as saved.
    /// </summary>
    private async Task SaveAsync(string done, Func<Task> change)
    {
        try
        {
            SetLoadingState(true, "Saving…");
            await change();
            DateOnly month = Month;
            Overview = await BudgetsService.GetMonthAsync(month.Year, month.Month, _cts.Token);
            BudgetList = await BudgetsService.GetBudgetsAsync(_cts.Token).ToListAsync(_cts.Token);
            Snackbar.Add(done, Severity.Success);
        }
        catch (InvalidOperationException)
        {
            Snackbar.Add("A tag in this budget isn't yours any more, choose another", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't save that, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

}

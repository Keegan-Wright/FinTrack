@page "/Accounts"
@* Each connected account with its balance and newest transactions (IAccountService), grouped by bank. A bank's
   accounts can be closed, and stay closed while the user moves around the app. *@
@using FinanceTracker.Client.Components.Accounts
@using FinanceTracker.Contracts.Account
@using FinanceTracker.Contracts.NetWorth
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent

@attribute [Authorize]
@inject IAccountService AccountService
@inject INetWorthService NetWorthService
@inject TimeProvider TimeProvider

<PageTitle>FinTrack - Accounts</PageTitle>
<PageHeader Title="Accounts" Subtitle="@Subtitle">
    <Actions>
        <SharingViewSwitch/>
        <MudButton Href="ProviderSetup" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Add">Connect a bank</MudButton>
    </Actions>
</PageHeader>

@if (Accounts is { Count: 0 })
{
    <Section>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            No accounts yet. Connect a bank and they'll show up here after the first sync.
        </MudText>
    </Section>
}
else
{
    <div class="ft-stack">
        @foreach (ProviderGroup group in Groups)
        {
            <ProviderAccounts @key="group.Name" Name="@group.Name" Logo="@group.Logo" Accounts="@group.Accounts"
                              HistoryOf="@HistoryOf" Expanded="@IsExpanded(group.Name)"
                              ExpandedChanged="@(expanded => SetExpanded(group.Name, expanded))"/>
        }
    </div>
}

@code {

    /// <summary>
    /// The user's accounts, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public List<AccountAndTransactions>? Accounts { get; set; }

    private string Subtitle => Accounts is null or { Count: 0 }
        ? "Your connected accounts"
        : $"{Accounts.Count} {(Accounts.Count == 1 ? "account" : "accounts")} · " +
          $"{CurrencyFormatter.Format(Accounts.Sum(static x => x.AccountBalance))} in total";

    /// <summary>
    /// Each account's closing balances over the last 90 days, loaded once.
    /// </summary>
    [PersistentState]
    public List<AccountBalanceHistory>? Histories { get; set; }

    [CascadingParameter] private ApplicationState AppState { get; set; } = null!;

    private Dictionary<Guid, IReadOnlyList<BalancePoint>> _historyByAccount = [];

    /// <summary>
    /// The accounts by bank, the banks with the most in them first and each bank's accounts the same way.
    /// </summary>
    private List<ProviderGroup> Groups => (Accounts ?? [])
        .GroupBy(static x => x.ProviderName, StringComparer.Ordinal)
        .Select(static x => new ProviderGroup(x.Key, x.First().Logo,
            x.OrderByDescending(static y => y.AccountBalance).ToList()))
        .OrderByDescending(static x => x.Accounts.Sum(static y => y.AccountBalance))
        .ToList();

    private bool IsExpanded(string provider) => !AppState.CollapsedProviders.Contains(provider);

    private void SetExpanded(string provider, bool expanded)
    {
        if (expanded)
        {
            AppState.CollapsedProviders.Remove(provider);
            return;
        }

        AppState.CollapsedProviders.Add(provider);
    }
    private List<AccountBalanceHistory>? _historiesFrom;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Accounts = await LoadOnceAsync(Accounts, "Loading your accounts", LoadAccountsAsync);
        Histories = await LoadOnceAsync(Histories, "Loading your accounts", LoadHistoriesAsync);
    }

    /// <summary>
    /// The balances, latest transactions and charts again, with what the sync brought in.
    /// </summary>
    protected override async Task OnSyncedAsync()
    {
        Accounts = await LoadAccountsAsync(_cts.Token);
        Histories = await LoadHistoriesAsync(_cts.Token);
        IndexHistories();
    }

    private Task<List<AccountAndTransactions>> LoadAccountsAsync(CancellationToken cancellationToken) =>
        AccountService.GetAccountsAndMostRecentTransactionsAsync(5, cancellationToken)
            .ToListAsync(cancellationToken).AsTask();

    private Task<List<AccountBalanceHistory>> LoadHistoriesAsync(CancellationToken cancellationToken) =>
        NetWorthService.GetBalanceHistoriesAsync(
                DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime).AddDays(-90), cancellationToken)
            .ToListAsync(cancellationToken).AsTask();

    /// <summary>
    /// Looked up by account once per load, and the same lists kept so the charts only redraw when they change.
    /// </summary>
    protected override void OnParametersSet() => IndexHistories();

    private void IndexHistories()
    {
        if (Histories is null || ReferenceEquals(Histories, _historiesFrom))
        {
            return;
        }

        _historiesFrom = Histories;
        _historyByAccount = Histories.ToDictionary(static x => x.AccountId,
            static x => (IReadOnlyList<BalancePoint>)x.Points);
    }

    private IReadOnlyList<BalancePoint>? HistoryOf(AccountAndTransactions account) =>
        _historyByAccount.GetValueOrDefault(account.AccountId);

}

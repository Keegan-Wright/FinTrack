@page "/Accounts"
@* Each connected account with its balance and newest transactions (IAccountService). *@
@using System.Globalization
@using FinanceTracker.Contracts.Account
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent

@attribute [Authorize]
@inject IAccountService AccountService

<PageTitle>FinTrack - Accounts</PageTitle>
<PageHeader Title="Accounts" Subtitle="@Subtitle">
    <Actions>
        <MudButton Href="ProviderSetup" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Add">Connect a bank</MudButton>
    </Actions>
</PageHeader>

@if (Accounts is { Count: 0 })
{
    <Section>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            No accounts yet. Connect a bank and they'll show up here after the first sync.
        </MudText>
    </Section>
}
else
{
    <MudGrid Spacing="4">
        @foreach (var account in (Accounts ?? []).OrderByDescending(static x => x.AccountBalance))
        {
            <MudItem xs="12" md="6" xl="4">
                <Section Class="h-100">
                    <TitleContent>
                        <div class="ft-account-heading">
                            <AccountLogo Logo="@account.Logo"/>
                            <div class="ft-list__main">
                                <MudText Typo="Typo.subtitle1" Class="text-truncate">@account.AccountName</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @DisplayText.ToTitle(account.AccountType)
                                </MudText>
                            </div>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <div class="ft-balances">
                            <div>
                                <div class="ft-label">Balance</div>
                                <MoneyText Value="@account.AccountBalance" Typo="Typo.h5"/>
                            </div>
                            @if (account.AvailableBalance != account.AccountBalance)
                            {
                                <div>
                                    <div class="ft-label">Available</div>
                                    <MoneyText Value="@account.AvailableBalance" Typo="Typo.h6"
                                               Class="mud-text-secondary"/>
                                </div>
                            }
                        </div>

                        <div class="ft-label mt-4">Recent activity</div>
                        @if (account.Transactions is null || !account.Transactions.Any())
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Nothing yet.</MudText>
                        }
                        else
                        {
                            <div class="ft-list">
                                @foreach (var transaction in account.Transactions.OrderByDescending(static x => x.Time))
                                {
                                    <div class="ft-list__row">
                                        <div class="ft-list__main">
                                            <MudText Typo="Typo.body2" Class="text-truncate">@transaction.Description</MudText>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                @transaction.Time.ToLocalTime().ToString("d MMM", CultureInfo.CurrentCulture)
                                                · @DisplayText.ToTitle(transaction.Status)
                                            </MudText>
                                        </div>
                                        <div class="ft-list__end">
                                            <MoneyText Value="@transaction.Amount" Signed="true"/>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </ChildContent>
                </Section>
            </MudItem>
        }
    </MudGrid>
}

@code {

    /// <summary>
    /// The user's accounts, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public List<AccountAndTransactions>? Accounts { get; set; }

    private string Subtitle => Accounts is null or { Count: 0 }
        ? "Your connected accounts"
        : $"{Accounts.Count} {(Accounts.Count == 1 ? "account" : "accounts")} · " +
          $"{CurrencyFormatter.Format(Accounts.Sum(static x => x.AccountBalance))} in total";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Accounts = await LoadOnceAsync(Accounts, "Loading your accounts", cancellationToken =>
            AccountService.GetAccountsAndMostRecentTransactionsAsync(5, cancellationToken)
                .ToListAsync(cancellationToken).AsTask());
    }

}

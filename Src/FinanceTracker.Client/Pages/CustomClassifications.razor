@page "/Classifications"
@* Adds and removes the user's custom classifications, the tags they can put on transactions
   (IClassificationService). *@
@using FinanceTracker.Client.Components.Dialogs
@using FinanceTracker.Contracts
@using FinanceTracker.Contracts.Classifications
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent


@attribute [Authorize]
@inject IClassificationService ClassificationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>FinTrack - Tags</PageTitle>
<PageHeader Title="Tags" Subtitle="Your own labels for transactions, on top of the ones your bank sends">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="@AddClassification">New tag</MudButton>
    </Actions>
</PageHeader>

<Section Title="@($"{Classifications?.Count ?? 0} {(Classifications?.Count == 1 ? "tag" : "tags")}")"
         Caption="Add them to transactions from the Transactions page">
    <Actions>
        @if (Classifications is { Count: > 8 })
        {
            <SearchField @bind-Value="_classificationsSearchTerm" Placeholder="Search tags"/>
        }
    </Actions>
    <ChildContent>
        @if (Classifications is null or { Count: 0 })
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                No tags yet. Make one for anything you want to track, like "Holiday" or "Kids".
            </MudText>
        }
        else
        {
            var shown = Classifications.Where(ClassificationsQuickFilter).OrderBy(static x => x.Tag).ToList();
            if (shown.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">No tags match that search.</MudText>
            }
            <div class="ft-list">
                @foreach (var classification in shown)
                {
                    <div class="ft-list__row">
                        <MudIcon Icon="@Icons.Material.Outlined.Sell" Size="Size.Small" Class="mud-text-secondary"/>
                        <div class="ft-list__main">
                            <MudText Typo="Typo.body2" Class="text-truncate">@classification.Tag</MudText>
                        </div>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                                 AriaLabel="@($"Actions for {classification.Tag}")">
                            <MudMenuItem Icon="@Icons.Material.Outlined.Edit"
                                         OnClick="@(() => RenameAsync(classification))">Rename</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.Delete"
                                         OnClick="@(() => DeleteAsync(classification))">Delete</MudMenuItem>
                        </MudMenu>
                    </div>
                }
            </div>
        }
    </ChildContent>
</Section>

@code {

    /// <summary>
    /// The user's classifications, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public List<Classification>? Classifications { get; set; }

    private string? _classificationsSearchTerm;


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Classifications = await LoadOnceAsync(Classifications, "Loading classifications", cancellationToken =>
            ClassificationService.GetAllCustomClassificationsAsync(cancellationToken)
                .ToListAsync(cancellationToken).AsTask());
    }


    private Func<Classification, bool> ClassificationsQuickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_classificationsSearchTerm))
            return true;

        return x.Tag != null && x.Tag.Contains(_classificationsSearchTerm, StringComparison.OrdinalIgnoreCase);
    };

    private async Task AddClassification()
    {
        var dialogRef = await DialogService.ShowAsync<AddClassificationDialog>();
        var dialogActionResult = await dialogRef.Result;

        if (dialogActionResult is null || dialogActionResult.Canceled)
            return;

        try
        {
            SetLoadingState(true, "Printing a fresh label…");
            var classification = await ClassificationService.AddCustomClassificationAsync(
                (AddClassifications)dialogActionResult.Data!, _cts.Token);
            (Classifications ??= []).Add(classification);
            Snackbar.Add($"Tag \"{classification.Tag}\" added", Severity.Success);
        }
        catch (NameTakenException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't add that tag, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    internal async Task RenameAsync(Classification classification)
    {
        DialogParameters<AddClassificationDialog> parameters = new() { { x => x.Tag, classification.Tag } };
        IDialogReference dialogRef = await DialogService.ShowAsync<AddClassificationDialog>(null, parameters);
        DialogResult? result = await dialogRef.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        try
        {
            SetLoadingState(true, "Relabelling…");
            RenameClassification rename = new() { Tag = ((AddClassifications)result.Data!).Tag };
            Classification renamed = await ClassificationService.RenameCustomClassificationAsync(
                classification.ClassificationId, rename, _cts.Token);
            Classifications![Classifications.IndexOf(classification)] = renamed;
            Snackbar.Add($"Renamed to \"{renamed.Tag}\"", Severity.Success);
        }
        catch (NameTakenException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't rename that tag, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    internal async Task DeleteAsync(Classification classification)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync($"Delete {classification.Tag}?",
            "It comes off every transaction, and out of the rules, budgets and savings goals that use it. A rule left " +
            "with nothing to do is turned off.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            SetLoadingState(true, $"Deleting {classification.Tag}…");
            await ClassificationService.RemoveCustomClassificationAsync(classification.ClassificationId, _cts.Token);
            Classifications!.Remove(classification);
            Snackbar.Add($"Tag \"{classification.Tag}\" deleted", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't delete that tag, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

}

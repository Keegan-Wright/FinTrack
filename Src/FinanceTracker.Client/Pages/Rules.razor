@page "/Rules"
@* The user's rules in the order they run, to reorder, switch on and off, then those other people share with them. *@
@using FinanceTracker.Client.Components.Rules
@using FinanceTracker.Contracts.Bills
@using FinanceTracker.Contracts.Classifications
@using FinanceTracker.Contracts.Debts
@using FinanceTracker.Contracts.Rules
@using FinanceTracker.Contracts.Transactions
@using Microsoft.AspNetCore.Authorization
@inherits PageComponent

@attribute [Authorize]
@inject IRulesService RulesService
@inject ITransactionsService TransactionsService
@inject IClassificationService ClassificationService
@inject IBillsService BillsService
@inject IDebtsService DebtsService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>FinTrack - Rules</PageTitle>
<PageHeader Title="Rules" Subtitle="Tag transactions and decide transfers as they arrive">
    <Actions>
        <MudButton Href="Rules/new" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Add">New rule</MudButton>
    </Actions>
</PageHeader>

<Section Title="@SectionTitle" Caption="Run top to bottom on new transactions, drag or use each rule's menu to reorder">
    @if (RuleList is null or { Count: 0 })
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            No rules yet. Make one to tag what you buy as it syncs, like Shopping for anything from your supermarket.
        </MudText>
    }
    else if (OwnRules.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            None of your own yet. Make one to tag what you buy as it syncs.
        </MudText>
    }
    else
    {
        <RuleList Rules="@OwnRules" AccountNames="@AccountNames" TagNames="@TagNames" BillNames="@BillNames"
                  DebtNames="@DebtNames" OnReorder="@ReorderAsync" OnToggle="@ToggleAsync"
                  OnDelete="@DeleteAsync"/>
    }
</Section>

@if (SharedRules.Count > 0)
{
    <Section Title="Shared with you" Caption="Each runs on the accounts its owner can change, after their own rules">
        <SharedRuleList Rules="@SharedRules" AccountNames="@AccountNames" TagNames="@TagNames" BillNames="@BillNames"
                        DebtNames="@DebtNames" OnToggle="@ToggleAsync"/>
    </Section>
}

@code {

    /// <summary>
    /// The user's rules in the order they run, loaded once, see <see cref="PageComponent.LoadOnceAsync{T}"/>.
    /// </summary>
    [PersistentState]
    public List<Rule>? RuleList { get; set; }

    /// <summary>
    /// The user's accounts.
    /// </summary>
    [PersistentState]
    public List<TransactionAccountFilter>? Accounts { get; set; }

    /// <summary>
    /// The user's tags.
    /// </summary>
    [PersistentState]
    public List<Classification>? Tags { get; set; }

    /// <summary>
    /// The user's bills, for actions that pay one.
    /// </summary>
    [PersistentState]
    public List<Bill>? BillList { get; set; }

    /// <summary>
    /// The user's debts, for actions that pay one off.
    /// </summary>
    [PersistentState]
    public List<Debt>? DebtList { get; set; }

    private List<Rule> OwnRules => (RuleList ?? []).Where(static x => x.SharedBy is null).ToList();

    private List<Rule> SharedRules => (RuleList ?? []).Where(static x => x.SharedBy is not null).ToList();

    // Each with the names shared rules carry, for what's another person's
    private IReadOnlyDictionary<Guid, string> AccountNames =>
        WithSharedNames((Accounts ?? []).ToDictionary(static x => x.AccountId, static x => x.AccountName));

    private IReadOnlyDictionary<Guid, string> TagNames =>
        WithSharedNames((Tags ?? []).ToDictionary(static x => x.ClassificationId, static x => x.Tag ?? string.Empty));

    private IReadOnlyDictionary<Guid, string> BillNames =>
        WithSharedNames((BillList ?? []).ToDictionary(static x => x.Id, static x => x.Name));

    private IReadOnlyDictionary<Guid, string> DebtNames =>
        WithSharedNames((DebtList ?? []).ToDictionary(static x => x.Id, static x => x.Name));

    private string SectionTitle => OwnRules.Count == 1 ? "1 rule" : $"{OwnRules.Count} rules";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        RuleList = await LoadOnceAsync(RuleList, "Loading your rules", cancellationToken =>
            RulesService.GetRulesAsync(cancellationToken).ToListAsync(cancellationToken).AsTask());
        Accounts = await LoadOnceAsync(Accounts, "Loading your rules", cancellationToken =>
            TransactionsService.GetAccountsForTransactionFiltersAsync(cancellationToken)
                .ToListAsync(cancellationToken).AsTask());
        Tags = await LoadOnceAsync(Tags, "Loading your rules", cancellationToken =>
            ClassificationService.GetAllCustomClassificationsAsync(cancellationToken)
                .ToListAsync(cancellationToken).AsTask());
        BillList = await LoadOnceAsync(BillList, "Loading your rules", cancellationToken =>
            BillsService.GetBillsAsync(cancellationToken).ToListAsync(cancellationToken).AsTask());
        DebtList = await LoadOnceAsync(DebtList, "Loading your rules", cancellationToken =>
            DebtsService.GetDebtsAsync(cancellationToken).ToListAsync(cancellationToken).AsTask());
    }

    /// <summary>
    /// The names of new accounts and bills from the sync, which the rules can show. The rules themselves stay.
    /// </summary>
    protected override async Task OnSyncedAsync()
    {
        Accounts = await TransactionsService.GetAccountsForTransactionFiltersAsync(_cts.Token)
            .ToListAsync(_cts.Token);
        BillList = await BillsService.GetBillsAsync(_cts.Token).ToListAsync(_cts.Token);
    }

    /// <summary>
    /// <paramref name="names"/> with the names the shared rules carry added, ids being unique across both.
    /// </summary>
    private Dictionary<Guid, string> WithSharedNames(Dictionary<Guid, string> names)
    {
        foreach (Rule rule in SharedRules)
        {
            foreach ((Guid id, string name) in rule.Names)
            {
                names.TryAdd(id, name);
            }
        }

        return names;
    }

    /// <summary>
    /// Shown in the new order straight away, and put back if it can't be saved. Only their own move, the shared ones
    /// stay after them.
    /// </summary>
    internal async Task ReorderAsync(IReadOnlyList<Rule> reordered)
    {
        List<Rule>? previous = RuleList;
        RuleList = [.. reordered, .. SharedRules];

        try
        {
            ReorderRules order = new() { RuleIds = reordered.Select(static x => x.Id).ToList() };
            await RulesService.ReorderRulesAsync(order, _cts.Token);
        }
        catch (Exception)
        {
            RuleList = previous;
            Snackbar.Add("Couldn't save the new order, try again", Severity.Error);
        }
    }

    internal async Task DeleteAsync(Rule rule)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync($"Delete {rule.Name}?",
            "The tags and transfer answers it gave are taken back.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            SetLoadingState(true, $"Deleting {rule.Name}…");
            await RulesService.DeleteRuleAsync(rule.Id, _cts.Token);
            RuleList!.RemoveAll(x => x.Id == rule.Id);
            Snackbar.Add($"{rule.Name} deleted", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add($"Couldn't delete {rule.Name}, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

    internal async Task ToggleAsync(Rule rule)
    {
        bool turningOn = !rule.IsEnabled;

        try
        {
            SetLoadingState(true, turningOn ? $"Turning {rule.Name} on…" : $"Turning {rule.Name} off…");
            Rule saved = await RulesService.UpdateRuleAsync(rule.Id, RuleDrafts.WithEnabled(rule, turningOn),
                _cts.Token);
            RuleList![RuleList.FindIndex(x => x.Id == rule.Id)] = saved;
            Snackbar.Add(turningOn
                ? $"{rule.Name} is on for transactions from the next sync"
                : $"{rule.Name} is off, the tags and transfer answers it gave have been taken back",
                Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add($"Couldn't turn {rule.Name} {(turningOn ? "on" : "off")}, try again", Severity.Error);
        }
        finally
        {
            SetLoadingState(false);
        }
    }

}

@inherits LayoutBase
@implements IDisposable

@* The signed in app's shell: app bar, navigation, the shared loading overlay, and when the user's accounts last
   synced, with a button to sync them now *@

@using System.Globalization
@inject IAutomationService AutomationService
@inject ISyncNotifications SyncNotifications

<MudThemeProvider @ref="@_mudThemeProvider" Theme="_theme" @bind-IsDarkMode="_isDarkMode" DefaultScrollbar="true"/>
<MudPopoverProvider/>
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true"/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="@(_isDarkMode ? 0 : 1)">
        <MudStaticNavDrawerToggle DrawerId="nav-drawer" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                                  Edge="Edge.Start"/>
        <span class="ft-brand">FinTrack</span>
        <MudSpacer/>
        <MudTooltip Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                           Color="Color.Inherit" OnClick="@DarkModeToggle" aria-label="Toggle dark mode"/>
        </MudTooltip>
        <MudMenu Icon="@Icons.Material.Outlined.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight" aria-label="Account">
            <MudMenuItem>
                @* ReSharper disable once Html.PathError *@
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken/>
                    <input type="hidden" name="ReturnUrl"/>
                    <button type="submit" class="ft-menu-button">
                        <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small"/>
                        Sign out
                    </button>
                </form>
            </MudMenuItem>
        </MudMenu>
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0">
        <NavMenu/>
        <MudSpacer/>
        @if (BackgroundSyncTime != null)
        {
            <div class="ft-sync-status">
                <div class="ft-list__main">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                        @(UpdatingBackgroundSync ? "Syncing your accounts…" : "Last synced")
                    </MudText>
                    @if (!UpdatingBackgroundSync)
                    {
                        <MudText Typo="Typo.caption" Class="d-block">
                            @BackgroundSyncTime.Value.ToString("d MMM, HH:mm", CultureInfo.CurrentCulture)
                        </MudText>
                    }
                </div>
                @if (UpdatingBackgroundSync)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary"/>
                }
                else
                {
                    <MudTooltip Text="Sync now">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Sync" OnClick="@RequestResync"
                                       aria-label="Sync now"/>
                    </MudTooltip>
                }
            </div>
        }
        <div class="ft-version" title="@AppVersion.Full">FinTrack @AppVersion.Display</div>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
            <div class="ft-page">
                <CascadingValue Value="@ApplicationState.Loading">
                    <MudOverlay Visible="@ApplicationState.Loading" DarkBackground="@(_isDarkMode)"
                                LightBackground="@(!_isDarkMode)" AutoClose="false">
                        <MudItem Class="d-flex flex-column align-center">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
                            <MudText Typo="Typo.h6">@ApplicationState.LoadingMessage</MudText>
                        </MudItem>
                    </MudOverlay>
                    <CascadingValue Value="@_isDarkMode" Name="IsDarkMode">
                        @Body
                    </CascadingValue>
                </CascadingValue>
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {

    private IDisposable? _syncSubscription;

    internal readonly CancellationTokenSource _cts = new();

    private bool UpdatingBackgroundSync { get; set; }
    private DateTime? BackgroundSyncTime { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            // Only once interactive, a prerender has no circuit to push the update to
            _syncSubscription = await SyncNotifications.SubscribeAsync(() => InvokeAsync(GetLatestSyncTimeAsync), _cts.Token);

            await GetLatestSyncTimeAsync();
        }
    }

    private async Task GetLatestSyncTimeAsync()
    {
        DateTime? syncTime = await AutomationService.GetLastSyncTimeAsync(_cts.Token);
        BackgroundSyncTime = syncTime;
        UpdatingBackgroundSync = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task RequestResync()
    {
        // Cleared when the sync notification arrives
        UpdatingBackgroundSync = true;
        await AutomationService.RequestSyncAsync(_cts.Token);
    }


    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    public void Dispose()
    {
        ApplicationState.PropertyChanged -= ApplicationStateOnPropertyChanged;
        _syncSubscription?.Dispose();
        _cts.Cancel();
        _cts.Dispose();

    }

}

@inherits LayoutBase
@implements IDisposable

@* The signed in app's shell: app bar, navigation, the shared loading overlay, and when the user's accounts last
   synced, with a button to sync them now. Says when a sync finishes, whoever started it *@

@using System.Globalization
@inject IAutomationService AutomationService
@inject ISyncNotifications SyncNotifications
@inject ITransfersService TransfersService
@inject ISnackbar Snackbar

<MudThemeProvider @ref="@_mudThemeProvider" Theme="_theme" @bind-IsDarkMode="_isDarkMode" DefaultScrollbar="true"/>
<MudPopoverProvider/>
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true"/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="@(_isDarkMode ? 0 : 1)">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" aria-label="Toggle navigation"/>
        <span class="ft-brand">FinTrack</span>
        <MudSpacer/>
        <MudTooltip Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                           Color="Color.Inherit" OnClick="@DarkModeToggle" aria-label="Toggle dark mode"/>
        </MudTooltip>
        <MudMenu Icon="@Icons.Material.Outlined.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight" aria-label="Account">
            <MudMenuItem>
                @* ReSharper disable once Html.PathError *@
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken/>
                    <input type="hidden" name="ReturnUrl"/>
                    <button type="submit" class="ft-menu-button">
                        <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small"/>
                        Sign out
                    </button>
                </form>
            </MudMenuItem>
        </MudMenu>
    </MudAppBar>
    @* Docked from desktop width, below it the drawer opens over the page. The static input package's script remembers
       a drawer's state across visits, which would keep it closed on desktop after closing it once, so it's told this
       drawer is already handled *@
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" Breakpoint="@LayoutBase.DrawerBreakpoint"
               ClipMode="DrawerClipMode.Always" Elevation="0" data-mud-static-monitored="true">
        <NavMenu TransfersToReview="@ApplicationState.TransfersToReview"/>
        <MudSpacer/>
        @if (BackgroundSyncTime != null || ApplicationState.Syncing)
        {
            <div class="ft-sync-status">
                <div class="ft-list__main">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                        @(ApplicationState.Syncing ? "Syncing your accounts…" : "Last synced")
                    </MudText>
                    @if (!ApplicationState.Syncing)
                    {
                        <MudText Typo="Typo.caption" Class="d-block">
                            @BackgroundSyncTime?.ToString("d MMM, HH:mm", CultureInfo.CurrentCulture)
                        </MudText>
                    }
                </div>
                @if (ApplicationState.Syncing)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary"/>
                }
                else
                {
                    <MudTooltip Text="Sync now">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Sync" OnClick="@RequestResync"
                                       aria-label="Sync now"/>
                    </MudTooltip>
                }
            </div>
        }
        <div class="ft-version" title="@AppVersion.Full">FinTrack @AppVersion.Display</div>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
            <div class="ft-page">
                <CascadingValue Value="@ApplicationState.Loading">
                    <MudOverlay Visible="@ApplicationState.Loading" DarkBackground="@(_isDarkMode)"
                                LightBackground="@(!_isDarkMode)" AutoClose="false">
                        <MudItem Class="d-flex flex-column align-center">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
                            <MudText Typo="Typo.h6">@ApplicationState.LoadingMessage</MudText>
                        </MudItem>
                    </MudOverlay>
                    <CascadingValue Value="@_isDarkMode" Name="IsDarkMode">
                        @Body
                    </CascadingValue>
                </CascadingValue>
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {

    private IDisposable? _syncSubscription;

    internal readonly CancellationTokenSource _cts = new();

    private DateTime? BackgroundSyncTime { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            // Only once interactive, a prerender has no circuit to push the update to
            _syncSubscription = await SyncNotifications.SubscribeAsync(() => InvokeAsync(OnSyncCompletedAsync), _cts.Token);
            await RefreshSyncDetailsAsync();
        }
    }

    private async Task OnSyncCompletedAsync()
    {
        ApplicationState.Syncing = false;

        // Matching runs with the sync, so there may be new ones to review too
        await RefreshSyncDetailsAsync();
        Snackbar.Add("Your accounts have been synced", Severity.Success);
    }

    /// <summary>
    /// When the accounts last synced and how many transfers wait for review, fetched together as neither needs the
    /// other.
    /// </summary>
    private Task RefreshSyncDetailsAsync() => Task.WhenAll(GetLatestSyncTimeAsync(), GetTransfersToReviewAsync());

    private async Task GetLatestSyncTimeAsync()
    {
        BackgroundSyncTime = await AutomationService.GetLastSyncTimeAsync(_cts.Token);
        await InvokeAsync(StateHasChanged);
    }

    private async Task GetTransfersToReviewAsync()
    {
        try
        {
            ApplicationState.TransfersToReview = await TransfersService.GetReviewCountAsync(_cts.Token);
        }
        catch (HttpRequestException)
        {
            // Only the navigation's count, the page itself still works
        }
    }

    public async Task RequestResync()
    {
        // Cleared when the sync notification arrives
        ApplicationState.Syncing = true;
        await AutomationService.RequestSyncAsync(_cts.Token);
    }


    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    public void Dispose()
    {
        ApplicationState.PropertyChanged -= ApplicationStateOnPropertyChanged;
        _syncSubscription?.Dispose();
        _cts.Cancel();
        _cts.Dispose();

    }

}

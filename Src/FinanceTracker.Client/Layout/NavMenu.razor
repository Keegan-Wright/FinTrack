@* The side navigation: money, planning, insights, anything waiting for review, what the user manages, then
   configuration. *@
@using FinanceTracker.Contracts.Auth
@implements IDisposable
@inject NavigationManager NavigationManager

<div class="ft-nav">
    <MudNavMenu Color="Color.Primary">
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">Dashboard</MudNavLink>

        <div class="ft-nav__heading">Money</div>
        <MudNavLink Href="Accounts" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.AccountBalance">Accounts</MudNavLink>
        <MudNavLink Href="Transactions" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ReceiptLong">Transactions</MudNavLink>
        <MudNavLink Href="Calendar" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.CalendarMonth">Calendar</MudNavLink>

        <div class="ft-nav__heading">Planning</div>
        <MudNavLink Href="Budgets" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.AccountBalanceWallet">Budgets</MudNavLink>
        <MudNavLink Href="Bills" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.EventRepeat">Bills</MudNavLink>
        <MudNavLink Href="Debts" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.CreditScore">Debts</MudNavLink>
        <MudNavLink Href="SavingsGoals" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Savings">Savings goals</MudNavLink>

        <div class="ft-nav__heading">Insights</div>
        <MudNavLink Href="NetWorth" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ShowChart">Net worth</MudNavLink>
        <MudNavLink Href="Reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Insights">Reports</MudNavLink>

        @* Only while there's something to review, or the user is on the page clearing the last of it *@
        @if (ShowTransfersReview || ShowSubscriptionsReview)
        {
            <div class="ft-nav__heading">To review</div>
            @if (ShowTransfersReview)
            {
                <MudNavLink Href="@TransfersReviewPath" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.FactCheck">
                    <span class="ft-nav__label">
                        Transfers
                        @if (TransfersToReview > 0)
                        {
                            <span class="ft-nav__count" aria-label="@($"{TransfersToReview} to review")">@TransfersToReview</span>
                        }
                    </span>
                </MudNavLink>
            }
            @if (ShowSubscriptionsReview)
            {
                <MudNavLink Href="@SubscriptionsReviewPath" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Subscriptions">
                    <span class="ft-nav__label">
                        Subscriptions
                        @if (SubscriptionsToReview > 0)
                        {
                            <span class="ft-nav__count" aria-label="@($"{SubscriptionsToReview} to review")">@SubscriptionsToReview</span>
                        }
                    </span>
                </MudNavLink>
            }
        }

        <div class="ft-nav__heading">Manage</div>
        <MudNavLink Href="ProviderSetup" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.AccountTree">
            <span class="ft-nav__label">
                Bank connections
                @if (ConnectionsToRenew > 0)
                {
                    <span class="ft-nav__count" aria-label="@($"{ConnectionsToRenew} to renew")">@ConnectionsToRenew</span>
                }
            </span>
        </MudNavLink>
        @* Title as well as TitleContent: MudBlazor names the toggle button from it, so its name holds what it shows *@
        <MudNavGroup Icon="@Icons.Material.Outlined.Notifications" Title="@NotificationsTitle"
                     @bind-Expanded="_notificationsOpen">
            <TitleContent>
                <span class="ft-nav__label">
                    Notifications
                    @if (UnreadNotifications > 0)
                    {
                        <span class="ft-nav__count" aria-label="@($"{UnreadNotifications} unread")">@UnreadNotifications</span>
                    }
                </span>
            </TitleContent>
            <ChildContent>
                <MudNavLink Href="@NotificationsPath" Match="NavLinkMatch.All">Recent</MudNavLink>
                <MudNavLink Href="@NotificationSettingsPath" Match="NavLinkMatch.All">Settings</MudNavLink>
            </ChildContent>
        </MudNavGroup>
        <MudNavLink Href="HouseholdMembers" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.People">Household</MudNavLink>
        <MudNavLink Href="Classifications" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Sell">Tags</MudNavLink>
        <MudNavLink Href="Rules" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Rule">Rules</MudNavLink>
        <MudNavLink Href="YourData" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.SaveAlt">Your data</MudNavLink>

        @* Configuration, only admins have any so far *@
        <AuthorizeView Roles="@FinTrackRoles.Admin">
            <div class="ft-nav__heading">Settings</div>
            <MudNavLink Href="Automation" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Schedule">Automation</MudNavLink>
            <MudNavLink Href="Users" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ManageAccounts">Users</MudNavLink>
        </AuthorizeView>
    </MudNavMenu>
</div>

@code {

    /// <summary>
    /// Shown beside the transfers review link, which only shows when there are any, see
    /// <see cref="ApplicationState.TransfersToReview"/>.
    /// </summary>
    [Parameter] public int TransfersToReview { get; set; }

    /// <summary>
    /// Shown beside the subscriptions review link, which only shows when there are any, see
    /// <see cref="ApplicationState.SubscriptionsToReview"/>.
    /// </summary>
    [Parameter] public int SubscriptionsToReview { get; set; }

    /// <summary>
    /// Shown beside the bank connections link when there are any, see
    /// <see cref="ApplicationState.ConnectionsToRenew"/>.
    /// </summary>
    [Parameter] public int ConnectionsToRenew { get; set; }

    /// <summary>
    /// Shown beside the notifications link, see <see cref="ApplicationState.UnreadNotifications"/>.
    /// </summary>
    [Parameter] public int UnreadNotifications { get; set; }

    internal const string TransfersReviewPath = "Review";
    internal const string SubscriptionsReviewPath = "Review/Subscriptions";
    internal const string NotificationsPath = "Notifications";
    internal const string NotificationSettingsPath = "Notifications/Settings";

    /// <summary>
    /// Whether the notifications group shows its pages, opened while on one of them.
    /// </summary>
    private bool _notificationsOpen;

    /// <summary>
    /// The notifications group's name, with the unread count it shows.
    /// </summary>
    private string NotificationsTitle
    {
        get
        {
            if (UnreadNotifications > 0)
            {
                return $"Notifications {UnreadNotifications} unread";
            }

            return "Notifications";
        }
    }

    private bool ShowTransfersReview => TransfersToReview > 0 || IsCurrentPage(TransfersReviewPath);

    private bool ShowSubscriptionsReview => SubscriptionsToReview > 0 || IsCurrentPage(SubscriptionsReviewPath);

    /// <summary>
    /// Whether the user is on <paramref name="path"/>, ignoring case and any query.
    /// </summary>
    private bool IsCurrentPage(string path)
    {
        string current = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        int query = current.IndexOfAny(['?', '#']);
        if (query >= 0)
        {
            current = current[..query];
        }

        return string.Equals(current.TrimEnd('/'), path, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        OpenNotificationsWhenOnThem();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        OpenNotificationsWhenOnThem();
        StateHasChanged();
    }

    /// <summary>
    /// Opens the notifications group on one of its pages, so where the user is shows. Leaves it as they left it
    /// elsewhere.
    /// </summary>
    private void OpenNotificationsWhenOnThem()
    {
        if (IsCurrentPage(NotificationsPath) || IsCurrentPage(NotificationSettingsPath))
        {
            _notificationsOpen = true;
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

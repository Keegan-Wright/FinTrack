@* The side navigation. *@
@using FinanceTracker.Contracts.Auth
@implements IDisposable
@inject NavigationManager NavigationManager

<div class="ft-nav">
    <MudNavMenu Color="Color.Primary">
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">Dashboard</MudNavLink>

        <div class="ft-nav__heading">Money</div>
        <MudNavLink Href="Accounts" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.AccountBalance">Accounts</MudNavLink>
        <MudNavLink Href="Transactions" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ReceiptLong">Transactions</MudNavLink>
        <MudNavLink Href="Calendar" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.CalendarMonth">Calendar</MudNavLink>
        <MudNavLink Href="Review" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.FactCheck">
            <span class="ft-nav__label">
                Review transfers
                @if (TransfersToReview > 0)
                {
                    <span class="ft-nav__count" aria-label="@($"{TransfersToReview} to review")">@TransfersToReview</span>
                }
            </span>
        </MudNavLink>

        <div class="ft-nav__heading">Insights</div>
        <MudNavLink Href="Reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Insights">Reports</MudNavLink>

        <div class="ft-nav__heading">Settings</div>
        <MudNavLink Href="ProviderSetup" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.AccountTree">
            <span class="ft-nav__label">
                Bank connections
                @if (ConnectionsToRenew > 0)
                {
                    <span class="ft-nav__count" aria-label="@($"{ConnectionsToRenew} to renew")">@ConnectionsToRenew</span>
                }
            </span>
        </MudNavLink>
        <MudNavLink Href="HouseholdMembers" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.People">Household</MudNavLink>
        <MudNavLink Href="Classifications" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Sell">Tags</MudNavLink>
        <MudNavLink Href="Rules" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Rule">Rules</MudNavLink>
        <AuthorizeView Roles="@FinTrackRoles.Admin">
            <MudNavLink Href="Automation" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Schedule">Automation</MudNavLink>
        </AuthorizeView>
    </MudNavMenu>
</div>

@code {

    /// <summary>
    /// Shown beside the review link when there are any, see <see cref="ApplicationState.TransfersToReview"/>.
    /// </summary>
    [Parameter] public int TransfersToReview { get; set; }

    /// <summary>
    /// Shown beside the bank connections link when there are any, see
    /// <see cref="ApplicationState.ConnectionsToRenew"/>.
    /// </summary>
    [Parameter] public int ConnectionsToRenew { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

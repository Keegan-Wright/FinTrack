@* The dashboard's headline figures: money in, money out, net and total balance (against household income when
   known). *@
@using FinanceTracker.Contracts.Dashboard
<StatStrip>
    <Stat Label="Money in" Value="@(Spent?.TotalIn ?? 0)">
        <TrendText Value="@TrendIn"/>
    </Stat>
    <Stat Label="Money out" Value="@Math.Abs(Spent?.TotalOut ?? 0)">
        <TrendText Value="@TrendOut" HigherIsBetter="false"/>
    </Stat>
    <Stat Label="Net" Value="@Net" Signed="true">
        @($"{TransactionCount:n0} transactions in range")
    </Stat>
    <Stat Label="Total balance" Value="@TotalBalance">
        @GetBalanceMeta()
    </Stat>
</StatStrip>
@if (TransfersLeftOut() is { } leftOut)
{
    <div class="ft-kpis__transfers">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@leftOut</MudText>
    </div>
}

@code {

    /// <summary>
    /// Money in and out for the selected range.
    /// </summary>
    [Parameter] public SpentInTimePeriod? Spent { get; set; }

    /// <summary>
    /// Change in money in against the previous period, null when there's nothing to compare.
    /// </summary>
    [Parameter] public decimal? TrendIn { get; set; }

    /// <summary>
    /// Change in money out against the previous period, null when there's nothing to compare.
    /// </summary>
    [Parameter] public decimal? TrendOut { get; set; }

    [Parameter] public decimal Net { get; set; }

    [Parameter] public int TransactionCount { get; set; }

    [Parameter] public decimal TotalBalance { get; set; }

    [Parameter] public decimal? HouseholdIncome { get; set; }

    /// <summary>
    /// What money in and out leave out as transfers, null when nothing was.
    /// </summary>
    internal string? TransfersLeftOut()
    {
        decimal movedIn = Spent?.TransferredIn ?? 0;
        decimal movedOut = Math.Abs(Spent?.TransferredOut ?? 0);
        if (movedIn == 0 && movedOut == 0)
        {
            return null;
        }

        return $"Leaves out {CurrencyFormatter.Format(movedIn)} in and {CurrencyFormatter.Format(movedOut)} out " +
               "moved between your accounts or household";
    }

    private string GetBalanceMeta()
    {
        if (HouseholdIncome is null or 0)
            return "Across all connected accounts";

        var netAfterOut = HouseholdIncome.Value - Math.Abs(Spent?.TotalOut ?? 0);
        return $"Household income {CurrencyFormatter.Format(HouseholdIncome.Value)} · {CurrencyFormatter.Format(netAfterOut)} after money out";
    }

}

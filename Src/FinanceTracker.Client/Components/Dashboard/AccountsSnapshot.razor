@* The dashboard's accounts, one row each with its balance, the available balance when it differs, and the latest
   transaction. *@
@using System.Globalization
@using FinanceTracker.Contracts.Account
<Section Title="Accounts" Caption="Balances and latest activity" Class="h-100">
    <Actions>
        <MudButton Href="Accounts" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary">View all</MudButton>
    </Actions>
    <ChildContent>
        @if (Accounts.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">No accounts connected yet.</MudText>
        }
        else
        {
            <div class="ft-list ft-list--scroll ft-list--short">
                @foreach (var a in Accounts.OrderByDescending(static x => x.AccountBalance))
                {
                    <div class="ft-list__row">
                        <AccountLogo Logo="@a.Logo"/>
                        <div class="ft-list__main">
                            <MudText Typo="Typo.body2" Class="text-truncate">@a.AccountName</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary text-truncate d-block">
                                @GetActivityLine(a)
                            </MudText>
                        </div>
                        <div class="ft-list__end">
                            <MoneyText Value="@a.AccountBalance" Typo="Typo.body1"/>
                            @if (a.AvailableBalance != a.AccountBalance)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary ft-money">
                                    @CurrencyFormatter.Format(a.AvailableBalance) available
                                </MudText>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</Section>

@code {

    [Parameter, EditorRequired] public IReadOnlyList<AccountAndTransactions> Accounts { get; set; } = [];

    private static string GetActivityLine(AccountAndTransactions account)
    {
        var type = DisplayText.ToTitle(account.AccountType);
        var latest = account.Transactions?.MaxBy(static x => x.Time);
        if (latest is null)
            return type;

        var amount = (latest.Amount > 0 ? "+" : string.Empty) + CurrencyFormatter.Format(latest.Amount);
        return $"{type} · {amount} {latest.Description}, " +
               latest.Time.ToLocalTime().ToString("d MMM", CultureInfo.CurrentCulture);
    }

}

@* The dashboard's savings goals and progress towards their targets. *@
@using System.Globalization
@using FinanceTracker.Contracts.SavingsGoals
<Section Title="Goals & budgets" Caption="Saved towards each goal">
    @if (SavingsGoals.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">No savings goals yet.</MudText>
    }
    else
    {
        <div class="ft-goal-grid">
            @foreach (var b in SavingsGoals.OrderByDescending(static x => x.Target > 0 ? x.Saved / x.Target : 0))
            {
                var progress = b.Target <= 0 ? 0 : Math.Clamp((double)(b.Saved / b.Target), 0, 1);
                <div class="ft-goal">
                    <div class="ft-list__line">
                        <MudText Typo="Typo.body2" Class="ft-list__main text-truncate">@b.Name</MudText>
                        <MudText Typo="Typo.body2" Class="ft-money">@($"{progress:P0}")</MudText>
                    </div>
                    <MudProgressLinear Value="@(progress * 100)" Color="@(progress >= 1 ? Color.Success : Color.Primary)"
                                       Rounded="true" Size="Size.Small"/>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary ft-money">
                        @CurrencyFormatter.Format(b.Saved) of @CurrencyFormatter.Format(b.Target)
                        @if (b.TargetDate is not null)
                        {
                            <span> · by @b.TargetDate.Value.ToLocalTime().ToString("d MMM yyyy", CultureInfo.CurrentCulture)</span>
                        }
                    </MudText>
                </div>
            }
        </div>
    }
</Section>

@code {

    [Parameter, EditorRequired] public IReadOnlyList<SavingsGoal> SavingsGoals { get; set; } = [];

}

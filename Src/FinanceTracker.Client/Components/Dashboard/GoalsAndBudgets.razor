@* The dashboard's budget categories and progress towards their savings goals. *@
@using System.Globalization
@using FinanceTracker.Contracts.Budget
<Section Title="Goals & budgets" Caption="Saved towards each goal">
    @if (BudgetCategories.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">No budget categories yet.</MudText>
    }
    else
    {
        <div class="ft-goal-grid">
            @foreach (var b in BudgetCategories.OrderByDescending(static x => x.SavingsGoal > 0 ? x.AvailableFunds / x.SavingsGoal : 0))
            {
                var progress = b.SavingsGoal <= 0 ? 0 : Math.Clamp((double)(b.AvailableFunds / b.SavingsGoal), 0, 1);
                <div class="ft-goal">
                    <div class="ft-list__line">
                        <MudText Typo="Typo.body2" Class="ft-list__main text-truncate">@b.Name</MudText>
                        <MudText Typo="Typo.body2" Class="ft-money">@($"{progress:P0}")</MudText>
                    </div>
                    <MudProgressLinear Value="@(progress * 100)" Color="@(progress >= 1 ? Color.Success : Color.Primary)"
                                       Rounded="true" Size="Size.Small"/>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary ft-money">
                        @CurrencyFormatter.Format(b.AvailableFunds) of @CurrencyFormatter.Format(b.SavingsGoal)
                        @if (b.GoalCompletionDate is not null)
                        {
                            <span> · by @b.GoalCompletionDate.Value.ToLocalTime().ToString("d MMM yyyy", CultureInfo.CurrentCulture)</span>
                        }
                    </MudText>
                </div>
            }
        </div>
    }
</Section>

@code {

    [Parameter, EditorRequired] public IReadOnlyList<BudgetCategory> BudgetCategories { get; set; } = [];

}

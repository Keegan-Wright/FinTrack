@* The dashboard's money in and out over the selected range, per day, or per month for ranges longer than two
   months, with the running net across the range. *@
@using ApexCharts
@using FinanceTracker.Contracts.Transactions
<Section Title="Cash flow"
         Caption="@(_byMonth ? "Money in and out per month, and the running net" : "Money in and out per day, and the running net")"
         Class="h-100">
    @if (_points.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Not enough data yet for this range.</MudText>
    }
    else
    {
        @* Keyed on the options, which are rebuilt for new data or a dark mode toggle, so the chart redraws with them *@
        <LoadingFrame Loading="@(!_drawn)" Message="Following the money in and out…" MinHeight="@ChartHeight">
            <ApexChart @key="_options" TItem="CashflowPoint" Options="@_options" Height="@ChartHeight"
                       OnRendered="@(() => _drawn = true)">
                <ApexPointSeries TItem="CashflowPoint" Items="@_points" Name="In" SeriesType="SeriesType.Bar"
                                 XValue="@(static p => p.Label)" YValue="@(static p => p.In)"/>
                <ApexPointSeries TItem="CashflowPoint" Items="@_points" Name="Out" SeriesType="SeriesType.Bar"
                                 XValue="@(static p => p.Label)" YValue="@(static p => p.Out)"/>
                <ApexPointSeries TItem="CashflowPoint" Items="@_points" Name="Running net" SeriesType="SeriesType.Line"
                                 XValue="@(static p => p.Label)" YValue="@(static p => p.RunningNet)"/>
            </ApexChart>
        </LoadingFrame>
    }
    @if (!string.IsNullOrWhiteSpace(Note))
    {
        <MudText Typo="Typo.caption" Class="mt-2" Color="MudBlazor.Color.Warning">@Note</MudText>
    }
</Section>

@code {

    /// <summary>
    /// The most axis labels shown, the rest are still in the tooltip.
    /// </summary>
    private const int MaxAxisLabels = 10;

    private const int MaxPhoneAxisLabels = 4;

    private const int ChartHeight = 300;

    [CascadingParameter(Name = "IsDarkMode")] public bool IsDarkMode { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<Transaction> Transactions { get; set; } = [];

    /// <summary>
    /// First day of the range, local time.
    /// </summary>
    [Parameter, EditorRequired] public DateTime FromDate { get; set; }

    /// <summary>
    /// Last day of the range, local time.
    /// </summary>
    [Parameter, EditorRequired] public DateTime ToDate { get; set; }

    /// <summary>
    /// Shown under the chart, e.g. when the transactions were capped.
    /// </summary>
    [Parameter] public string? Note { get; set; }

    private List<CashflowPoint> _points = [];
    private bool _byMonth;
    private ApexChartOptions<CashflowPoint> _options = new();
    private IReadOnlyList<Transaction>? _builtFrom;
    private bool? _optionsDarkMode;
    private bool _drawn;

    protected override void OnParametersSet()
    {
        // The parent re-renders while loading, only rebuild when it hands over a new set of transactions
        if (!ReferenceEquals(_builtFrom, Transactions))
        {
            _builtFrom = Transactions;
            _byMonth = CashflowSeries.IsByMonth(FromDate, ToDate);
            _points = CashflowSeries.Build(Transactions, FromDate, ToDate);
            _optionsDarkMode = null;
        }

        if (_optionsDarkMode != IsDarkMode)
        {
            _optionsDarkMode = IsDarkMode;
            _options = CreateOptions();
            _drawn = false;
        }
    }

    private ApexChartOptions<CashflowPoint> CreateOptions()
    {
        var options = ChartDefaults.Create<CashflowPoint>(IsDarkMode);
        options.Colors = [ChartDefaults.MoneyInColor, ChartDefaults.MoneyOutColor, ChartDefaults.NeutralColor];
        options.PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { ColumnWidth = "70%", BorderRadius = 2 }
        };
        options.Stroke = new Stroke { Width = new List<double> { 0, 0, 2 }, Curve = Curve.Smooth };
        options.Xaxis = new XAxis
        {
            TickAmount = Math.Min(_points.Count, MaxAxisLabels),
            Labels = new XAxisLabels { Rotate = 0, HideOverlappingLabels = true }
        };

        // On phones fewer date labels fit, and the legend sits better under the chart than beside the title
        options.Responsive =
        [
            new Responsive<CashflowPoint>
            {
                Breakpoint = ChartDefaults.PhoneBreakpoint,
                Options = new ApexChartOptions<CashflowPoint>
                {
                    Xaxis = new XAxis { TickAmount = Math.Min(_points.Count, MaxPhoneAxisLabels) },
                    Legend = new Legend { Position = LegendPosition.Bottom, HorizontalAlign = ApexCharts.Align.Center }
                }
            }
        ];
        return options;
    }

}

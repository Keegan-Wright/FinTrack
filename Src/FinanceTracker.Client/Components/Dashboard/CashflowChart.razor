@* The dashboard's money in and out over the selected range. *@
@using System.Globalization
@using FinanceTracker.Contracts.Transactions

<MudCard>
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.subtitle1">Cashflow trend</MudText>
            <MudText Typo="Typo.caption">Daily totals (in/out/net)</MudText>
        </MudStack>

        @if (_series.Count == 0 || _labels.Length == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">Not enough data yet for this range.</MudText>
        }
        else
        {
            <MudChart ChartType="ChartType.Bar"
                      ChartSeries="_series"
                      ChartLabels="_labels"
                      Width="100%"
                      />
        }

        @if (!string.IsNullOrWhiteSpace(Note))
        {
            <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Warning">@Note</MudText>
        }
    </MudCardContent>
</MudCard>

@code {

    [Parameter, EditorRequired] public IReadOnlyList<Transaction> Transactions { get; set; } = [];

    /// <summary>
    /// First day of the range, local time.
    /// </summary>
    [Parameter, EditorRequired] public DateTime FromDate { get; set; }

    /// <summary>
    /// Last day of the range, local time.
    /// </summary>
    [Parameter, EditorRequired] public DateTime ToDate { get; set; }

    /// <summary>
    /// Shown under the chart, e.g. when the transactions were capped.
    /// </summary>
    [Parameter] public string? Note { get; set; }

    private readonly List<ChartSeries<double>> _series = [];
    private string[] _labels = [];
    private IReadOnlyList<Transaction>? _builtFrom;

    protected override void OnParametersSet()
    {
        // The parent re-renders while loading, only rebuild when it hands over a new set of transactions
        if (ReferenceEquals(_builtFrom, Transactions))
            return;

        _builtFrom = Transactions;
        _series.Clear();
        _labels = [];
        Build();
    }

    private void Build()
    {
        var start = FromDate.Date;
        var end = ToDate.Date;
        var days = (end - start).Days + 1;
        if (Transactions.Count == 0 || days <= 0)
            return;

        var inByDay = new decimal[days];
        var outByDay = new decimal[days];

        foreach (var tx in Transactions)
        {
            var d = tx.TransactionTime.ToLocalTime().Date;
            var idx = (d - start).Days;
            if (idx < 0 || idx >= days)
                continue;

            if (tx.Amount >= 0)
                inByDay[idx] += tx.Amount;
            else
                outByDay[idx] += Math.Abs(tx.Amount);
        }

        var labels = new string[days];
        var inData = new double[days];
        var outData = new double[days];
        var netData = new double[days];

        for (var i = 0; i < days; i++)
        {
            var day = start.AddDays(i);
            labels[i] = day.ToString(days <= 31 ? "d MMM" : "MMM", CultureInfo.CurrentCulture);
            inData[i] = Convert.ToDouble(inByDay[i]);
            outData[i] = Convert.ToDouble(outByDay[i]);
            netData[i] = Convert.ToDouble(inByDay[i] - outByDay[i]);
        }

        _labels = labels;
        _series.Add(new ChartSeries<double> { Name = "In", Data = inData });
        _series.Add(new ChartSeries<double> { Name = "Out", Data = outData });
        _series.Add(new ChartSeries<double> { Name = "Net", Data = netData });
    }

}

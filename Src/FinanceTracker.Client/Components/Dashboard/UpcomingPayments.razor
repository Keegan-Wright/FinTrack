@* The dashboard's next standing order and direct debit payments. *@
@using System.Globalization
@using FinanceTracker.Contracts.Dashboard
@inject TimeProvider TimeProvider
<Section Title="Upcoming payments" Caption="Standing orders and direct debits" Class="h-100">
    @if (Payments.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">No upcoming payments found.</MudText>
    }
    else
    {
        <div class="ft-list ft-list--scroll ft-list--short">
            @foreach (var p in Payments)
            {
                var date = p.PaymentDate.ToLocalTime();
                var daysUntil = (date.Date - TimeProvider.GetLocalNow().Date).Days;
                <div class="ft-list__row">
                    <div class="ft-date-badge">
                        <span class="ft-date-badge__day">@date.Day</span>
                        <span class="ft-date-badge__month">@date.ToString("MMM", CultureInfo.CurrentCulture)</span>
                    </div>
                    <div class="ft-list__main">
                        <MudText Typo="Typo.body2" Class="text-truncate">@p.PaymentName</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @p.PaymentType ·
                            <MudText Typo="Typo.caption" HtmlTag="span"
                                     Color="@(daysUntil <= 1 ? Color.Warning : Color.Inherit)">@DueInLabel(daysUntil)</MudText>
                        </MudText>
                    </div>
                    <div class="ft-list__end">
                        <MoneyText Value="@Math.Abs(p.Amount)"/>
                    </div>
                </div>
            }
        </div>
    }
</Section>

@code {

    [Parameter, EditorRequired] public IReadOnlyList<UpcomingPayment> Payments { get; set; } = [];

    private static string DueInLabel(int days) => days switch
    {
        < 0 => "overdue",
        0 => "today",
        1 => "tomorrow",
        _ => $"in {days} days"
    };

}

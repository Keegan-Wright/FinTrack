@* An amount of money in tabular figures, so amounts line up. With Signed set money in shows green and money out
   red, in the MoneyColours the charts and PDFs use. *@
<MudText Typo="Typo" Color="@ResolvedColor" Inline="Inline" Class="@CssClass">@CurrencyFormatter.Format(Value)</MudText>

@code {

    [Parameter, EditorRequired] public decimal Value { get; set; }

    [Parameter] public Typo Typo { get; set; } = Typo.body2;

    /// <summary>
    /// Colours the amount by its sign, ignored when <see cref="Color"/> is set.
    /// </summary>
    [Parameter] public bool Signed { get; set; }

    [Parameter] public Color? Color { get; set; }

    [Parameter] public bool Inline { get; set; }

    [Parameter] public string? Class { get; set; }

    private Color ResolvedColor => Color ?? MudBlazor.Color.Default;

    /// <summary>
    /// The sign's colour when <see cref="Signed"/> and no <see cref="Color"/> is set.
    /// </summary>
    private string? SignClass
    {
        get
        {
            if (!Signed || Color is not null)
            {
                return null;
            }

            return MoneyColourClass.BySign(Value);
        }
    }

    private string CssClass
    {
        get
        {
            string?[] classes = ["ft-money", SignClass, Class];
            return string.Join(" ", classes.Where(static x => x is not null));
        }
    }

}

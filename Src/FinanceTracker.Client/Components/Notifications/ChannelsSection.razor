@* Which kinds of notification go where. In the app, by email, to their webhook and pushed to their devices. A column
   only for a channel that's set up, and a kind turned off in all of them isn't raised at all. *@
@using FinanceTracker.Contracts.Notifications
@implements IDisposable
@inject INotificationsService NotificationsService
@inject ISnackbar Snackbar

<Section>
    <div class="ft-stack">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Choose where you're notified of each kind. Turn one off everywhere and you won't be notified of it at
            all.
        </MudText>
        <table class="ft-channels">
            <thead>
            <tr>
                <th scope="col">Notification</th>
                <th scope="col">In app</th>
                @if (CanEmail)
                {
                    <th scope="col">Email</th>
                }
                @if (HasWebhook)
                {
                    <th scope="col">Webhook</th>
                }
                @if (Settings.HasPushDevices)
                {
                    <th scope="col">Push</th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (NotificationKind kind in NotificationKindText.All)
            {
                <tr>
                    <th scope="row">@NotificationKindText.Label(kind)</th>
                    <td>
                        <MudCheckBox T="bool" Value="@InApp(kind)" Color="Color.Primary"
                                     AriaLabel="@($"In app: {NotificationKindText.Label(kind)}")"
                                     ValueChanged="@(on => ChangeInAppAsync(kind, on))"/>
                    </td>
                    @if (CanEmail)
                    {
                        <td>
                            <MudCheckBox T="bool" Value="@Emailed(kind)" Color="Color.Primary"
                                         AriaLabel="@($"Email: {NotificationKindText.Label(kind)}")"
                                         ValueChanged="@(on => ChangeEmailedAsync(kind, on))"/>
                        </td>
                    }
                    @if (HasWebhook)
                    {
                        <td>
                            <MudCheckBox T="bool" Value="@Webhooked(kind)" Color="Color.Primary"
                                         AriaLabel="@($"Webhook: {NotificationKindText.Label(kind)}")"
                                         ValueChanged="@(on => ChangeWebhookedAsync(kind, on))"/>
                        </td>
                    }
                    @if (Settings.HasPushDevices)
                    {
                        <td>
                            <MudCheckBox T="bool" Value="@Pushed(kind)" Color="Color.Primary"
                                         AriaLabel="@($"Push: {NotificationKindText.Label(kind)}")"
                                         ValueChanged="@(on => ChangePushedAsync(kind, on))"/>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
        @if (!CanEmail || !HasWebhook || !Settings.HasPushDevices)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Set up email, a webhook or push in their tabs to be notified there too.
            </MudText>
        }
    </div>
</Section>

@code {

    /// <summary>
    /// The user's notification settings.
    /// </summary>
    [Parameter, EditorRequired]
    public required NotificationSettings Settings { get; set; }

    /// <summary>
    /// The settings after a change here, for the page to show.
    /// </summary>
    [Parameter]
    public EventCallback<NotificationSettings> SettingsChanged { get; set; }

    private readonly CancellationTokenSource _cts = new();

    /// <summary>
    /// Whether email can be sent, a mail server and a confirmed address.
    /// </summary>
    private bool CanEmail => Settings is { EmailAvailable: true, EmailAddress: not null, EmailConfirmed: true };

    /// <summary>
    /// Whether they have a webhook.
    /// </summary>
    private bool HasWebhook => Settings.WebhookUrl is not null;

    /// <summary>
    /// Whether a kind shows in the app.
    /// </summary>
    /// <param name="kind">The kind.</param>
    private bool InApp(NotificationKind kind) => Settings.InApp.Contains(kind);

    /// <summary>
    /// Whether a kind is emailed.
    /// </summary>
    /// <param name="kind">The kind.</param>
    private bool Emailed(NotificationKind kind) => Settings.Emailed.Contains(kind);

    /// <summary>
    /// Whether a kind is posted to the webhook.
    /// </summary>
    /// <param name="kind">The kind.</param>
    private bool Webhooked(NotificationKind kind) => Settings.Webhooked.Contains(kind);

    /// <summary>
    /// Whether a kind is pushed to their devices.
    /// </summary>
    /// <param name="kind">The kind.</param>
    private bool Pushed(NotificationKind kind) => Settings.Pushed.Contains(kind);

    /// <summary>
    /// Shows <paramref name="kind"/> in the app or not, everything else as it was.
    /// </summary>
    /// <param name="kind">The kind.</param>
    /// <param name="on">Whether to show it.</param>
    internal Task ChangeInAppAsync(NotificationKind kind, bool on) => SaveAsync(new ChangeNotificationSettings
    {
        InApp = WithOrWithout(Settings.InApp, kind, on), Emailed = Settings.Emailed,
        Webhooked = Settings.Webhooked, Pushed = Settings.Pushed
    });

    /// <summary>
    /// Emails <paramref name="kind"/> or not, everything else as it was.
    /// </summary>
    /// <param name="kind">The kind.</param>
    /// <param name="on">Whether to email it.</param>
    internal Task ChangeEmailedAsync(NotificationKind kind, bool on) => SaveAsync(new ChangeNotificationSettings
    {
        InApp = Settings.InApp, Emailed = WithOrWithout(Settings.Emailed, kind, on),
        Webhooked = Settings.Webhooked, Pushed = Settings.Pushed
    });

    /// <summary>
    /// Posts <paramref name="kind"/> to the webhook or not, everything else as it was.
    /// </summary>
    /// <param name="kind">The kind.</param>
    /// <param name="on">Whether to post it.</param>
    internal Task ChangeWebhookedAsync(NotificationKind kind, bool on) => SaveAsync(new ChangeNotificationSettings
    {
        InApp = Settings.InApp, Emailed = Settings.Emailed,
        Webhooked = WithOrWithout(Settings.Webhooked, kind, on), Pushed = Settings.Pushed
    });

    /// <summary>
    /// Pushes <paramref name="kind"/> to their devices or not, everything else as it was.
    /// </summary>
    /// <param name="kind">The kind.</param>
    /// <param name="on">Whether to push it.</param>
    internal Task ChangePushedAsync(NotificationKind kind, bool on) => SaveAsync(new ChangeNotificationSettings
    {
        InApp = Settings.InApp, Emailed = Settings.Emailed, Webhooked = Settings.Webhooked,
        Pushed = WithOrWithout(Settings.Pushed, kind, on)
    });

    /// <summary>
    /// Saves <paramref name="change"/> and tells the page.
    /// </summary>
    /// <param name="change">Where each kind goes now.</param>
    private async Task SaveAsync(ChangeNotificationSettings change)
    {
        try
        {
            NotificationSettings settings = await NotificationsService.ChangeSettingsAsync(change, _cts.Token);
            Settings = settings;
            await SettingsChanged.InvokeAsync(settings);
        }
        catch (Exception) when (!_cts.IsCancellationRequested)
        {
            Snackbar.Add("Couldn't save that, try again", Severity.Error);
        }
    }

    /// <summary>
    /// <paramref name="kinds"/> with or without <paramref name="kind"/>.
    /// </summary>
    /// <param name="kinds">The kinds on for a channel.</param>
    /// <param name="kind">The kind to add or remove.</param>
    /// <param name="with">Whether to add it.</param>
    private static List<NotificationKind> WithOrWithout(IEnumerable<NotificationKind> kinds, NotificationKind kind,
        bool with)
    {
        List<NotificationKind> changed = kinds.Where(x => x != kind).ToList();
        if (with)
        {
            changed.Add(kind);
        }

        return changed;
    }

    /// <inheritdoc/>
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

}

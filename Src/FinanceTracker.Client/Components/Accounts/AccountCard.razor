@* One account's balances, its last 90 days and newest transactions, on the accounts page. *@
@using System.Globalization
@using FinanceTracker.Client.Components.NetWorth
@using FinanceTracker.Contracts.Account
@using FinanceTracker.Contracts.NetWorth

<Section Class="h-100">
    <TitleContent>
        <div class="ft-account-heading">
            <AccountLogo Logo="@Account.Logo"/>
            <div class="ft-list__main">
                <MudText Typo="Typo.subtitle1" Class="text-truncate">@Account.AccountName</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @TypeCaption(Account)
                </MudText>
                @if (Account.JointWith is { } jointWith)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Joint with @jointWith</MudText>
                }
                else if (Account.SharedBy is { } sharedBy)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Shared by @sharedBy</MudText>
                }
            </div>
        </div>
    </TitleContent>
    <ChildContent>
        <div class="ft-balances">
            <div>
                <div class="ft-label">Balance</div>
                <MoneyText Value="@Account.AccountBalance" Typo="Typo.h5"/>
            </div>
            @if (Account.AvailableBalance != Account.AccountBalance)
            {
                <div>
                    <div class="ft-label">Available</div>
                    <MoneyText Value="@Account.AvailableBalance" Typo="Typo.h6" Class="mud-text-secondary"/>
                </div>
            }
            @if (Account.CreditLimit is { } creditLimit)
            {
                <div>
                    <div class="ft-label">Credit limit</div>
                    <MoneyText Value="@creditLimit" Typo="Typo.h6" Class="mud-text-secondary"/>
                </div>
            }
        </div>

        @if (History is { Count: > 1 } history)
        {
            <div class="ft-label mt-4">Last 90 days</div>
            <BalanceHistoryChart Points="@history" Name="Balance" Compact="true" Height="80"/>
        }

        <div class="ft-label mt-4">Recent activity</div>
        @if (Account.Transactions is null || !Account.Transactions.Any())
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Nothing yet.</MudText>
        }
        else
        {
            <div class="ft-list">
                @foreach (var transaction in Account.Transactions.OrderByDescending(static x => x.Time))
                {
                    <div class="ft-list__row">
                        <div class="ft-list__main">
                            <MudText Typo="Typo.body2" Class="text-truncate">@transaction.Description</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @transaction.Time.ToLocalTime().ToString("d MMM", CultureInfo.CurrentCulture)
                                · @DisplayText.ToTitle(transaction.Status)
                            </MudText>
                        </div>
                        <div class="ft-list__end">
                            <MoneyText Value="@transaction.Amount" Signed="true"/>
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</Section>

@code {

    [Parameter] [EditorRequired] public required AccountAndTransactions Account { get; set; }

    /// <summary>
    /// Its closing balances over the last 90 days, null until loaded.
    /// </summary>
    [Parameter] public IReadOnlyList<BalancePoint>? History { get; set; }

    /// <summary>
    /// The account's type, and a card's last digits when the bank gives them, e.g. "Credit Card · ending 1000".
    /// </summary>
    internal static string TypeCaption(AccountAndTransactions account)
    {
        string type = DisplayText.ToTitle(account.AccountType);
        if (string.IsNullOrWhiteSpace(account.CardEnding))
        {
            return type;
        }

        return $"{type} · ending {account.CardEnding}";
    }

}

@* Asks for the user's password again before a change to how they sign in. *@
@using FinanceTracker.Client.Components.Dialogs
@using FinanceTracker.Client.Extensions
@using FinanceTracker.Contracts.Profile
@using FluentValidation
@inject IValidator<ConfirmPassword> Validator

<DialogBase TResponse="ConfirmPassword" Title="@Title" ResponseConstructor="BuildResponseModel">
    <Content>
        <MudForm @ref="_form" Model="@_model">
            <div class="ft-confirm-password">
                <MudText Typo="Typo.body2">@Message</MudText>
                <MudTextField T="string" @bind-Value="_model.Password" Label="Your password"
                              Variant="Variant.Outlined" InputType="InputType.Password" For="@(() => _model.Password)"
                              UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "current-password" })"
                              Validation="@(Validator.ValidateValue(_model, nameof(ConfirmPassword.Password)))"/>
            </div>
        </MudForm>
    </Content>
</DialogBase>

@code {

    /// <summary>
    /// The dialog's title, the change being made.
    /// </summary>
    [Parameter] [EditorRequired] public required string Title { get; set; }

    /// <summary>
    /// What the change does.
    /// </summary>
    [Parameter] [EditorRequired] public required string Message { get; set; }

    private readonly ConfirmPassword _model = new();
    private MudForm _form = null!;

    /// <summary>
    /// The password once it's filled in, null to keep the dialog open.
    /// </summary>
    private async Task<ConfirmPassword?> BuildResponseModel()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return null;
        }

        return _model;
    }

}

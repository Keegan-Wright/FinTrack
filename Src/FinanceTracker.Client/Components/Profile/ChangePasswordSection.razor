@* Changing the user's password, given their current one. Changing it signs them out everywhere else. *@
@using FinanceTracker.Client.Extensions
@using FinanceTracker.Contracts.Profile
@using FluentValidation
@using Severity = MudBlazor.Severity
@implements IDisposable
@inject IProfileService ProfileService
@inject IValidator<ChangePassword> Validator
@inject ISnackbar Snackbar

<Section>
    <div class="ft-stack">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Changing it signs you out on your other devices.
        </MudText>
        <MudForm @ref="_form" Model="@_model">
            <div class="ft-profile__fields">
                <MudTextField T="string" @bind-Value="_model.CurrentPassword" Label="Current password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password"
                              For="@(() => _model.CurrentPassword)"
                              UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "current-password" })"
                              Validation="@(Validator.ValidateValue(_model, nameof(ChangePassword.CurrentPassword)))"/>
                <MudTextField T="string" @bind-Value="_model.NewPassword" Label="New password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password"
                              For="@(() => _model.NewPassword)"
                              UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })"
                              Validation="@(Validator.ValidateValue(_model, nameof(ChangePassword.NewPassword)))"/>
                <MudTextField T="string" @bind-Value="_model.ConfirmNewPassword" Label="Confirm new password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password"
                              For="@(() => _model.ConfirmNewPassword)"
                              UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })"
                              Validation="@(Validator.ValidateValue(_model, nameof(ChangePassword.ConfirmNewPassword)))"/>
            </div>
        </MudForm>
        @if (_errors.Count > 0)
        {
            <div role="alert">
                @foreach (string error in _errors)
                {
                    <MudText Typo="Typo.body2" Color="Color.Error">@error</MudText>
                }
            </div>
        }
        <div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy"
                       OnClick="@ChangeAsync">Change password</MudButton>
        </div>
    </div>
</Section>

@code {

    private readonly CancellationTokenSource _cts = new();
    private readonly ChangePassword _model = new();
    private MudForm _form = null!;
    private IReadOnlyList<string> _errors = [];
    private bool _busy;

    internal async Task ChangeAsync()
    {
        _errors = [];
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _busy = true;
        try
        {
            // A copy, as the fields clear once it's changed
            ChangePassword request = new()
            {
                CurrentPassword = _model.CurrentPassword,
                NewPassword = _model.NewPassword,
                ConfirmNewPassword = _model.ConfirmNewPassword
            };
            ProfileChange? change = await ProfileService.ChangePasswordAsync(request, _cts.Token);
            await ShowAsync(change);
        }
        catch (Exception) when (!_cts.IsCancellationRequested)
        {
            Snackbar.Add("Couldn't change your password, try again", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ShowAsync(ProfileChange? change)
    {
        if (change is null)
        {
            _errors = ["Your account has no password here, you sign in through your identity provider"];
            return;
        }

        if (!change.Succeeded)
        {
            _errors = change.Errors;
            return;
        }

        Snackbar.Add("Password changed", Severity.Success);
        _model.CurrentPassword = string.Empty;
        _model.NewPassword = string.Empty;
        _model.ConfirmNewPassword = string.Empty;
        await _form.ResetValidationAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

}

@* The filter bar shared by the transactions and reports pages: search and dates always showing, the rest folded
   away under "More filters", raising the active filters on apply. *@
@using FinanceTracker.Contracts.Transactions
<div class="ft-filters">
    <div class="ft-filters__bar">
        <MudTextField T="string" @bind-Value="_searchTerm" Placeholder="Search descriptions" Clearable="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                      OnKeyUp="@OnSearchKeyUp"/>
        <DateRangeField @bind-Value="_dateRange"/>
        <div class="ft-filters__actions">
            <MudBadge Content="@MoreFilterCount" Visible="@(MoreFilterCount > 0)" Color="Color.Primary" Overlap="true">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.FilterList"
                           OnClick="@(() => _expanded = !_expanded)">
                    @(_expanded ? "Fewer filters" : "More filters")
                </MudButton>
            </MudBadge>
            @if (HasAnyFilter)
            {
                <MudButton Variant="Variant.Text" OnClick="@ClearAsync">Clear</MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@ApplyAsync">Apply</MudButton>
        </div>
    </div>
    <MudCollapse Expanded="@_expanded">
        <div class="ft-filters__more">
            <MudSelect T="Guid" Label="Banks" MultiSelection="true" Clearable="true" Variant="Variant.Outlined"
                       Margin="Margin.Dense" MultiSelectionTextFunc="@(list => CountText(list, "bank", "banks"))"
                       @bind-SelectedValues="_selectedProviderIds">
                @foreach (var item in ProviderFilterItems)
                {
                    <MudSelectItem T="Guid" Value="@item.ProviderId">@item.ProviderName</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Guid" Label="Accounts" MultiSelection="true" Clearable="true" Variant="Variant.Outlined"
                       Margin="Margin.Dense" MultiSelectionTextFunc="@(list => CountText(list, "account", "accounts"))"
                       @bind-SelectedValues="_selectedAccountIds">
                @foreach (var item in AccountFilterItems)
                {
                    <MudSelectItem T="Guid" Value="@item.AccountId">@item.AccountName</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Categories" MultiSelection="true" Clearable="true" Variant="Variant.Outlined"
                       Margin="Margin.Dense" MultiSelectionTextFunc="@(list => CountText(list, "category", "categories"))"
                       @bind-SelectedValues="_selectedCategories">
                @foreach (var item in CategoryFilterItems)
                {
                    <MudSelectItem T="string" Value="@item.TransactionCategory">@item.TransactionCategory</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Types" MultiSelection="true" Clearable="true" Variant="Variant.Outlined"
                       Margin="Margin.Dense" MultiSelectionTextFunc="@(list => CountText(list, "type", "types"))"
                       @bind-SelectedValues="_selectedTypes">
                @foreach (var item in TransactionTypeFilterItems)
                {
                    <MudSelectItem T="string" Value="@item.TransactionType">@item.TransactionType</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Tags" MultiSelection="true" Clearable="true" Variant="Variant.Outlined"
                       Margin="Margin.Dense" MultiSelectionTextFunc="@(list => CountText(list, "tag", "tags"))"
                       @bind-SelectedValues="_selectedTags">
                @foreach (var item in TransactionTagFilterItems)
                {
                    <MudSelectItem T="string" Value="@item.Tag">@item.Tag</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudCollapse>
</div>

@code {

    [Parameter, EditorRequired] public List<TransactionAccountFilter> AccountFilterItems { get; set; } = [];

    [Parameter, EditorRequired] public List<TransactionCategoryFilter> CategoryFilterItems { get; set; } = [];

    [Parameter, EditorRequired] public List<TransactionProviderFilter> ProviderFilterItems { get; set; } = [];

    [Parameter, EditorRequired] public List<TransactionTypeFilter> TransactionTypeFilterItems { get; set; } = [];

    [Parameter, EditorRequired] public List<TransactionTagFilter> TransactionTagFilterItems { get; set; } = [];

    /// <summary>
    /// Raised with the chosen filters when the user applies or clears them.
    /// </summary>
    [Parameter, EditorRequired] public EventCallback<ActiveTransactionFilters> SearchTransactions { get; set; }

    private string _searchTerm = string.Empty;
    private IReadOnlyCollection<Guid> _selectedProviderIds = [];
    private IReadOnlyCollection<Guid> _selectedAccountIds = [];
    private IReadOnlyCollection<string> _selectedCategories = [];
    private IReadOnlyCollection<string> _selectedTypes = [];
    private IReadOnlyCollection<string> _selectedTags = [];
    private DateRange? _dateRange;
    private bool _expanded;

    // The filters folded away, counted on the button so they aren't forgotten when it's closed
    private int MoreFilterCount => new[]
    {
        _selectedProviderIds.Count, _selectedAccountIds.Count, _selectedCategories.Count, _selectedTypes.Count,
        _selectedTags.Count
    }.Count(static x => x > 0);

    private bool HasAnyFilter => MoreFilterCount > 0 || !string.IsNullOrWhiteSpace(_searchTerm) ||
                                 _dateRange?.Start is not null || _dateRange?.End is not null;

    private static string CountText(IReadOnlyList<string?>? list, string one, string many) =>
        list is null || list.Count == 0 ? string.Empty : $"{list.Count} {(list.Count == 1 ? one : many)}";

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
            await ApplyAsync();
    }

    private Task ApplyAsync() => SearchTransactions.InvokeAsync(new ActiveTransactionFilters(_selectedProviderIds,
        _selectedAccountIds, _selectedCategories, _selectedTypes, _selectedTags, _dateRange,
        _searchTerm ?? string.Empty));

    private Task ClearAsync()
    {
        _searchTerm = string.Empty;
        _selectedProviderIds = [];
        _selectedAccountIds = [];
        _selectedCategories = [];
        _selectedTypes = [];
        _selectedTags = [];
        _dateRange = null;
        return ApplyAsync();
    }

}

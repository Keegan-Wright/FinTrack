@* A new budget, or an existing one to change its name, the tags and accounts it covers, its monthly limit and what
   carries over. A changed limit applies from this month on. *@
@using System.Globalization
@using FinanceTracker.Client.Components.Dialogs
@using FinanceTracker.Client.Extensions
@using FinanceTracker.Contracts.Budgets
@using FluentValidation
@using FluentValidation.Results
@inject IValidator<SaveBudget> Validator

<DialogBase TResponse="SaveBudget" Title="@(Budget is null ? "New budget" : $"Edit {Budget.Name}")"
            ResponseConstructor="BuildResponseModel">
    <Content>
        <MudForm @ref="_form" Model="@_model" class="ft-budget-form">
            <MudTextField T="string" @bind-Value="_model.Name" Label="Name" For="@(() => _model.Name)"
                          Validation="@(Validator.ValidateValue(_model, nameof(SaveBudget.Name)))"
                          HelperText="e.g. Groceries" Immediate="true"/>

            <div class="ft-budget-form__covers">
                <MudText Typo="Typo.subtitle2">What it covers</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Tags alone count that spending on any account.
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Accounts alone count all spending on them, like a joint account.
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Both count that spending on those accounts only.
                </MudText>
            </div>

            <MudSelect T="Guid" Label="Tags" MultiSelection="true" @bind-SelectedValues="_tagIds"
                       MultiSelectionTextFunc="@(selected => NamesText(selected, TagNames))"
                       HelperText="Spending with any of these counts">
                @foreach ((Guid tagId, string tagName) in TagNames.OrderBy(static x => x.Value))
                {
                    <MudSelectItem T="Guid" Value="@tagId">@tagName</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="Guid" Label="Accounts" MultiSelection="true" @bind-SelectedValues="_accountIds"
                       MultiSelectionTextFunc="@(selected => NamesText(selected, AccountNames))"
                       HelperText="Only spending on these counts, none for every account">
                @foreach ((Guid accountId, string accountName) in AccountNames.OrderBy(static x => x.Value))
                {
                    <MudSelectItem T="Guid" Value="@accountId">@accountName</MudSelectItem>
                }
            </MudSelect>
            @if (_coversError is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error">@_coversError</MudText>
            }
            @if (_accountIds.Count > 0)
            {
                <div class="ft-budget-form__transfers">
                    <MudCheckBox T="bool" @bind-Value="_model.CountsTransfersOut" Color="Color.Primary"
                                 Label="Count money moved out to other accounts" Dense="true"/>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        For an account you can't pay from, so you move money elsewhere first.
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Moves between the accounts above never count.
                    </MudText>
                </div>
            }
            @if (TagNames.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    You have no tags yet,
                    <MudLink Href="Classifications" Typo="Typo.caption">make one</MudLink>
                    and
                    a
                    <MudLink Href="Rules" Typo="Typo.caption">rule</MudLink>
                    to tag your spending.
                </MudText>
            }

            <MudTextField T="decimal" @bind-Value="_model.MonthlyLimit" Label="Monthly limit"
                          For="@(() => _model.MonthlyLimit)" InputMode="@(InputMode.@decimal)"
                          Adornment="Adornment.Start" AdornmentText="@CurrencySymbol"
                          Validation="@(Validator.ValidateValue(_model, nameof(SaveBudget.MonthlyLimit)))"
                          HelperText="@LimitHelp" Immediate="true"/>

            <MudSelect T="RolloverMode" Label="At the end of the month" @bind-Value="_model.RolloverMode"
                       ToStringFunc="@(static mode => BudgetText.RolloverName(mode))"
                       For="@(() => _model.RolloverMode)">
                @foreach (RolloverMode mode in Enum.GetValues<RolloverMode>())
                {
                    <MudSelectItem T="RolloverMode" Value="@mode">@BudgetText.RolloverName(mode)</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </Content>
</DialogBase>

@code {

    /// <summary>
    /// The budget to change, null for a new one.
    /// </summary>
    [Parameter] public Budget? Budget { get; set; }

    /// <summary>
    /// The user's tags by id.
    /// </summary>
    [Parameter] [EditorRequired] public required IReadOnlyDictionary<Guid, string> TagNames { get; set; }

    /// <summary>
    /// The accounts it can cover by id, any the user sees.
    /// </summary>
    [Parameter] [EditorRequired] public required IReadOnlyDictionary<Guid, string> AccountNames { get; set; }

    private MudForm _form = null!;
    private SaveBudget _model = new();
    private IReadOnlyCollection<Guid> _tagIds = [];
    private IReadOnlyCollection<Guid> _accountIds = [];
    private string? _coversError;

    /// <summary>
    /// The current culture's currency symbol, shown on amount fields.
    /// </summary>
    private static string CurrencySymbol => CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol;

    /// <summary>
    /// The help under the limit field.
    /// </summary>
    private string LimitHelp => Budget is null
        ? "How much you can spend each month"
        : "A new limit applies from this month on, earlier months keep theirs";

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        if (Budget is null)
        {
            return;
        }

        // A tag deleted before budgets let go of them, or an account that's gone, would otherwise be sent back and
        // refused
        List<Guid> tagIds = Budget.TagIds.Where(TagNames.ContainsKey).ToList();
        List<Guid> accountIds = Budget.AccountIds.Where(AccountNames.ContainsKey).ToList();

        _model = new SaveBudget
        {
            Name = Budget.Name,
            TagIds = tagIds,
            AccountIds = accountIds,
            CountsTransfersOut = Budget.CountsTransfersOut,
            MonthlyLimit = Budget.MonthlyLimit,
            RolloverMode = Budget.RolloverMode
        };
        _tagIds = tagIds;
        _accountIds = accountIds;
    }

    /// <summary>
    /// The chosen tags or accounts names, for a picker's text.
    /// </summary>
    /// <param name="selected">The chosen ids.</param>
    /// <param name="choices">The names by id.</param>
    private static string NamesText(IReadOnlyList<string> selected, IReadOnlyDictionary<Guid, string> choices)
    {
        List<string> names = [];
        foreach (string value in selected)
        {
            if (Guid.TryParse(value, out Guid id) && choices.TryGetValue(id, out string? name))
            {
                names.Add(name);
            }
        }

        return string.Join(", ", names);
    }

    /// <summary>
    /// Validates the form and gives what the dialog closes with, null to keep it open.
    /// </summary>
    private async Task<SaveBudget?> BuildResponseModel()
    {
        _model.TagIds = _tagIds.ToList();
        _model.AccountIds = _accountIds.ToList();

        // Only an account budget counts what's moved out, the box is hidden without one
        if (_model.AccountIds.Count == 0)
        {
            _model.CountsTransfersOut = false;
        }

        await _form.ValidateAsync();
        ValidationResult result = await Validator.ValidateAsync(_model);
        _coversError = result.Errors
            .FirstOrDefault(static x => x.PropertyName is nameof(SaveBudget.TagIds) or nameof(SaveBudget.AccountIds))
            ?.ErrorMessage;

        if (!_form.IsValid || !result.IsValid)
        {
            return null;
        }

        return _model;
    }

}

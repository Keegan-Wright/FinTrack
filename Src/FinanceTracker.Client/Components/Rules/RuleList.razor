@* The user's rules in the order they run. Each can be dragged by its handle, switched on or off, and edited, moved a
   place or deleted from its menu. *@
@using FinanceTracker.Contracts.Rules

<div class="ft-rules">
    @* Keyed on the order so a move from either the menu or a drop rebuilds the zone in the new order *@
    <MudDropContainer T="Rule" @key="@OrderKey" Items="@Rules" ItemsSelector="@((_, _) => true)"
                      ItemDropped="@OnDroppedAsync" ItemDraggingClass="ft-rule--dragging">
        <ChildContent>
            <MudDropZone T="Rule" Identifier="@ZoneIdentifier" AllowReorder="true"/>
        </ChildContent>
        <ItemRenderer>
            @{
                int index = IndexOf(context);
                string? problem = RuleText.Problem(context, AccountNames);
            }
            <div class="ft-rule">
                <MudDragHandle T="Rule">
                    <span class="ft-rule__handle" title="Drag to reorder">
                        <MudIcon Icon="@Icons.Material.Outlined.DragIndicator" Size="Size.Small"/>
                    </span>
                </MudDragHandle>
                <span class="ft-rule__position">@(index + 1)</span>
                <div class="ft-rule__main">

                    <MudLink Href="@($"Rules/{context.Id}")" Typo="Typo.body2">
                        <span class="ft-rule__name">@context.Name</span>
                    </MudLink>

                    <MudText Typo="Typo.caption" Class="mud-text-secondary ft-rule__summary">
                        @RuleText.Summary(context, AccountNames, TagNames, BillNames, DebtNames)
                    </MudText>
                    @if (problem is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">@problem</MudText>
                    }
                </div>
                <MudSwitch T="bool" Value="@context.IsEnabled" Color="Color.Primary"
                           Disabled="@(context.Actions.Count == 0)"
                           ValueChanged="@(_ => OnToggle.InvokeAsync(context))"
                           aria-label="@($"Run {context.Name}")"/>

                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                         aria-label="@($"Actions for {context.Name}")">
                    <MudMenuItem Icon="@Icons.Material.Outlined.Edit" Href="@($"Rules/{context.Id}")">Edit</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.ArrowUpward" Disabled="@(index == 0)"
                                 OnClick="@(() => MoveAsync(context, index - 1))">Move up</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.ArrowDownward" Disabled="@(index == Rules.Count - 1)"
                                 OnClick="@(() => MoveAsync(context, index + 1))">Move down</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.Delete"
                                 OnClick="@(() => OnDelete.InvokeAsync(context))">Delete</MudMenuItem>
                </MudMenu>
            </div>
        </ItemRenderer>
    </MudDropContainer>
</div>

@code {

    private const string ZoneIdentifier = "rules";

    /// <summary>
    /// In the order they run.
    /// </summary>
    [Parameter] [EditorRequired] public required IReadOnlyList<Rule> Rules { get; set; }

    /// <summary>
    /// The user's accounts by id, for conditions on an account and spotting ones since removed.
    /// </summary>
    [Parameter] [EditorRequired] public required IReadOnlyDictionary<Guid, string> AccountNames { get; set; }

    /// <summary>
    /// The user's tags by id, for the actions that add them.
    /// </summary>
    [Parameter] [EditorRequired] public required IReadOnlyDictionary<Guid, string> TagNames { get; set; }

    /// <summary>
    /// The user's bills by id, for the actions that pay one.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<Guid, string> BillNames { get; set; } = new Dictionary<Guid, string>();

    /// <summary>
    /// The user's debts by id, for actions that pay one off.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<Guid, string> DebtNames { get; set; } = new Dictionary<Guid, string>();

    /// <summary>
    /// The rules in their new order, after one is dragged or moved from its menu.
    /// </summary>
    [Parameter] public EventCallback<IReadOnlyList<Rule>> OnReorder { get; set; }

    /// <summary>
    /// A rule to switch on if it's off, or off if it's on.
    /// </summary>
    [Parameter] public EventCallback<Rule> OnToggle { get; set; }

    [Parameter] public EventCallback<Rule> OnDelete { get; set; }

    private string OrderKey => string.Join(',', Rules.Select(static x => x.Id));

    private int IndexOf(Rule rule)
    {
        for (int index = 0; index < Rules.Count; index++)
        {
            if (Rules[index].Id == rule.Id)
            {
                return index;
            }
        }

        return -1;
    }

    internal Task OnDroppedAsync(MudItemDropInfo<Rule> drop) =>
        drop.Item is null ? Task.CompletedTask : MoveAsync(drop.Item, drop.IndexInZone);

    private async Task MoveAsync(Rule rule, int toIndex)
    {
        int fromIndex = IndexOf(rule);
        int clamped = Math.Clamp(toIndex, 0, Rules.Count - 1);
        if (fromIndex < 0 || fromIndex == clamped)
        {
            return;
        }

        List<Rule> reordered = Rules.ToList();
        reordered.RemoveAt(fromIndex);
        reordered.Insert(clamped, rule);

        await OnReorder.InvokeAsync(reordered);
    }

}

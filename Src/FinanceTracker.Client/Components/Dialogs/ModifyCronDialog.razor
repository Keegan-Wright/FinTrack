@* Edits a scheduled job's description, cron expression, retries and whether it runs. *@
@using System.Globalization
@using FinanceTracker.Contracts.Automation
@using FinanceTracker.Client.Extensions
@using FluentValidation
@inject IValidator<UpdateCronJob> Validator
<DialogBase TResponse="UpdateCronJob" Title="Edit job"
            ResponseConstructor="BuildResponseModel">
    <Content>
        <MudForm @ref="_form" Model="@_model">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Description" Label="Description"
                                  For="@(() => _model.Description)"
                                  Validation="@(Validator.ValidateValue(_model, nameof(UpdateCronJob.Description)))"
                                  Immediate="true"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Expression" Label="Cron schedule (UTC)"
                                  HelperText="Seconds, minutes, hours, day of month, month, day of week, with ? in one day field, e.g. 0 0 */4 * * ?"
                                  For="@(() => _model.Expression)"
                                  Validation="@(Validator.ValidateValue(_model, nameof(UpdateCronJob.Expression)))"
                                  Immediate="true"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="int" @bind-Value="_model.Retries" Label="Retries"
                                  For="@(() => _model.Retries)"
                                  Validation="@(Validator.ValidateValue(_model, nameof(UpdateCronJob.Retries)))"
                                  Immediate="true"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Value="@_retryIntervalsText" ValueChanged="@SetRetryIntervals"
                                  Label="Retry after (seconds)" Placeholder="e.g. 10, 20, 30"
                                  For="@(() => _retryIntervalsText)"
                                  Validation="@(new Func<string, string?>(RetryIntervalsError))"
                                  Immediate="true"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudCheckBox T="bool" @bind-Value="_model.IsEnabled" Label="Enabled"></MudCheckBox>
                </MudItem>
            </MudGrid>
        </MudForm>
    </Content>
</DialogBase>

@code {

    private MudForm _form = null!;
    private UpdateCronJob _model = null!;

    /// <summary>
    /// The job, see <see cref="AutomationCron.Function"/>.
    /// </summary>
    [Parameter] public string Function { get; set; } = null!;
    [Parameter] public string Description { get; set; } = null!;
    [Parameter] public string Expression { get; set; } = null!;
    [Parameter] public int Retries { get; set; }
    [Parameter] public int[] RetryIntervals { get; set; } = null!;
    [Parameter] public bool IsEnabled { get; set; }

    protected override void OnInitialized()
    {
        _model = new UpdateCronJob
        {
            Function = Function,
            Description = Description,
            Expression = Expression,
            Retries = Retries,
            RetryIntervals = RetryIntervals,
            IsEnabled = IsEnabled
        };
        _retryIntervalsText = string.Join(", ", RetryIntervals ?? []);
    }

    /// <summary>
    /// What the user typed for the retry intervals, kept as typed so a mistake stays on screen to fix rather than
    /// being dropped.
    /// </summary>
    private string _retryIntervalsText = string.Empty;

    private const string RetryIntervalsMessage = "Whole seconds, separated by commas, e.g. 10, 20, 30";

    private void SetRetryIntervals(string text)
    {
        _retryIntervalsText = text;
        if (TryParseIntervals(text, out int[] intervals))
        {
            _model.RetryIntervals = intervals;
        }
    }

    private static string? RetryIntervalsError(string text)
    {
        if (TryParseIntervals(text, out _))
        {
            return null;
        }

        return RetryIntervalsMessage;
    }

    /// <summary>
    /// Each comma separated part as a whole number of seconds, none when it's empty. False when any part isn't one.
    /// </summary>
    private static bool TryParseIntervals(string? text, out int[] intervals)
    {
        intervals = [];
        if (string.IsNullOrWhiteSpace(text))
        {
            return true;
        }

        List<int> parsed = [];
        foreach (string part in text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (!int.TryParse(part, NumberStyles.None, CultureInfo.CurrentCulture, out int seconds))
            {
                return false;
            }

            parsed.Add(seconds);
        }

        intervals = [.. parsed];
        return true;
    }

    private async Task<UpdateCronJob?> BuildResponseModel()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return null;

        return _model;
    }
}

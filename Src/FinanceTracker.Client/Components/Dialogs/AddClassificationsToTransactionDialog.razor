@* Picks custom classifications to apply to a transaction. *@
@using FinanceTracker.Contracts.Classifications
@using FinanceTracker.Client.Extensions
@using FluentValidation
@inject IValidator<AddCustomClassificationsToTransaction> Validator

<DialogBase TResponse="AddCustomClassificationsToTransaction" Title="Add tags"
            ResponseConstructor="BuildResponseModel">
    <Content>
        <MudForm @ref="_form" Model="@_model">
            @if (Classifications.Count() > 8)
            {
                <MudTextField @bind-Value="_searchString" Placeholder="Search tags" Immediate="true" Clearable="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2"/>
            }
            <div class="ft-list ft-list--scroll">
                @foreach (var classification in Classifications.Where(QuickFilter).OrderBy(static x => x.Tag))
                {
                    <MudCheckBox T="bool" Value="@_selected.Contains(classification.ClassificationId)"
                                 ValueChanged="@(checkedNow => ToggleAsync(classification, checkedNow))"
                                 Label="@classification.Tag" Color="Color.Primary" Dense="true"/>
                }
            </div>
            <MudTextField T="IEnumerable<SelectedCustomClassification>"
                          @bind-Value="_model.Classifications"
                          For="@(() => _model.Classifications)"
                          Validation="@(Validator.ValidateValue(_model, nameof(AddCustomClassificationsToTransaction.Classifications)))"
                          Style="display: none;"/>
        </MudForm>
    </Content>
</DialogBase>

@code {

    private MudForm _form = null!;
    private AddCustomClassificationsToTransaction _model = null!;

    [Parameter] public Guid TransactionId { get; set; }

    [Parameter] public IEnumerable<Classification> Classifications { get; set; } = null!;

    private string _searchString = string.Empty;
    private readonly HashSet<Guid> _selected = [];

    protected override void OnInitialized()
    {
        _model = new AddCustomClassificationsToTransaction
        {
            TransactionId = TransactionId,
            Classifications = []
        };
    }

    private Func<Classification, bool> QuickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        return x.Tag != null && x.Tag.Contains(_searchString, StringComparison.OrdinalIgnoreCase);
    };


    private async Task<AddCustomClassificationsToTransaction?> BuildResponseModel()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return null;

        return _model;
    }

    private async Task ToggleAsync(Classification classification, bool isChecked)
    {
        if (isChecked)
            _selected.Add(classification.ClassificationId);
        else
            _selected.Remove(classification.ClassificationId);

        _model.Classifications = _selected
            .Select(static x => new SelectedCustomClassification { ClassificationId = x })
            .ToList();
        await _form.ValidateAsync();
    }

}

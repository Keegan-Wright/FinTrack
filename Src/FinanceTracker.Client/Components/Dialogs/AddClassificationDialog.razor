@* Asks for a custom classification's tag, new or renamed, validated as you type. *@
@using FinanceTracker.Contracts.Classifications
@using FinanceTracker.Client.Extensions
@using FluentValidation
@inject IValidator<AddClassifications> Validator
<DialogBase TResponse="AddClassifications" Title="@(Tag is null ? "New tag" : $"Rename {Tag}")"
            ResponseConstructor="BuildResponseModel">
    <Content>
        <MudForm @ref="_form" Model="@_model">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Tag" Label="Tag"
                                  Placeholder="e.g. Holiday"
                                  For="@(() => _model.Tag)"
                                  Validation="@(Validator.ValidateValue(_model, nameof(AddClassifications.Tag)))"
                                  Immediate="true"></MudTextField>
                </MudItem>
            </MudGrid>
        </MudForm>
    </Content>
</DialogBase>

@code {

    /// <summary>
    /// The tag being renamed, null for a new one.
    /// </summary>
    [Parameter] public string? Tag { get; set; }

    private MudForm _form = null!;
    private AddClassifications _model = new() { Tag = string.Empty };

    protected override void OnInitialized() => _model.Tag = Tag ?? string.Empty;

    private async Task<AddClassifications?> BuildResponseModel()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return null;

        return _model;
    }

}

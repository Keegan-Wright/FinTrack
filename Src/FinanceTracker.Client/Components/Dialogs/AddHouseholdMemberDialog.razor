@* Asks for a new household member's name and income, validated as you type. *@
@using System.Globalization
@using FinanceTracker.Contracts.HouseholdMember
@using FinanceTracker.Client.Extensions
@using FluentValidation
@inject IValidator<AddHouseholdMember> Validator

<DialogBase TResponse="AddHouseholdMember" Title="Add a person" ResponseConstructor="BuildResponseModel">
    <Content>
        <MudForm @ref="_form" Model="@_model">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.FirstName" Label="First name"
                                  For="@(() => _model.FirstName)"
                                  Validation="@(Validator.ValidateValue(_model, nameof(AddHouseholdMember.FirstName)))"
                                  Immediate="true"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.LastName" Label="Last name"
                                  For="@(() => _model.LastName)"
                                  Validation="@(Validator.ValidateValue(_model, nameof(AddHouseholdMember.LastName)))"
                                  Immediate="true"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="decimal" @bind-Value="_model.Income" Label="Income"
                                  Adornment="Adornment.Start" AdornmentText="@CurrencySymbol"
                                  For="@(() => _model.Income)"
                                  Validation="@(Validator.ValidateValue(_model, nameof(AddHouseholdMember.Income)))"
                                  Immediate="true"></MudTextField>
                </MudItem>
            </MudGrid>
        </MudForm>
    </Content>
</DialogBase>

@code {

    private MudForm _form = null!;
    private AddHouseholdMember _model = new() { FirstName = string.Empty, LastName = string.Empty, Income = 0 };

    private static string CurrencySymbol => CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol;

    private async Task<AddHouseholdMember?> BuildResponseModel()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return null;

        return _model;
    }

}

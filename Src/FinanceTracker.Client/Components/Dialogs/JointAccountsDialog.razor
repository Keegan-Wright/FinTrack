@* The joint accounts the user and the other person in a link both connected those that could be merged so they're
   counted once, and those merged, which can be split again. Each choice is saved straight away. *@
@using FinanceTracker.Contracts.Sharing

<MudDialog>
    <TitleContent>Joint accounts with @Shown.Name</TitleContent>
    <DialogContent>
        <div class="ft-joint">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                When you've both connected the same account, merge it so it's counted once. You'll both see and tag
                the copy connected first, and the other keeps syncing in the background.
            </MudText>

            @if (Shown.JointSuggestions.Count > 0)
            {
                <div>
                    <div class="ft-joint__heading">
                        <MudText Typo="Typo.subtitle2">Could be merged</MudText>
                        @if (Shown.JointSuggestions.Count > 1)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       Disabled="@_busy" OnClick="@MergeAllAsync">Merge all</MudButton>
                        }
                    </div>
                    <div class="ft-list">
                        @foreach (JointAccountSuggestion suggestion in Shown.JointSuggestions)
                        {
                            <div class="ft-list__row ft-joint__row">
                                <div class="ft-list__main">
                                    <MudText Typo="Typo.body2" Class="text-truncate">
                                        @suggestion.YourAccountName
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary text-truncate">
                                        @SuggestionText(suggestion)
                                    </MudText>
                                </div>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                           Disabled="@_busy" OnClick="@(() => MergeAsync(suggestion))">Merge</MudButton>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Shown.JointAccounts.Count > 0)
            {
                <div>
                    <MudText Typo="Typo.subtitle2">Merged</MudText>
                    <div class="ft-list">
                        @foreach (MergedJointAccount joint in Shown.JointAccounts)
                        {
                            <div class="ft-list__row ft-joint__row">
                                <div class="ft-list__main">
                                    <MudText Typo="Typo.body2" Class="text-truncate">@joint.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary text-truncate">
                                        @MergedText(joint, Shown.Name)
                                    </MudText>
                                </div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           Disabled="@_busy" OnClick="@(() => SplitAsync(joint))">Split</MudButton>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Shown.JointSuggestions.Count == 0 && Shown.JointAccounts.Count == 0)
            {
                <MudText Typo="Typo.body2">
                    Nothing to merge. An account you've both connected shows here once one of you shares it.
                </MudText>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Close">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] [EditorRequired] public required LinkShares Shares { get; set; }

    /// <summary>
    /// Merges suggestions, one or all of them, giving what's shared both ways after, or null when it couldn't.
    /// </summary>
    [Parameter] [EditorRequired]
    public required Func<IReadOnlyList<JointAccountSuggestion>, Task<LinkShares?>> OnMerge { get; set; }

    /// <summary>
    /// Splits a merged account, giving what's shared both ways after, or null when it couldn't.
    /// </summary>
    [Parameter] [EditorRequired] public required Func<MergedJointAccount, Task<LinkShares?>> OnSplit { get; set; }

    private LinkShares? _changed;
    private bool _busy;

    private LinkShares Shown => _changed ?? Shares;

    /// <summary>
    /// The other person's copy, e.g. <c>The same account as their Joint</c>.
    /// </summary>
    internal static string SuggestionText(JointAccountSuggestion suggestion) =>
        $"The same account as their {suggestion.TheirAccountName}";

    /// <summary>
    /// Whose copy both see, e.g. <c>Counted once, from your connection</c>.
    /// </summary>
    internal static string MergedText(MergedJointAccount joint, string name)
    {
        if (joint.ShownIsYours)
        {
            return "Counted once, from your connection";
        }

        return $"Counted once, from {name}'s connection";
    }

    private async Task MergeAsync(JointAccountSuggestion suggestion) =>
        await RunAsync(() => OnMerge([suggestion]));

    private async Task MergeAllAsync() =>
        await RunAsync(() => OnMerge(Shown.JointSuggestions));

    private async Task SplitAsync(MergedJointAccount joint) =>
        await RunAsync(() => OnSplit(joint));

    private async Task RunAsync(Func<Task<LinkShares?>> change)
    {
        _busy = true;
        try
        {
            if (await change() is { } after)
            {
                _changed = after;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // Returns whether anything changed, so the page knows to load the links again
    private void Close() => MudDialog.Close(DialogResult.Ok(_changed is not null));
}

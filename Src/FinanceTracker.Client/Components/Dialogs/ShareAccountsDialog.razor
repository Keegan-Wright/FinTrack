@* Chooses which of the user's accounts to share with the other person in a link, and what they can do with each, and
   shows what the other person shares with them. Returns the whole choice as a ChangeAccountShares. *@
@using FinanceTracker.Contracts.Sharing

<DialogBase TResponse="ChangeAccountShares" Title="@($"Share with {Shares.Name}")"
            ResponseConstructor="BuildResponseModel">
    <Content>
        <div class="ft-share">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Tick the accounts @Shares.Name can see. <strong>See</strong> lets them look,
                <strong>Change</strong> also lets them tag and split its transactions.
            </MudText>

            @if (Shares.YourAccounts.Count == 0)
            {
                <MudText Typo="Typo.body2">You haven't connected any accounts yet.</MudText>
            }
            else
            {
                <div class="ft-share__all">
                    <MudCheckBox T="bool?" Value="@AllChosen" ValueChanged="@ChooseAll" TriState="true"
                                 Label="Select all" Color="Color.Primary" Dense="true"/>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@CountText</MudText>
                </div>

                @foreach (IGrouping<string, ShareableAccount> bank in ByBank)
                {
                    <div class="ft-share__bank">
                        <MudText Typo="Typo.overline" Class="mud-text-secondary">@bank.Key</MudText>
                        <div class="ft-list">
                            @foreach (ShareableAccount account in bank)
                            {
                                bool chosen = _chosen.TryGetValue(account.AccountId, out ShareMode mode);
                                <div class="ft-list__row ft-share__row">
                                    <MudCheckBox T="bool" Value="@chosen" ValueChanged="@(x => Choose(account, x))"
                                                 Color="Color.Primary" Dense="true"
                                                 aria-label="@($"Share {account.Name}")"/>
                                    <MudText Typo="Typo.body2" Class="ft-list__main text-truncate">@account.Name</MudText>
                                    @* Always takes its room, so ticking a row doesn't move anything *@
                                    <div class="ft-share__mode">
                                        @if (chosen)
                                        {
                                            <MudToggleGroup T="ShareMode" Value="@mode"
                                                            ValueChanged="@(x => _chosen[account.AccountId] = x)"
                                                            Size="Size.Small" Color="Color.Primary" Outlined="true"
                                                            aria-label="@($"What {Shares.Name} can do with {account.Name}")">
                                                <MudToggleItem Value="ShareMode.ReadOnly" Text="See"/>
                                                <MudToggleItem Value="ShareMode.AllowChanges" Text="Change"/>
                                            </MudToggleGroup>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }

            <MudDivider/>

            <div>
                <MudText Typo="Typo.subtitle2">@Shares.Name shares with you</MudText>
                @if (Shares.TheirAccounts.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Nothing yet.</MudText>
                }
                else
                {
                    <div class="ft-list">
                        @foreach (AccountSharedWithYou account in Shares.TheirAccounts)
                        {
                            <div class="ft-list__row">
                                <div class="ft-list__main">
                                    <MudText Typo="Typo.body2" Class="text-truncate">@account.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary text-truncate">
                                        @account.BankName · @ModeText(account.Mode).ToLowerInvariant()
                                    </MudText>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </Content>
</DialogBase>

@code {

    [Parameter] [EditorRequired] public required LinkShares Shares { get; set; }

    /// <summary>
    /// The accounts ticked and what the other person can do with each.
    /// </summary>
    private readonly Dictionary<Guid, ShareMode> _chosen = [];

    protected override void OnParametersSet()
    {
        _chosen.Clear();
        foreach (ShareableAccount account in Shares.YourAccounts)
        {
            if (account.Mode is { } mode)
            {
                _chosen[account.AccountId] = mode;
            }
        }
    }

    /// <summary>
    /// The accounts under their bank, in the order they came, which is by bank then name.
    /// </summary>
    private IEnumerable<IGrouping<string, ShareableAccount>> ByBank =>
        Shares.YourAccounts.GroupBy(static x => x.BankName);

    private string CountText => $"{_chosen.Count} of {Shares.YourAccounts.Count} shared";

    /// <summary>
    /// Ticked when every account is shared, empty when none are, and in between otherwise.
    /// </summary>
    private bool? AllChosen
    {
        get
        {
            if (_chosen.Count == 0)
            {
                return false;
            }

            if (_chosen.Count == Shares.YourAccounts.Count)
            {
                return true;
            }

            return null;
        }
    }

    /// <summary>
    /// What a mode lets the other person do, as the list of what's shared with them reads.
    /// </summary>
    internal static string ModeText(ShareMode mode) => mode switch
    {
        ShareMode.AllowChanges => "Can see and change",
        _ => "Can see"
    };

    private void Choose(ShareableAccount account, bool chosen)
    {
        if (chosen)
        {
            _chosen.TryAdd(account.AccountId, ShareMode.ReadOnly);
        }
        else
        {
            _chosen.Remove(account.AccountId);
        }
    }

    // Select all ticks the accounts listed now, read only unless already chosen otherwise. It's not a standing choice,
    // accounts connected later still start private
    private void ChooseAll(bool? all)
    {
        if (all == true)
        {
            foreach (ShareableAccount account in Shares.YourAccounts)
            {
                _chosen.TryAdd(account.AccountId, ShareMode.ReadOnly);
            }

            return;
        }

        _chosen.Clear();
    }

    private Task<ChangeAccountShares?> BuildResponseModel() =>
        Task.FromResult<ChangeAccountShares?>(new ChangeAccountShares
        {
            Accounts = _chosen.Select(static x => new AccountShareChoice { AccountId = x.Key, Mode = x.Value }).ToList()
        });
}

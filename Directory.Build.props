<Project>
  <!-- This clone's own settings, untracked, e.g. FinTrackAi=true to build the AI module in everywhere. Read by every
       project whatever builds it, the IDE, the command line or Aspire -->
  <Import Project="$(MSBuildThisFileDirectory)FinTrack.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)FinTrack.local.props')"/>

  <!-- Applies to every project under the repository root -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Runs the .editorconfig code style rules (IDE*) during build, not just in the editor -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- Every public member needs a doc comment, the build fails without one (#53). Tests turn it off, see
         Test/Directory.Build.props -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Release builds set the version from the git tag (Src/Dockerfile), anything else is a dev build. The SDK adds
         the commit to the informational version, shown in the app, see AppVersion.cs -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <!-- Builds the AI module into the app, for the fintrackweb-ai image. Off by default, so the plain build has no AI
         code at all. Turn on with -p:FinTrackAi=true -->
    <FinTrackAi Condition="'$(FinTrackAi)' == ''">false</FinTrackAi>
    <DefineConstants Condition="'$(FinTrackAi)' == 'true'">$(DefineConstants);FINTRACK_AI</DefineConstants>
  </PropertyGroup>
</Project>
